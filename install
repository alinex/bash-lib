#!/usr/bin/env bash
# shellcheck source=base
source /dev/null

# Usage:
#
# interactive install
#   curl -sL https://gitlab.com/alinex/bash-lib/-/raw/master/install | bash
# automatic install, all values provided
#   curl -sL https://gitlab.com/alinex/bash-lib/-/raw/master/install | bash -s -- <branch> y|n
#
# update if already installed
#   curl -sL https://gitlab.com/alinex/bash-lib/-/raw/master/install | bash

CC_ERROR=$'\e[31m' # red
CC_STEP=$'\e[36m'  # cyan
CC_RESET=$'\e[0m'
CC_INTENSITY_BOLD=$'\e[1m'

logo() {
    a=$'\e[36m'            # cyan
    b=$'\e[33m\e[1m'       # yellow bold
    c=$'\e[43m\e[30m\e[1m' # yellow bg + black bold
    r=$'\e[0m'             # reset
    u=$'\e[4m'             # underline
    p="$(printf '%*s' $((($(tput cols) - 80) / 2)))"
    t="$(printf '%*s' $((($(tput cols) - ${#1}) / 2)))"
    echo
    echo "$p$a                         $b  __   ____     ___"
    echo "$p$a           ######  ##### $b ▕  ▏ ▕    ╲   ▕   ▏ $a  ########### #####       #####"
    echo "$p$a          ######## ##### $b ▕  ▏ ▕     ╲  ▕   ▏ $a ############  #####     #####"
    echo "$p$a         ######### ##### $b ▕  ▏ ▕  ▕╲  ╲ ▕   ▏ $a #####          #####   #####"
    echo "$p$a        ########## ##### $b ▕  ▏ ▕  ▕ ╲  ╲▕   ▏ $a #####           ##### #####"
    echo "$p$a       ##### ##### ##### $b ▕  ▏ ▕  ▕  ╲  ▔   ▏ $a ############     #########"
    echo "$p$a      #####  ##### ##### $b ▕  ▏ ▕  ▕   ╲     ▏ $a ############     #########"
    echo "$p$a     #####   ##### ##### $b ▕  ▏ ▕  ▕    ╲    ▏ $a #####           ##### #####"
    echo "$p$a    #####    ##### ##### $b  ▔▔   ▔▔▔     ▔▔▔▔  $a #####          #####   #####"
    echo "$p$a   ##### ######### ########################### ############  #####     #####"
    echo "$p$a  ##### ##########  #########################   ########### #####       ##### $r"
    echo "$p$b▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄$r$c"
    echo "$t$1$r"
    echo "$p$b▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀$r"
    echo
}

# To avoid question give all information:
# Usage:    install <path> <y|n> <config-path>

set -eE         # exit on uncatched failure
set -o pipefail # fail if any command in a pipeline fails

logo "Bash Lib 2 - INSTALLER"

echo "This will setup the bashlib on $(hostname -f) if not already done or update it..."
echo ""
# check bash version
if [ -z "${BASH_VERSION:-}" ]; then
    echo "${CC_ERROR}No bash CLI! This can only be run under bash >=4.2!${CC_RESET}"
    exit 1
fi
if ((${BASH_VERSINFO[0]} < 4 || (${BASH_VERSINFO[0]} == 4 && ${BASH_VERSINFO[1]} < 2))); then
    echo "${CC_ERROR}Bash library to old! This can only be run under bash >=4.2! You have Bash Version $BASH_VERSION${CC_RESET}"
    exit 1
fi
# ask for type of installation (if not update)
if [ -e /opt/bashlib ]; then
    yn=y
    echo "This will replace the installation under /opt/bashlib"
    echo
    sleep 3
    sudo rm -rf /opt/bashlib
elif [ -e "$HOME"/bashlib ]; then
    yn=n
    echo "This will replace the installation under $HOME/bashlib"
    echo
    sleep 3
    rm -rf "$HOME"/bashlib
else
    echo "No BashLib found, so it will be installed."
    [ -n "$2" ] && yn="$2" || read -r -n 1 -s -p "Should the bashlib path be added globally (Y/n) " yn </dev/tty
    echo
fi
if [ -z "$1" ]; then
    read -r -p "Which branch or tag should be used? [master] " branch </dev/tty
    branch="${branch:-master}"
    echo
else
    branch="${1:-master}"
    echo "Use $branch version."
fi
BASHLIB_DOWNLOAD="https://gitlab.com/alinex/bash-lib/-/archive/$branch/bash-lib-$branch.tar.gz"
case $yn in
"" | [JjYy])
    install=/opt/bashlib
    sudo mkdir -p -m 777 "$install"
    config=/etc/bashlib/
    sudo mkdir -p -m 777 "$config"
    ;;
*)
    install="$HOME"/bashlib
    mkdir "$install"
    config="$HOME"/.bashlib-
    sudo() { "$@"; } # don't use sudo
    ;;
esac

###############################################################################
# STEP 1
###############################################################################

echo "$CC_STEP"
echo "Step 1: Install mandatory packages"
echo "$CC_RESET"

echo "        Install needed packages..."
if [ -f /etc/debian_version ]; then
    sudo apt-get update 2>&1 | sed 's/^/        /g'
    sudo apt-get install -y bash iproute2 git tzdata curl locales gettext expect jq 2>&1 | sed 's/^/        /g'
elif [ -f /etc/alpine-release ]; then
    sudo apk update 2>&1 | sed 's/^/        /g'
    sudo apk add bash tzdata musl-locales musl-locales-lang git curl coreutils gettext expect sed jq 2>&1 | sed 's/^/        /g'
elif [ -f /etc/arch-release ]; then
    sudo pacman -Syu --noconfirm 2>&1 | sed 's/^/        /g'
    sudo pacman -Sy --noconfirm git expect jq glibc glibc-locales which less python 2>&1 | sed 's/^/        /g'
elif [ -f /etc/redhat-release ]; then
    sudo dnf update -y 2>&1 | sed 's/^/        /g'
    sudo dnf install -y git python3 jq expect gettext glibc-all-langpacks glibc-locale-source 2>&1 | sed 's/^/        /g'
else
    echo "${CC_ERROR}This operating system is currently not supported, please install on your own.${CC_RESET}"
    exit 1
fi

###############################################################################
# STEP 2
###############################################################################

echo "$CC_STEP"
echo "Step 2: Download bashlib to your system"
echo "$CC_RESET"

echo "        Downloading..."
curl -L "$BASHLIB_DOWNLOAD" -o /tmp/bashlib.tgz 2>&1 | sed 's/^/        /g;s/\r/\r        /g'
echo "        Store under $install"
tar -xzf /tmp/bashlib.tgz -C "$install" --strip-components=1 \
    --exclude='bash-lib-master/tests' \
    --exclude='bash-lib-master/doc' 2>&1 | sed 's/^/        /g'
echo "        Remove unnecessary files"
rm /tmp/bashlib.tgz
rm -f "$install"/.* "$install"/optimize-code.sed "$install"/update "$install"/test "$install"/install "$install"/config/test-setup.conf 2>/dev/null || true
rm -rf "$install"/.vscode 2>/dev/null || true
find "$install" -name \*.bats -delete 2>/dev/null || true
find "$install" -name \*.md -delete 2>/dev/null || true
find "$install" -name \*.po -delete 2>/dev/null || true
sed "s|\${DATE}|$(date +%Y-%m-%d)|g" "$install"/install-info >"$install"/README.md || true
rm -f "$install"/install-info 2>/dev/null || true

###############################################################################
# STEP 3
###############################################################################

echo "$CC_STEP"
echo "Step 3: Setup BASHLIB_HOME in your environment."
echo "$CC_RESET"

if [ "$install" = "/opt/bashlib" ]; then
    environment=/etc/environment
    echo "        Set/update global environment in $environment:"
    sudo sed -i '/^BASHLIB_HOME=/d' "$environment"
    echo "BASHLIB_HOME=\"$install\"" | sudo tee -a "$environment" >/dev/null | sed 's/^/        /g'
else
    environment="$HOME"/.bashrc
    sudo sed -i '/^export BASHLIB_HOME=/d' "$environment"
    echo "        Added to $environment"
    echo "export BASHLIB_HOME=\"$install\"" >>"$environment" | sed 's/^/        /g'
fi

###############################################################################
# STEP 4
###############################################################################

echo "$CC_STEP"
echo "Step 4: Update local configuration files."
echo "$CC_RESET"

if [ -e "$config"secrets ]; then
    echo "        Use the existing ${config}secrets"
else
    echo "        Create example under ${config}secrets"
    cp "$install"/config/secrets.example "$config"secrets
fi
if [ -e "$config"local ]; then
    echo "        Use the existing ${config}local"
else
    cp "$install"/config/local.example "$config"local
    echo "        Created example under ${config}local"
fi
echo "        Link files into bashlib config dir"
rm -rf "$install"/config/secrets "$install"/config/local
ln -s "$config"secrets "$install"/config/secrets
ln -s "$config"local "$install"/config/local

echo "$CC_STEP"
echo "Finished successfully!"
echo "$CC_RESET"

if [ "$install" = "/opt/bashlib" ]; then
    echo "To uninstall use: sudo rm -rf \"$install\" \"$config\" && sudo sed -i '/BASHLIB_HOME=/d' \"$environment\""
else
    echo "To uninstall use: rm -rf \"$install\" \"$config\" && sed -i '/BASHLIB_HOME=/d' \"$environment\""
fi

echo "
Please re-login or set the updated configuration using: ${CC_INTENSITY_BOLD}source \"$environment\"${CC_RESET}

You could now use the bashlib. Test it with: ${CC_INTENSITY_BOLD}source \"\$BASHLIB_HOME\"/full; heading It works${CC_RESET}"

echo "$CC_STEP"
echo "Have fun!"
echo "$CC_RESET"
