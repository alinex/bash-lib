#!/usr/bin/env bash
# shellcheck source=base
source /dev/null

BASHLIB_DOWNLOAD="https://gitlab.com/alinex/bash-lib/-/archive/master/bash-lib-master.tar.gz"

CC_ERROR=$'\033[31m' # red
CC_STEP=$'\033[36m'  # cyan
CC_RESET=$'\033[0m'

logo() {
    a=$'\033[36m'                # cyan
    b=$'\033[33m\033[1m'         # yellow bold
    c=$'\033[43m\033[30m\033[1m' # yellow bg + black bold
    r=$'\033[0m'                 # reset
    u=$'\033[4m'                 # underline
    p="$(printf '%*s' $((($(tput cols) - 80) / 2)))"
    t="$(printf '%*s' $((($(tput cols) - ${#1}) / 2)))"
    echo
    echo "$p$a                         $b  __   ____     ___"
    echo "$p$a           ######  ##### $b ▕  ▏ ▕    ╲   ▕   ▏ $a  ########### #####       #####"
    echo "$p$a          ######## ##### $b ▕  ▏ ▕     ╲  ▕   ▏ $a ############  #####     #####"
    echo "$p$a         ######### ##### $b ▕  ▏ ▕  ▕╲  ╲ ▕   ▏ $a #####          #####   #####"
    echo "$p$a        ########## ##### $b ▕  ▏ ▕  ▕ ╲  ╲▕   ▏ $a #####           ##### #####"
    echo "$p$a       ##### ##### ##### $b ▕  ▏ ▕  ▕  ╲  ▔   ▏ $a ############     #########"
    echo "$p$a      #####  ##### ##### $b ▕  ▏ ▕  ▕   ╲     ▏ $a ############     #########"
    echo "$p$a     #####   ##### ##### $b ▕  ▏ ▕  ▕    ╲    ▏ $a #####           ##### #####"
    echo "$p$a    #####    ##### ##### $b  ▔▔   ▔▔▔     ▔▔▔▔  $a #####          #####   #####"
    echo "$p$a   ##### ######### ########################### ############  #####     #####"
    echo "$p$a  ##### ##########  #########################   ########### #####       ##### $r"
    echo "$p$b▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄$r$c"
    echo "$t$1$r"
    echo "$p$b▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀$r"
    echo
}

# To avoid question give all information:
# Usage:    install <path> <y|n> <config-path>

set -eE         # exit on uncatched failure
set -o pipefail # fail if any command in a pipeline fails

logo "Bash Lib 2 - INSTALLER"

echo "This will setup the bashlib on $(hostname -f) if not already done or update it..."
echo ""
# check bash version
if [ -z "${BASH_VERSION:-}" ]; then
    echo "${CC_ERROR}No bash CLI! This can only be run under bash >=4.2!${CC_RESET}"
    exit 1
fi
if ((${BASH_VERSINFO[0]} < 4 || (${BASH_VERSINFO[0]} == 4 && ${BASH_VERSINFO[1]} < 2))); then
    echo "${CC_ERROR}Bash library to old! This can only be run under bash >=4.2! You have Bash Version $BASH_VERSION${CC_RESET}"
    exit 1
fi
# ask for type of installation (if not update)
if [ -e /opt/bashlib ]; then
    yn=y
    echo "This will replace the installation under /opt/bashlib"
    read -n 1 -s -r -p "Press any key to continue..." </dev/tty
    echo
    sudo rm -rf /opt/bashlib
elif [ -e "$HOME"/bashlib ]; then
    yn=n
    echo "This will replace the installation under $HOME/bashlib"
    read -n 1 -s -r -p "Press any key to continue..." </dev/tty
    echo
    rm -rf "$HOME"/bashlib
else
    echo "No BashLib found, so it will be installed."
    [ -n "$2" ] && yn="$2" || read -r -n 1 -s -p "Should the bashlib path be added globally (Y/n) " yn </dev/tty
    echo
fi
case $yn in
"" | [JjYy])
    install=/opt/bashlib
    sudo mkdir -p -m 777 "$install"
    config=/etc/bashlib/
    sudo mkdir -p -m 777 "$config"
    ;;
*)
    install="$HOME"/bashlib
    mkdir "$install"
    config="$HOME"/.bashlib-
    sudo() { "$@"; } # don't use sudo
    ;;
esac

###############################################################################
# STEP 1
###############################################################################

echo "$CC_STEP"
echo "Step 1: Install mandatory packages"
echo "$CC_RESET"

echo "        Install needed packages..."
if [ -f /etc/debian_version ]; then
    sudo apt-get update 2>&1 | sed 's/^/        /g'
    sudo apt-get install -y bash iproute2 git tzdata curl locales gettext expect jq 2>&1 | sed 's/^/        /g'
elif [ -f /etc/alpine-release ]; then
    sudo apk update 2>&1 | sed 's/^/        /g'
    sudo apk add bash tzdata musl-locales musl-locales-lang git curl coreutils gettext expect sed jq 2>&1 | sed 's/^/        /g'
elif [ -f /etc/arch-release ]; then
    sudo pacman -Syu --noconfirm 2>&1 | sed 's/^/        /g'
    sudo pacman -Sy --noconfirm git expect jq glibc glibc-locales which less python 2>&1 | sed 's/^/        /g'
else
    echo "${CC_ERROR}This operating system is currently not supported, please install on your own.${CC_RESET}"
    exit 1
fi

###############################################################################
# STEP 2
###############################################################################

echo "$CC_STEP"
echo "Step 2: Download bashlib to your system"
echo "$CC_RESET"

echo "        Downloading..."
curl -L "$BASHLIB_DOWNLOAD" -o /tmp/bashlib.tgz 2>&1 | sed 's/^/        /g;s/\r/\r        /g'
echo "        Store under $install"
tar -xzf /tmp/bashlib.tgz -C "$install" --strip-components=1 \
    --exclude='bash-lib-master/tests' \
    --exclude='bash-lib-master/doc' 2>&1 | sed 's/^/        /g'
rm /tmp/bashlib.tgz
echo ""

###############################################################################
# STEP 3
###############################################################################

echo "$CC_STEP"
echo "Step 3: Setup BASHLIB_HOME in your environment."
echo "$CC_RESET"

if [ "$install" = "/opt/bashlib" ]; then
    environment=/etc/environment
    echo "        Set/update global environment in $environment:"
    sudo sed -i '/^BASHLIB_HOME=/d' $environment
    echo "BASHLIB_HOME=\"$install\"" | sudo tee -a $environment 2>&1 | sed 's/^/        /g'
else
    environment="$HOME"/.bashrc
    sudo sed -i '/^export BASHLIB_HOME=/d' $environment
    echo "        Added to $environment"
    echo "export BASHLIB_HOME=\"$install\"" | tee -a "$environment" 2>&1 | sed 's/^/        /g'
fi

###############################################################################
# STEP 4
###############################################################################

echo "$CC_STEP"
echo "Step 4: Update local configuration files."
echo "$CC_RESET"

if [ -e "$config"secrets ]; then
    echo "        Use the existing ${config}secrets"
else
    echo "        Create example under ${config}secrets"
    cp "$install"/config/secrets.example "$config"secrets
fi
if [ -e "$config"overwrite ]; then
    echo "        Use the existing ${config}overwrite"
else
    cp "$install"/config/overwrite.example "$config"overwrite
    echo "        Created example under ${config}overwrite"
fi
echo "        Link files into bashlib config dir"
rm -rf "$install"/config/secrets "$install"/config/overwrite
ln -s "$config"secrets "$install"/config/secrets
ln -s "$config"overwrite "$install"/config/overwrite
echo ""

echo "Please re-login or set the updated configuration using: source \"$environment\"

To uninstall use:
    sudo rm -rf "$install" "$config"
    sudo sed -i '/BASHLIB_HOME=/d' "$environment"

You could now use the bashlib by running: source \"\$BASHLIB_HOME\"/full
Or add it in your scripts."

echo "$CC_STEP"
echo "Have fun!"
echo "$CC_RESET"
