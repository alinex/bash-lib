#!/usr/bin/env bash

BASHLIB_HOME="$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$(pwd)/x}")")"
LOCALES="de en"
set -eE

echo "Update minimize bash-lib library... "
command -v shfmt >/dev/null || sudo apt install -y shfmt

echo "#!/usr/bin/env bash" >"$BASHLIB_HOME/full"
echo "BASHLIB_LOADER=\${BASHLIB_LOADER:-full}" >>"$BASHLIB_HOME/full"
echo -n '- full '
for folder in core module; do
    echo -n "$folder "
    for f in "$BASHLIB_HOME/$folder"/*; do
        if [[ -f "$f" && "$f" != *.* ]]; then
            shfmt -mn "$f" | grep -Ev '^#!/usr/bin/env bash|source /dev/null' >>"$BASHLIB_HOME/full"
        fi
    done
done
#sed -E -f optimize-code.sed "$BASHLIB_HOME/full" >"$BASHLIB_HOME/full2"
echo -n "(optimize) "
sed -i -E -f optimize-code.sed "$BASHLIB_HOME/full"
echo "fertig -> $(du -h full | cut -f1)B"
echo -n "- remote (clone) "
sed 's/BASHLIB_LOADER:-full/BASHLIB_LOADER:-remote/' "$BASHLIB_HOME/full" >"$BASHLIB_HOME/remote"
echo "source \$BASHLIB_HOME/configs" >>"$BASHLIB_HOME/full" # load configs
sed -i '/BASHLIB_LOADER:-remote/ a\
_tmpdir="${TMPDIR:-${TMP:-${TEMP:-/tmp}}}/bashlib"\
mkdir -p $_tmpdir/locale/en/LC_MESSAGES\
mkdir -p $_tmpdir/locale/de/LC_MESSAGES\
curl -s https://gitlab.com/alinex/bash-lib/-/raw/develop/locale/en/LC_MESSAGES/bashlib.mo >$_tmpdir/locale/en/LC_MESSAGES/bashlib.mo\
curl -s https://gitlab.com/alinex/bash-lib/-/raw/develop/locale/de/LC_MESSAGES/bashlib.mo >$_tmpdir/locale/de/LC_MESSAGES/bashlib.mo\
BASHLIB_HOME=$_tmpdir
' "$BASHLIB_HOME/remote"
echo "fertig -> $(du -h remote | cut -f1)B"
echo "#!/usr/bin/env bash" >"$BASHLIB_HOME/base"
echo "BASHLIB_LOADER=\${BASHLIB_LOADER:-base}" >>"$BASHLIB_HOME/base"
echo -n "- base core "
for f in "$BASHLIB_HOME"/core/*; do
    if [[ -f "$f" && "$f" != *.* ]]; then
        shfmt -mn "$f" | grep -Ev '^#!/usr/bin/env bash|source /dev/null' >>"$BASHLIB_HOME/base"
    fi
done
echo -n "(optimize) "
sed -i -E -f optimize-code.sed "$BASHLIB_HOME/base"
echo "fertig -> $(du -h base | cut -f1)B"

md_optimize() {
    awk '
    BEGIN { in_block=0; in_inline=0 }

    {
      line=$0

      # Toggle fenced code block state
      if (match(line, /^```/)) {
        in_block = !in_block
        if (in_block) {
            print "\n" line
        } else {
            print line
        }
        next
      }

      # If inside fenced block → print unchanged
      if (in_block) {
        print line
        next
      }

      # Process inline code: split by backticks
      n = split(line, parts, /`/)
      out = ""

      for (i=1; i<=n; i++) {
        if (i % 2 == 0) {
          # Inside inline backticks → leave unchanged
          out = out "`" parts[i] "`"
        } else {
          # Outside inline code → escape tags
          tmp = parts[i]
          gsub(/</, "`<", tmp)
          gsub(/>/, ">`", tmp)
          out = out tmp
        }
      }

      print out
    }
  '
}

echo "Update translations..."
command -v xgettext &>/dev/null || sudo apt install gettext
find core module extra -type f -not -name \*.\* -print0 | xargs -0 xgettext --from-code=UTF-8 -L Shell -o locale/bashlib.pot
sed -i 's/charset=CHARSET/charset=UTF-8/' locale/bashlib.pot
for lang in $LOCALES; do
    echo -n "- $lang"
    mkdir -p locale/"$lang"/LC_MESSAGES
    if [ -e locale/"$lang"/LC_MESSAGES/bashlib.po ]; then
        msgmerge --update locale/$lang/LC_MESSAGES/bashlib.po locale/bashlib.pot
    else
        cp locale/bashlib.pot locale/"$lang"/LC_MESSAGES/bashlib.po
        sed "s/Language: \\n/Language: $lang\\n/" locale/"$lang"/LC_MESSAGES/bashlib.po
    fi
    msgfmt locale/"$lang"/LC_MESSAGES/bashlib.po -o locale/"$lang"/LC_MESSAGES/bashlib.mo
done
find locale -name \*~ -delete

echo "Update documentation..."
rm "$BASHLIB_HOME"/doc/function/* 2>/dev/null || true
# remove commands from Readme
sed -i '/which are listed below\./q' "$BASHLIB_HOME"/doc/README.md
# loop over folder
for folder in config core module extra; do
    echo -e "\n## ${folder^}" >>"$BASHLIB_HOME"/doc/README.md
    # loop over modules
    for file in "$BASHLIB_HOME/$folder"/*; do
        [ ! -L "$file" ] || continue
        if [[ -f "$file" && "$file" != *.* ]]; then
            name="$(basename "$file")"
            [[ "$name" != "zulu" ]] || continue
            name="${name#[0-9]*_}" # remove prefix
            [[ "$name" != "internal" ]] || continue
            echo -n "- $folder/$name"
            (
                echo ""
                echo "### ${name^} Module"
                echo ""
                grep ^# "$file" | grep -Ev '^(#!|# shellcheck)' | head -1 | sed 's/# *//'
                echo ""
                echo "| Variable/Function | Description |"
                echo "| --- | --- |"
            ) >>"$BASHLIB_HOME"/doc/README.md
            # variables
            # shellcheck disable=SC2016
            awk '{  if ($0 ~ /^#/) {
                        if (!header_printed) {
                            header_line = $0
                            sub(/# /, "", header_line)
                            header_printed = 1
                        }
                    } else {
                        if ($0 ~ /^[0-9A-Z_]*=|^declare[[:space:]]-[Aa][[:space:]][0-9A-Z_]*=/) {
                            line = $0
                            sub(/=.*/, "", line)   # remove the pattern and everything after it
                            sub(/declare -[Aa] /, "", line) # remove declare
                            if (header_printed) {
                                print "| `$" line "` | " header_line " |"
                            }
                            header_printed = 0
                        } else {
                            header_printed = 0
                        }
                    }
                }' "$file" |
                sed -E 's#(^|[^[:alnum:]_.-])@([[:alnum:]_]+)(\[(.*)\])?#\1[`\2\4`](function\2.md)#g' |
                sed -E 's#(^|[^[:alnum:]_.-])&([[:alnum:]_]+)(\#[[:alnum:]_]+)?(\[(.*)\])?#\1[`\2\4`](example/\2.md\3)#g' |
                sed -E 's#(^|[^[:alnum:]_.-])&([[:alnum:]_]+)(\[(.*)\])?#\1[`\2\4`](example/\2.md)#g' |
                sed -E 's#(^|[^[:alnum:]_.-])(\$[[:alnum:]_]+)#\1`\2`#g' \
                    >>"$BASHLIB_HOME"/doc/README.md
            # Get function names and start lines using grep and awk
            # Supports functions declared as: name() { ... } or function name { ... }
            function_lines=$(awk '
                /^[[:space:]]*([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*\(\)[[:space:]]*\{/ {
                    print FNR, $0
                }
                /^[[:space:]]*function[[:space:]]+([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*\{/ {
                    print FNR, $0
                }
            ' "$file")
            [ -n "$function_lines" ] || continue
            # Loop over functions with line numbers
            while read -r line function_declaration; do
                echo -n "." >&2
                # Extract function name from declaration line
                funcName=$(echo "$function_declaration" | sed -n 's/.*function[[:space:]]*\([a-zA-Z_][a-zA-Z0-9_]*\).*/\1/p')
                [ -z "$funcName" ] && funcName=$(echo "$function_declaration" | sed -n 's/^\s*\([a-zA-Z_][a-zA-Z0-9_]*\).*/\1/p')
                # Extract comment block directly above function
                comments=""
                lineNum=$((line - 1))
                while ((lineNum > 0)); do
                    line_content=$(sed -n "${lineNum}p" "$file")
                    if [[ "$line_content" =~ ^[[:space:]]*# ]]; then
                        # shellcheck disable=SC2001
                        comments="$(sed 's/^\s*# \?//' <<<"$line_content")"$'\n'"$comments"
                    else
                        break
                    fi
                    lineNum=$((lineNum - 1))
                done
                # Parse documentation
                first=1
                chapter=""
                spaces=0
                description=""
                usage=""
                globals=""
                variables=""
                output=""
                error=""
                example=""
                options=""
                return=""
                tty=""
                files=""
                shopt -s nocasematch
                while IFS= read -r line; do
                    if [ -n "$first" ]; then
                        first=""
                        title="$line"
                    elif [[ "$line" =~ ^usage: ]] || { [ "$chapter" = "usage" ] && [[ "$line" =~ ^[[:space:]] ]]; }; then
                        if grep -Eiq "^usage:" <<<"$line"; then
                            # shellcheck disable=SC2001
                            start="$(sed 's/^\(usage:\s*\).*/\1/i' <<<"$line")"
                            chapter="usage"
                            spaces=${#start}
                        fi
                        usage+="\n${line:$spaces}"
                    elif [[ "$line" =~ ^option(s)?: ]] || { [ "$chapter" = "options" ] && [[ "$line" =~ ^[[:space:]] ]]; }; then
                        if grep -Eiq "^options?:" <<<"$line"; then
                            # shellcheck disable=SC2001
                            start="$(sed 's/^\(options\?:\s*\).*/\1/i' <<<"$line")"
                            chapter="options"
                            spaces=${#start}
                        fi
                        options+="\n${line:$spaces}"
                    elif [[ "$line" =~ ^variable(s)?: ]] || { [ "$chapter" = "variables" ] && [[ "$line" =~ ^[[:space:]] || "$line" =~ ^$ ]]; }; then
                        # shellcheck disable=SC2001
                        line="$(sed 's/^\(variables\?:\)\?\s*//i' <<<"$line")"
                        globals+="\n- $line"
                        chapter="variables"
                    elif [[ "$line" =~ ^global(s)?: ]] || { [ "$chapter" = "globals" ] && [[ "$line" =~ ^[[:space:]] || "$line" =~ ^$ ]]; }; then
                        # shellcheck disable=SC2001
                        line="$(sed 's/^\(globals\?:\)\?\s*//i' <<<"$line")"
                        globals+="\n- $line"
                        chapter="globals"
                    elif [[ "$line" =~ ^example(s)?: ]] || { [ "$chapter" = "example" ] && [[ "$line" =~ ^[[:space:]] || "$line" =~ ^$ ]]; }; then
                        # shellcheck disable=SC2001
                        line="$(sed 's/^\(examples\?:\)\?\s*//i' <<<"$line")"
                        example+="\n$line"
                        chapter="example"
                    elif [[ "$line" =~ ^tty: ]] || { [ "$chapter" = "tty" ] && [[ "$line" =~ ^[[:space:]] || "$line" =~ ^$ ]]; }; then
                        if grep -Eiq "^tty:" <<<"$line"; then
                            # shellcheck disable=SC2001
                            start="$(sed 's/^\(tty:\s*\).*/\1/i' <<<"$line")"
                            chapter="tty"
                            spaces=${#start}
                        fi
                        tty+="\n${line:$spaces}"
                    elif [[ "$line" =~ ^file(s)?: ]] || { [ "$chapter" = "files" ] && [[ "$line" =~ ^[[:space:]] || "$line" =~ ^$ ]]; }; then
                        # shellcheck disable=SC2001
                        line="$(sed 's/^\(files\?:\)\?\s*//i' <<<"$line")"
                        files+="\n- $line"
                        chapter="files"
                    elif [[ "$line" =~ ^output: ]] || { [ "$chapter" = "output" ] && [[ "$line" =~ ^[[:space:]] || "$line" =~ ^$ ]]; }; then
                        # shellcheck disable=SC2001
                        line="$(sed 's/^\(output:\)\?\s*//i' <<<"$line")"
                        output+="\n$line"
                        chapter="output"
                    elif [[ "$line" =~ ^error(s)?: ]] || { [ "$chapter" = "error" ] && [[ "$line" =~ ^[[:space:]] || "$line" =~ ^$ ]]; }; then
                        # shellcheck disable=SC2001
                        line="$(sed 's/^\(errors\?:\)\?\s*//i' <<<"$line")"
                        error+="\n$line"
                        chapter="error"
                    elif [[ "$line" =~ ^return(s)?: ]] || { [ "$chapter" = "return" ] && [[ "$line" =~ ^[[:space:]] || "$line" =~ ^$ ]]; }; then
                        # shellcheck disable=SC2001
                        line="$(sed 's/^\(returns\?:\)\?\s*//i' <<<"$line")"
                        return+="\n- $line"
                        chapter="return"
                    elif [[ ! "$line" =~ ^shellcheck ]]; then
                        description="$description\n$line"
                    fi
                done <<<"$comments"
                [ -n "$title" ] || continue
                [ -n "$funcName" ] || continue
                [[ ! "$funcName" =~ ^_.* ]] || continue
                # add to table
                echo "| [\`$funcName\`](function/$funcName.md) | $title |" >>"$BASHLIB_HOME"/doc/README.md
                # add detail pages
                shopt -u nocasematch
                # shellcheck disable=SC2016
                (
                    echo "# $funcName"
                    echo -e "\n## $title"
                    [ -z "$usage" ] || echo -e "\n### Usage\n\n\`\`\`bash${usage}\n\`\`\`"
                    [ -z "$options" ] || echo -e "\n### Options\n\n\`\`\`bash${options}\n\`\`\`"
                    [ -z "$variables" ] || echo -e "\n### Variables\n$variables" | md_optimize
                    [ -z "$globals" ] || echo -e "\n### Globals\n$globals" | md_optimize
                    [ -z "$files" ] || echo -e "\n### Files\n$files" | md_optimize
                    [ -z "$tty" ] || echo -e "\n### TTY (direct)\n${tty}" | md_optimize
                    [ -z "$output" ] || echo -e "\n### Output (stdout)\n$output" | md_optimize
                    [ -z "$error" ] || echo -e "\n### Error (stderr)\n$error" | md_optimize
                    [ -z "$return" ] || echo -e "\n### Return (exit code)\n$return" | md_optimize
                    [ -z "$example" ] || echo -e "\n### Examples\n$example" | md_optimize
                    [ -z "${description//[[:space:]]/}" ] || echo -e "\n### Description\n$description" | md_optimize
                ) |
                    sed -E 's#(^|[^[:alnum:]_.-])@([[:alnum:]_]+)(\[(.*)\])?#\1[`\2\4`](\2.md)#g' |
                    sed -E 's#(^|[^[:alnum:]_.-])&([[:alnum:]_]+)(\#[[:alnum:]_]+)?(\[(.*)\])?#\1[`\2\4`](../example/\2.md\3)#g' |
                    sed -E 's#(^|[^[:alnum:]_.-])(\$[[:alnum:]_]+)#\1`\2`#g' \
                        >"$BASHLIB_HOME"/doc/function/"$funcName".md
            done <<<"$function_lines"
            echo " fertig."
        fi
    done
done
echo
echo DONE
