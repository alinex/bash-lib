#!/usr/bin/env bash

BASHLIB_HOME="$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$(pwd)/x}")")"
LOCALES=de

echo -n "Update minimize bash-lib library... " >&2
command -v shfmt >/dev/null || sudo apt install -y shfmt

echo "#!/usr/bin/env bash" >"$BASHLIB_HOME/full"
echo -n "full ("
for folder in core module; do
    echo -n "$folder "
    for f in "$BASHLIB_HOME/$folder"/*; do
        if [[ -f "$f" && "$f" != *.* ]]; then
            shfmt -mn "$f" | grep -Ev '^#!/usr/bin/env bash|source /dev/null' >>"$BASHLIB_HOME/full"
        fi
    done
done
echo "source $BASHLIB_HOME/configs" >>"$BASHLIB_HOME/full" # load configs
echo "#!/usr/bin/env bash" >"$BASHLIB_HOME/base"
echo -en "\b) base (core)"
for f in "$BASHLIB_HOME"/core/*; do
    if [[ -f "$f" && "$f" != *.* ]]; then
        shfmt -mn "$f" | grep -Ev '^#!/usr/bin/env bash|source /dev/null' >>"$BASHLIB_HOME/base"
    fi
done
echo
echo

echo -n "Update translations... "
command -v xgettext &>/dev/null || sudo apt install gettext
find core module extra -type f -not -name \*.\* -print0 | xargs -0 xgettext -L Shell -o locale/bashlib.pot
#xgettext -L Shell -o locale/bashlib.pot _test
sed -i 's/charset=CHARSET/charset=UTF-8/' locale/bashlib.pot
for lang in $LOCALES; do
    mkdir -p locale/"$lang"/LC_MESSAGES
    if [ -e locale/"$lang"/LC_MESSAGES/bashlib.po ]; then
        msgmerge --update locale/de/LC_MESSAGES/bashlib.po locale/bashlib.pot
    else
        cp locale/bashlib.pot locale/"$lang"/LC_MESSAGES/bashlib.po
        sed "s/Language: \\n/Language: $lang\\n/" locale/LC_MESSAGES/"$lang"/bashlib.po
    fi
    msgfmt locale/"$lang"/LC_MESSAGES/bashlib.po -o locale/"$lang"/LC_MESSAGES/bashlib.mo
done
echo

echo "Update documentation..." >&2
rm "$BASHLIB_HOME"/doc/function/* 2>/dev/null || true
# remove commands from Readme
sed -i '/which are listed below\./q' "$BASHLIB_HOME"/doc/README.md
# loop over folder
for folder in config core module extra; do
    echo -e "\n## ${folder^}" >>"$BASHLIB_HOME"/doc/README.md
    echo -ne "$folder:\t" >&2
    # loop over modules
    for file in "$BASHLIB_HOME/$folder"/*; do
        [ ! -L "$file" ] || continue
        if [[ -f "$file" && "$file" != *.* ]]; then
            name="$(basename "$file")"
            name="${name#[0-9]*_}" # remove prefix
            echo -n " $name" >&2
            (
                echo ""
                echo "### ${name^} Module"
                echo ""
                grep ^# "$file" | grep -Ev '^(#!|# shellcheck)' | head -1 | sed 's/# *//'
                echo ""
                echo "| Variable/Function | Description |"
                echo "| --- | --- |"
            ) >>"$BASHLIB_HOME"/doc/README.md
            # variables
            # shellcheck disable=SC2016
            awk '{  if ($0 ~ /^#/) {
                        if (!header_printed) {
                            header_line = $0
                            sub(/# /, "", header_line)
                            header_printed = 1
                        }
                    } else {
                        if ($0 ~ /^[0-9A-Z_]*=|^declare[[:space:]]-[Aa][[:space:]][0-9A-Z_]*=/) {
                            line = $0
                            sub(/=.*/, "", line)   # remove the pattern and everything after it
                            sub(/declare -[Aa] /, "", line) # remove declare
                            if (header_printed) {
                                print "| `$" line "` | " header_line " |"
                            }
                            header_printed = 0
                        } else {
                            header_printed = 0
                        }
                    }
                }' "$file" |
                sed -E 's#(^|[^[:alnum:]_.-])@([[:alnum:]_]+)#\1[`\2`](function/\2.md)#g' |
                sed -E 's#(^|[^[:alnum:]_.-])(\$[[:alnum:]_]+)#\1`\2`#g' \
                    >>"$BASHLIB_HOME"/doc/README.md
            if [ -z "$function_lines" ]; then
                head -n -3 "$BASHLIB_HOME"/doc/README.md | sponge "$BASHLIB_HOME"/doc/README.md
            fi
            # Get function names and start lines using grep and awk
            # Supports functions declared as: fname() { ... } or function fname { ... }
            function_lines=$(awk '
                /^[[:space:]]*([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*\(\)[[:space:]]*\{/ {
                    print FNR, $0
                }
                /^[[:space:]]*function[[:space:]]+([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*\{/ {
                    print FNR, $0
                }
            ' "$file")
            tag2code() {
                code="$1"
                code="${code//</\`<}"
                code="${code//>/>\`}"
                echo "$code"
            }
            [ -n "$function_lines" ] || continue
            # Loop over functions with line numbers
            while read -r line function_declaration; do
                echo -n "." >&2
                # Extract function name from declaration line
                funcname=$(echo "$function_declaration" | sed -n 's/.*function[[:space:]]*\([a-zA-Z_][a-zA-Z0-9_]*\).*/\1/p')
                [ -z "$funcname" ] && funcname=$(echo "$function_declaration" | sed -n 's/^\s*\([a-zA-Z_][a-zA-Z0-9_]*\).*/\1/p')
                # Extract comment block directly above function
                comments=""
                linenum=$((line - 1))
                while ((linenum > 0)); do
                    line_content=$(sed -n "${linenum}p" "$file")
                    if [[ "$line_content" =~ ^[[:space:]]*# ]]; then
                        # shellcheck disable=SC2001
                        comments="$(sed 's/^\s*# //' <<<"$line_content")"$'\n'"$comments"
                    else
                        break
                    fi
                    linenum=$((linenum - 1))
                done
                # Parse documentation
                first=1
                chapter=""
                spaces=0
                description=""
                usage=""
                globals=""
                output=""
                error=""
                example=""
                options=""
                return=""
                tty=""
                files=""
                shopt -s nocasematch
                while IFS= read -r line; do
                    if [ -n "$first" ]; then
                        first=""
                        title="$line"
                    elif [[ "$line" =~ ^usage: ]] || { [ "$chapter" = "usage" ] && [[ "$line" =~ ^[[:space:]] ]]; }; then
                        if grep -Eiq "^usage:" <<<"$line"; then
                            # shellcheck disable=SC2001
                            start="$(sed 's/^\(usage:\s*\).*/\1/i' <<<"$line")"
                            chapter="usage"
                            spaces=${#start}
                        fi
                        usage+="\n${line:$spaces}"
                    elif [[ "$line" =~ ^options: ]] || { [ "$chapter" = "options" ] && [[ "$line" =~ ^[[:space:]] ]]; }; then
                        if grep -Eiq "^options?:" <<<"$line"; then
                            # shellcheck disable=SC2001
                            start="$(sed 's/^\(options\?:\s*\).*/\1/i' <<<"$line")"
                            chapter="options"
                            spaces=${#start}
                        fi
                        options+="\n${line:$spaces}"
                    elif [[ "$line" =~ ^globals: ]] || { [ "$chapter" = "globals" ] && [[ "$line" =~ ^[[:space:]] ]]; }; then
                        # shellcheck disable=SC2001
                        line="$(sed 's/^\(globals\?:\)\?\s*//i' <<<"$line")"
                        globals+="\n- $line"
                        chapter="globals"
                    elif [[ "$line" =~ ^example: ]] || { [ "$chapter" = "example" ] && [[ "$line" =~ ^[[:space:]] ]]; }; then
                        # shellcheck disable=SC2001
                        line="$(sed 's/^\(examples\?:\)\?\s*//i' <<<"$line")"
                        example+="\n- $line"
                        chapter="example"
                    elif [[ "$line" =~ ^tty: ]] || { [ "$chapter" = "tty" ] && [[ "$line" =~ ^[[:space:]] ]]; }; then
                        if grep -Eiq "^tty:" <<<"$line"; then
                            # shellcheck disable=SC2001
                            start="$(sed 's/^\(tty:\s*\).*/\1/i' <<<"$line")"
                            chapter="tty"
                            spaces=${#start}
                        fi
                        tty+="\n${line:$spaces}"
                    elif [[ "$line" =~ ^files: ]] || { [ "$chapter" = "files" ] && [[ "$line" =~ ^[[:space:]] ]]; }; then
                        # shellcheck disable=SC2001
                        line="$(sed 's/^\(files\?:\)\?\s*//i' <<<"$line")"
                        files+="\n- $line"
                        chapter="files"
                    elif [[ "$line" =~ ^output: ]] || { [ "$chapter" = "output" ] && [[ "$line" =~ ^[[:space:]] ]]; }; then
                        # shellcheck disable=SC2001
                        line="$(sed 's/^\(output:\)\?\s*//i' <<<"$line")"
                        output+="\n- $line"
                        chapter="output"
                    elif [[ "$line" =~ ^error: ]] || { [ "$chapter" = "error" ] && [[ "$line" =~ ^[[:space:]] ]]; }; then
                        # shellcheck disable=SC2001
                        line="$(sed 's/^\(error:\)\?\s*//i' <<<"$line")"
                        error+="\n- $line"
                        chapter="error"
                    elif [[ "$line" =~ ^return: ]] || { [ "$chapter" = "return" ] && [[ "$line" =~ ^[[:space:]] ]]; }; then
                        # shellcheck disable=SC2001
                        line="$(sed 's/^\(returns\?:\)\?\s*//i' <<<"$line")"
                        return+="\n- $line"
                        chapter="return"
                    else
                        description="$description\n$line"
                    fi
                done <<<"$comments"
                [ -n "$title" ] || continue
                [ -n "$funcname" ] || continue
                [[ ! "$funcname" =~ ^_.* ]] || continue
                # add to table
                echo "| [\`$funcname\`](function/$funcname.md) | $title |" >>"$BASHLIB_HOME"/doc/README.md
                # add detail pages
                shopt -u nocasematch
                # shellcheck disable=SC2016
                (
                    echo "# $funcname"
                    echo -e "\n## $title"
                    [ -z "${description//[[:space:]]/}" ] || echo -e "$(tag2code "$description")"
                    [ -z "$usage" ] || echo -e "\n### Usage\n\n\`\`\`bash${usage}\n\`\`\`"
                    [ -z "$options" ] || echo -e "\n### Options\n\n\`\`\`bash${options}\n\`\`\`"
                    [ -z "$globals" ] || echo -e "\n### Globals\n$(tag2code "$globals")"
                    [ -z "$tty" ] || echo -e "\n### TTY (direct)\n\n\`\`\`bash${tty}\n\`\`\`"
                    [ -z "$files" ] || echo -e "\n### Files\n$(tag2code "$files")"
                    [ -z "$output" ] || echo -e "\n### Output (stdout)\n$(tag2code "$output")"
                    [ -z "$error" ] || echo -e "\n### Error (stderr)\n$(tag2code "$error")"
                    [ -z "$return" ] || echo -e "\n### Return (exit code)\n$(tag2code "$return")"
                    [ -z "$example" ] || echo -e "\n### Examples\n$(tag2code "$example")"
                ) |
                    sed -E 's#(^|[^[:alnum:]_.-])@([[:alnum:]_]+)#\1[`\2`](\2.md)#g' |
                    sed -E 's#(^|[^[:alnum:]_.-])&([[:alnum:]_]+)#\1[`\2`](../example/\2.md)#g' |
                    sed -E 's#(^|[^[:alnum:]_.-])(\$[[:alnum:]_]+)#\1`\2`#g' \
                        >"$BASHLIB_HOME"/doc/function/"$funcname".md
            done <<<"$function_lines"
        fi
    done
    echo ""
done
echo
echo DONE
