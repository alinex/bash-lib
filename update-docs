#!/usr/bin/env bash

BASHLIB_HOME="$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$(pwd)/x}")")"

rm $BASHLIB_HOME/doc/function/* 2>/dev/null || true

echo "Update documentation..." >&2
# remove commands from Readme
sed -i '/which are listed below\./q' $BASHLIB_HOME/doc/README.md
# loop over folder
for folder in core module; do
    echo -e "\n## ${folder^}" >>$BASHLIB_HOME/doc/README.md
    echo -ne "$folder:\t" >&2
    # loop over modules
    for file in "$BASHLIB_HOME/$folder"/*; do
        if [[ -f "$file" && "$file" != *.* ]]; then
            name="$(basename "$file")"
            name="${name#[0-9]*_}" # remove prefix
            echo -n " $name" >&2
            (
                echo ""
                echo "### ${name^} Module"
                echo ""
                grep ^#\  "$file" | head -1 | sed 's/# *//'
                echo ""
                echo "| Variable/Function | Description |"
                echo "| --- | --- |"
            ) >>$BASHLIB_HOME/doc/README.md
            # variables
            awk '{  if ($0 ~ /^#/) {
                        if (!header_printed) {
                            header_line = $0
                            sub(/# /, "", header_line)
                            header_printed = 1
                        }
                    } else {
                        if ($0 ~ /^[0-9A-Z_]*=/) {
                            line = $0
                            sub(/=.*/, "", line)   # remove the pattern and everything after it
                            if (header_printed) {
                                print "| `$" line "` | " header_line " |"
                            }
                            header_printed = 0
                        } else {
                            header_printed = 0
                        }
                    }
                }' "$file" | sed -E 's#(^|[^[:alnum:]_.-])@([[:alnum:]_]+)#\1[`\2`](function/\2.md)#g' >>$BASHLIB_HOME/doc/README.md
            # Get function names and start lines using grep and awk
            # Supports functions declared as: fname() { ... } or function fname { ... }
            function_lines=$(awk '
                /^[[:space:]]*([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*\(\)[[:space:]]*\{/ {
                    print FNR, $0
                }
                /^[[:space:]]*function[[:space:]]+([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*\{/ {
                    print FNR, $0
                }
            ' "$file")
            tag2code() {
                code="$1"
                code="${code//</\`<}"
                code="${code//>/>\`}"
                echo "$code"
            }
            [ -n "$function_lines" ] || continue
            # Loop over functions with line numbers
            while read -r line function_declaration; do
                echo -n "." >&2
                # Extract function name from declaration line
                funcname=$(echo "$function_declaration" | sed -n 's/.*function[[:space:]]*\([a-zA-Z_][a-zA-Z0-9_]*\).*/\1/p')
                [ -z "$funcname" ] && funcname=$(echo "$function_declaration" | sed -n 's/^\s*\([a-zA-Z_][a-zA-Z0-9_]*\).*/\1/p')
                # Extract comment block directly above function
                comments=""
                linenum=$((line - 1))
                while [ $linenum -gt 0 ]; do
                    line_content=$(sed -n "${linenum}p" "$file")
                    if [[ "$line_content" =~ ^[[:space:]]*# ]]; then
                        comments="$(sed 's/^\s*# //' <<<"$line_content")"$'\n'"$comments"
                    else
                        break
                    fi
                    linenum=$((linenum - 1))
                done
                # Parse documentation
                first=1
                chapter=""
                description=""
                usage=""
                output=""
                error=""
                example=""
                options=""
                return=""
                shopt -s nocasematch
                while IFS= read -r line; do
                    if [ -n "$first" ]; then
                        first=""
                        title="$line"
                    elif [[ "$line" =~ ^usage: ]] || { [ "$chapter" = "usage" ] && [[ "$line" =~ ^[[:space:]] ]]; }; then
                        line="$(sed 's/^\(usage:\)\?\s*//i' <<<"$line")"
                        usage="$usage\n$line"
                        chapter=usage
                    elif [[ "$line" =~ ^options: ]] || { [ "$chapter" = "options" ] && [[ "$line" =~ ^[[:space:]] ]]; }; then
                        line="$(sed 's/^\(options:\)\?\s*//i' <<<"$line")"
                        options="$options\n$line"
                        chapter=options
                    elif [[ "$line" =~ ^example: ]] || { [ "$chapter" = "example" ] && [[ "$line" =~ ^[[:space:]] ]]; }; then
                        line="$(sed 's/^\(example:\)\?\s*//i' <<<"$line")"
                        example="$example\n$line"
                        chapter=example
                    elif [[ "$line" =~ ^output: ]] || { [ "$chapter" = "output" ] && [[ "$line" =~ ^[[:space:]] ]]; }; then
                        line="$(sed 's/^\(output:\)\?\s*//i' <<<"$line")"
                        output="$output\n- $line"
                        chapter=output
                    elif [[ "$line" =~ ^error: ]] || { [ "$chapter" = "error" ] && [[ "$line" =~ ^[[:space:]] ]]; }; then
                        line="$(sed 's/^\(error:\)\?\s*//i' <<<"$line")"
                        error="$error\n- $line"
                        chapter=error
                    elif [[ "$line" =~ ^return: ]] || { [ "$chapter" = "return" ] && [[ "$line" =~ ^[[:space:]] ]]; }; then
                        line="$(sed 's/^\(return:\)\?\s*//i' <<<"$line")"
                        return="$return\n- $line"
                        chapter=return
                    else
                        description="$description\n$line"
                    fi
                done <<<"$comments"
                # add to table
                echo "| [\`$funcname\`](function/$funcname.md) | $title |" >>$BASHLIB_HOME/doc/README.md
                # add detail pages
                shopt -u nocasematch
                (
                    echo "# $funcname"
                    echo -e "\n## $title"
                    [ -z "${description//[[:space:]]/}" ] || echo -e "$(tag2code "$description")"
                    [ -z "$usage" ] || echo -e "\n### Usage\n\n\`\`\`bash${usage}\n\`\`\`"
                    [ -z "$options" ] || echo -e "\n### Options\n\n\`\`\`bash${options}\n\`\`\`"
                    [ -z "$output" ] || echo -e "\n### Output (stdout)\n$(tag2code "$output")"
                    [ -z "$error" ] || echo -e "\n### Error (stderr)\n$(tag2code "$error")"
                    [ -z "$return" ] || echo -e "\n### Return (exit code)\n$(tag2code "$return")"
                    [ -z "$example" ] || echo -e "\n### Example\n\n\`\`\`bash${example}\n\`\`\`"
                ) | sed -E 's#(^|[^[:alnum:]_.-])@([[:alnum:]_]+)#\1[`\2`](function/\2.md)#g' >$BASHLIB_HOME/doc/function/$funcname.md
            done <<<"$function_lines"
        fi
    done
    echo ""
done
echo DONE
