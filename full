pause(){
local timeout abort
eval set -- "$(option_parse $'a abort -\nT timeout +' "$@")"
while true;do
case "$1" in
-T|--timeout)timeout="$(duration_format seconds "$2")"
shift 2
;;
-a|--abort)abort=1
shift
;;
--)shift
break
;;
*)die "$(gettext "Unrecognized option"): $1"
esac
done
local text length
text="$(input "$@")"
if [ -z "$text" ];then
[ -n "$timeout" ]&&[ -z "$abort" ]&&text="$(gettext 'Please wait to go on')"||text="$(gettext 'Press any key to continue...')"
fi
echo -en "$CC_INFO$text$CC_RESET "
if [ -z "$timeout" ];then
read -n 1 -s -r _ </dev/tty
else
stty -echo </dev/tty
while ((timeout>0));do
echo -ne "\r$CC_INFO$text$CC_RESET $(duration_format human "$timeout")     "
if read -r -s -t 1 -n 1 _ </dev/tty;then
if [ -n "$abort" ];then
echo -e "\b\b\b\b$(gettext 'aborted by user')    "
stty echo </dev/tty
return 1
fi
fi
((timeout--))
((timeout>0))||echo -ne "\r$CC_INFO$text$CC_RESET 0s      "
done
stty echo </dev/tty
fi
echo ""
}
confirm(){
local default timeout
eval set -- "$(option_parse $'t true -\nf false -\nT timeout +' "$@")"
while true;do
case "$1" in
-t|--true)default=1
shift
;;
-f|--false)default=0
shift
;;
-T|--timeout)timeout="$(duration_format seconds "$2")"
shift 2
;;
--)shift
break
;;
*)die "$(gettext "Unrecognized option"): $1"
esac
done
local prompt
prompt="${1:-$(gettext "Should this be done")}"
local char="" seq itext invalid rc
local countdown="$timeout"
if [ -n "$default" ];then
((default==0))&&prompt="$prompt [$(gettext "No")]"||prompt="$prompt [$(gettext "Yes")]"
fi
echo -en "$CC_INFO$prompt?$CC_RESET " >/dev/tty
stty -echo </dev/tty
while IFS= read -r -s -t 1 -n 1 char </dev/tty||rc=$?;do
if [ -n "$invalid" ];then
invalid=0
printf ' %.0s' {1..30} >/dev/tty
printf '\b%.0s' {1..30} >/dev/tty
fi
if ((rc==142));then
rc=0
if [ -n "$timeout" ];then
((countdown--))
if ((countdown>0));then
itext="  $(duration_format human "$countdown")     "
echo -ne "$itext$(printf '\b%.0s' $(seq 1 ${#itext}))" >/dev/tty
continue
fi
else
continue
fi
fi
if [[ $char == "" ]];then
if [ -n "$default" ];then
if ((default==1));then
echo -e "$(gettext "Yes")     " >/dev/tty
stty echo </dev/tty
return 0
else
echo -e "$(gettext "No")     " >/dev/tty
stty echo </dev/tty
return 1
fi
elif [ -n "$itext" ];then
itext="$(gettext 'value needed')"
echo -en "   $CC_RED$itext$CC_RESET$(printf '\b%.0s' $(seq 1 $((${#itext}+3))))" >/dev/tty
invalid=1
fi
elif [[ $char == $'\033' ]];then
read -r -s -n 1 -t 0.01 seq
while [[ $seq == "[" || $seq =~ [0-9A-Za-z~] ]];do
read -r -s -n 1 -t 0.01 seq||break
done
elif [[ $char =~ [JjYy] ]];then
echo -e "$(gettext "Yes")" >/dev/tty
stty echo </dev/tty
return 0
elif [[ $char =~ [Nn] ]];then
echo -e "$(gettext "No")" >/dev/tty
stty echo </dev/tty
return 1
else
itext="$(gettext 'invalid character')"
echo -en "   $CC_RED$itext$CC_RESET$(printf '\b%.0s' $(seq 1 $((${#itext}+3))))" >/dev/tty
invalid=1
fi
itext=""
done
stty echo </dev/tty
}
