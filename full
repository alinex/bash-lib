semver(){
input "$@"|sed -e 's#[^0-9]*\([0-9]*:\)\?\([0-9]*\)\([.]\([0-9]*\)\)\?\([.]\([0-9]*\)\)\?\(-\([^+]*\)\)\?+\?\(.*\)\?.*#\2\n\4\n\6\n\8\n\9#'
}
semver_diff(){
eval set -- "$(option_parse "h human -" "$@")"
local human
while true;do
case "$1" in
-h|--human)human=1
shift
;;
--)shift
break
;;
*)die "$(gettext "Unrecognized option"): $1"
esac
done
num_parameters "$@" --min 2 --max 2 --die "Need exactly two parameters: semver_diff [-h] <first> <second>"
[[ ${1-} =~ [.-] ]]&&version1="$(semver "$1")"||version1="$1"
[[ ${2-} =~ [.-] ]]&&version2="$(semver "$2")"||version2="$2"
IFS=$'\n' readarray -t v1 <<<"$version1"
IFS=$'\n' readarray -t v2 <<<"$version2"
local num=0
maj1=${v1[0]}
maj2=${v2[0]}
min1=${v1[1]:-0}
min2=${v2[1]:-0}
pat1=${v1[2]:-0}
pat2=${v2[2]:-0}
pre1=${v1[3]}
pre2=${v2[3]}
bld1=${v1[4]}
bld2=${v2[4]}
if [ "$maj1" -ne "$maj2" ];then
num=$(((maj2-maj1)*1000000000))
elif [ "$min1" -ne "$min2" ];then
num=$(((min2-min1)*1000000))
((num<1000000000))||num=999000000
elif [ "$pat1" -ne "$pat2" ];then
num=$(((pat2-pat1)*1000))
((num<1000000))||num=999000
elif [[ $pre1 < $pre2 ]];then
num=10
elif [[ $pre1 > $pre2 ]];then
num=-10
elif [[ $bld1 < $bld2 ]];then
num=1
elif [[ $bld1 > $bld2 ]];then
num=-1
fi
local step
if [ -n "$human" ];then
echo -n "$1 -> $2 "
if ((num==0));then
gettext "are identical versions"
echo
elif ((num>=1000000000));then
step=$((num/1000000000))
eval_ngettext "is an upgrade of one major version" 'is an upgrade of $step mayjor versions' "$step"
echo
elif ((num>=1000000));then
step=$((num/1000000))
eval_ngettext "is an upgrade of one minor version" 'is an upgrade of $step minor versions' "$step"
echo
elif ((num>=1000));then
step=$((num/1000))
eval_ngettext "is an upgrade of one patch version" 'is an upgrade of $step patch versions' "$step"
echo
elif ((num>=1));then
gettext "is a developer upgrade"
echo
elif ((num>=-1000));then
gettext "is a developer downgrade"
echo
elif ((num>=1000000));then
step=$((num/-1000))
eval_ngettext "is an downgrade of one patch version" 'is an downgrade of $step patch versions' "$step"
echo
elif ((num>=1000000000));then
step=$((num/-1000000))
eval_ngettext "is an upgrade of one minor version" 'is an upgrade of $step minor versions' "$step"
echo
else
step=$((num/1000000000))
eval_ngettext "is an upgrade of one major version" 'is an upgrade of $step mayjor versions' "$step"
echo
fi
return 0
else
echo "$num"
fi
((num==0))&&return 0||return 1
}
num_parameters(){
eval set -- "$(option_parse $'- min +\n- max +\n- die +' "$@")"
local min max die
while true;do
case "$1" in
--min)min=$2
shift 2
;;
--max)max=$2
shift 2
;;
--die)die=$2
shift 2
;;
--)shift
break
;;
*)die "$(gettext "Unrecognized option"): $1"
esac
done
_die(){
read -r line func file <<<"$(caller 1)"
echo "Check ${FUNCNAME[1]}: $1 ($func in $file:$line)" >&2
[ -z "$die" ]||die "$die"
return 1
}
[ -z "$min" ]||(($#>=min))||_die "[$*] $# < $min (min)"||return 1
[ -z "$max" ]||(($#<=max))||_die "[$*] $# > $max (max)"||return 1
}
is_success(){
num_parameters --min 1 --max 1 --die "Only one argument allowed, got: $#" -- "$@"
return "$1"
}
is_empty(){
num_parameters --max 1 --die "Only one argument allowed, got: $#" -- "$@"
[ -z "$1" ]
}
is_integer(){
num_parameters --min 1 --max 1 --die "Only one argument allowed, got: $#" -- "$@"
[[ $1 =~ ^-?[0-9]+$ ]]
}
is_float(){
num_parameters --min 1 --max 1 --die "Only one argument allowed, got: $#" -- "$@"
[[ $1 =~ ^[-+]?[0-9]+([.][0-9]+)?$ ]]
}
trim_start(){
local str="${1-}"
