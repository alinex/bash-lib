trap_add(){
local new="$1"
local sig="$2"
local old
old="$(trap -p "$sig"|awk -F"'" '{print $2}')"
if [[ -n $old ]];then
trap "$new; $old" "$sig"
else
trap "$new" "$sig"
fi
}
trap_remove(){
local remove="$1"
local sig="$2"
local current new
debug 3 "remove $remove from $sig"
current="$(trap -p "$sig"|awk -F"'" '{print $2}')"
new="$(echo "$current"|sed "s#;* *$remove##")"
trap "$new" "$sig"
}
mktemp(){
eval set -- "$(option_parse $'d directory -\ne extension +\nm memory -\np path +\nr random -\nT ttl +' "$@")"
local dir ext result rand
local path=${TMPDIR:-/tmp}
while true;do
case "$1" in
-d|--directory)dir=1
shift
;;
-e|--extension)ext=".$2"
shift 2
;;
-m|--memory)path="/dev/shm"
shift
;;
-p|--path)path="$2"
shift 2
;;
-r|--random)rand=$RANDOM
shift
;;
-T|--ttl)ttl="$(duration_format seconds "$2")"
shift 2
;;
--)shift
break
;;
*)shift
esac
done
local ident
[ -n "$1" ]&&ident="_$1"
result="$path/$(basename "$0")$ident$rand$ext"
if [ -n "$rand" ];then
while [ -e "$result" ];do
result="$path/$(basename "$0")$ident$RANDOM$ext"
done
fi
if [ -e "$result" ];then
debug "already exists $result"
else
if [ -n "$dir" ];then
debug "create dir $result"
mkdir -p "$result"
else
debug "create file $result"
touch "$result"
fi
fi
echo "$result"
[ -z "$ttl" ]||(_rmtemp "$ttl" "$result" >/dev/null 2>&1&
disown)
}
_rmtemp(){
local wait="$1" file="$2"
while [ -e "$result" ]&&((wait>0));do
sleep 1
((wait--))
done
[ ! -e "$result" ]||rm -r "$result"
debug "Removed $file after TTL $1 seconds"
}
