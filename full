option_parse(){
local opt name type desc short="" long="" spec="$1" permute
[ -n "$spec" ]||die "$(gettext 'A specification string is needed as first argument')"
if [[ $spec =~ ^\+ ]];then
permute=+
spec="${spec:1}"
fi
while IFS=$' \t\n' read -r opt name type desc;do
[[ $opt =~ ^# ]]&&continue
[[ -z $opt ]]&&continue
if [[ $type == *\? ]];then
[ "$opt" = "-" ]||short+="$opt::"
long+="$name::,"
elif [ ! "$type" = "-" ];then
[ "$opt" = "-" ]||short+="$opt:"
long+="$name:,"
else
[ "$opt" = "-" ]||short+="$opt"
long+="$name,"
fi
done <<<"$spec"
shift
getopt -o "$permute$short" --long "$long" -n "$0" -- "$@"
}
option_help(){
is set --name=spec --die -- "$1"
declare opt name type desc
declare -A opt_descriptions
declare -A opt_type
declare -A opt_short
while read -r opt name type desc;do
[[ $opt =~ ^# ]]&&continue
is empty -- "$opt"&&continue
opt_descriptions[$name]="$desc"
[[ $type == *\? ]]&&opt_type[$name]="[${type%?}]"||opt_type[$name]=$type
opt_short[$name]=$opt
done <<<"$1"
printf '%s\n' "$(gettext "Options"):"
for name in "${!opt_descriptions[@]}";do
local type_text=""
local short_text=""
if [ ! "${opt_type[$name]}" = "-" ];then
type_text=" <${opt_type[$name]}>"
fi
if [[ ! ${opt_short[$name]} == "-" ]];then
short_text="-${opt_short[$name]}$type_text, "
fi
printf "  %-40s %s\n" "$short_text--$name$type_text" "${opt_descriptions[$name]}"
done
}
