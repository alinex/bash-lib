            | .buf = [] | .mode = null
          elif .mode == "ol" then
            .out += [ ordered(.buf) ]
            | .buf = [] | .mode = null
          elif (.pBuf | length) > 0 then
            .out += [ paragraph(.pBuf | join("\n")) ]
            | .pBuf = []
          else .
          end

        # bullet list
        elif ($line | startswith("- ")) then
          if (.pBuf | length) > 0 then
            .out += [ paragraph(.pBuf | join("\n")) ]
            | .pBuf = []
          else .
          end
          | if .mode == "ul" then
              .buf += [ $line[2:] ]
            else
              if .mode == "ol" then
                .out += [ ordered(.buf) ]
              end
              | .mode = "ul"
              | .buf = [ $line[2:] ]
            end

        # ordered list
        elif ($line | test("^[0-9]+\\. ")) then
          if (.pBuf | length) > 0 then
            .out += [ paragraph(.pBuf | join("\n")) ]
            | .pBuf = []
          else .
          end
          | if .mode == "ol" then
              .buf += [ ($line | sub("^[0-9]+\\. "; "")) ]
            else
              if .mode == "ul" then
                .out += [ bullet(.buf) ]
              end
              | .mode = "ol"
              | .buf = [ ($line | sub("^[0-9]+\\. "; "")) ]
            end

        # normal text → append to paragraph buffer
        else
          if .mode == "ul" then
            .out += [ bullet(.buf) ]
            | .buf = [] | .mode = null
          elif .mode == "ol" then
            .out += [ ordered(.buf) ]
            | .buf = [] | .mode = null
          else .
          end
          | .pBuf += [ $line ]
        end
      )
    # flush leftovers
    | (
        .out
        + (if .mode == "ul" then [ bullet(.buf) ]
           elif .mode == "ol" then [ ordered(.buf) ]
           else [] end)
        + (if (.pBuf | length) > 0 then [ paragraph(.pBuf | join("\n")) ]
           else [] end)
      )
    | {
        type: "doc",
        version: 1,
        content: .
      }
  '|sed -E '
    s/\*\*(.+?)\*\*/<strong>\1<\/strong>/g
    s/\*(.+?)\*/<em>\1<\/em>/g
    s/`([^`]+)`/<code>\1<\/code>/g
  '
