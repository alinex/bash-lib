IFS=$'\n' readarray -t v2 <<<"$version2"
local num=0
maj1=${v1[0]}
maj2=${v2[0]}
min1=${v1[1]:-0}
min2=${v2[1]:-0}
pat1=${v1[2]:-0}
pat2=${v2[2]:-0}
pre1=${v1[3]}
pre2=${v2[3]}
bld1=${v1[4]}
bld2=${v2[4]}
if [ "$maj1" -ne "$maj2" ];then
num=$(((maj2-maj1)*1000000000))
elif [ "$min1" -ne "$min2" ];then
num=$(((min2-min1)*1000000))
((num<1000000000))||num=999000000
elif [ "$pat1" -ne "$pat2" ];then
num=$(((pat2-pat1)*1000))
((num<1000000))||num=999000
elif [[ $pre1 < $pre2 ]];then
num=10
elif [[ $pre1 > $pre2 ]];then
num=-10
elif [[ $bld1 < $bld2 ]];then
num=1
elif [[ $bld1 > $bld2 ]];then
num=-1
fi
local step
if [ -n "$human" ];then
printf '%s' "$1 -> $2 "
if ((num==0));then
gettext "are identical versions"
printf '\n'
elif ((num>=1000000000));then
step=$((num/1000000000))
printf '%s\n' "$(eval_ngettext "is an upgrade of one major version" 'is an upgrade of $step major versions' "$step")"
elif ((num>=1000000));then
step=$((num/1000000))
printf '%s\n' "$(eval_ngettext "is an upgrade of one minor version" 'is an upgrade of $step minor versions' "$step")"
elif ((num>=1000));then
step=$((num/1000))
printf '%s\n' "$(eval_ngettext "is an upgrade of one patch version" 'is an upgrade of $step patch versions' "$step")"
elif ((num>=1));then
printf '%s\n' "$(gettext "is a developer upgrade")"
elif ((num>=-1000));then
printf '%s\n' "$(gettext "is a developer downgrade")"
elif ((num>=1000000));then
step=$((num/-1000))
printf '%s\n' "$(eval_ngettext "is a downgrade of one patch version" 'is a downgrade of $step patch versions' "$step")"
elif ((num>=1000000000));then
step=$((num/-1000000))
printf '%s\n' "$(eval_ngettext "is an upgrade of one minor version" 'is an upgrade of $step minor versions' "$step")"
else
step=$((num/1000000000))
printf '%s\n' "$(eval_ngettext "is an upgrade of one major version" 'is an upgrade of $step major versions' "$step")"
fi
return 0
else
printf '%s\n' "$num"
fi
((num==0))&&return 0||return 1
}
