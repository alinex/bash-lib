_deprecated(){
IFS=$' \t\n' read -r line func file <<<"$(caller 1)"
local message="DEPRECATED: ${FUNCNAME[1]} at $func in $file:$line $1"
[ -n "$2" ]&&printf "$CC_WARN%s$CC_RESET" "$message (update it)" >&2||die "$message"
}
_stacktrace(){
local frame=1 line func src bestChoice
if [ -z "$1" ]&&((DEBUG<5));then bestChoice=1;fi
while read -r line func src < <(caller "$frame"||true);do
if [ -n "$bestChoice" ]&&[[ ! $func =~ ^is$|^check$ ]];then
printf "Triggered at %s:%d (%s)\n" "$src" "$line" "$func"|warn >&2
bestChoice=""
fi
printf "\033[1m%s:%d (%s)\n" "$src" "$line" "$func"|([ -n "$1" ]&&( ((frame==1))&&warn||notice)||debug 5) >&2
awk -v n="$line" '
            NR>=n-2 && NR<=n+2 {
                gsub(/^[ \t]+/, "", $0)  # Remove leading spaces/tabs
                printf "%4d: %s\n", NR, $0
                if(NR==n+2) exit
            }' "$src"|sed "/$line:/s/^/"$'\033[1m'"/;/$line:/s/$/"$'\033[22m'"/"|([ -n "$1" ]&&info||debug 6) >&2
((frame++))||true
done
}
use(){
is integer --name=arguments --max=1 --die -- $#
is set --name=module-path --die -- "$1"
local module=$1
[[ $module =~ / ]]||module="module/$module"
local path
path="$(dirname "$module")"
case $path in
core)return 0;;
module)[[ ! $BASHLIB_LOADER =~ loader|full|remote ]]||return 0
esac
debug 5 "Loading module $module"
source "$BASHLIB_HOME/$module"
}
trap_add(){
is integer --name=arguments --min=2 --max=2 --die -- $#
is set --name=code --die -- "$1"
is enum --name=signal --allow="SIGINT SIGTERM SIGHUP SIGQUIT SIGUSR1 SIGALRM EXIT ERR DEBUG" --die -- "$2"
local new="$1"
local sig="$2"
local old
old="$(trap -p "$sig"|awk -F"'" '{print $2}')"
if [[ -n $old ]];then
trap "$new; $old" "$sig"
else
trap "$new" "$sig"
fi
}
trap_remove(){
is integer --name=arguments --min=2 --max=2 --die -- $#
is set --name=code --die -- "$1"
is enum --name=signal --allow="SIGINT SIGTERM SIGHUP SIGQUIT SIGUSR1 SIGALRM EXIT ERR DEBUG" --die -- "$2"
local remove="$1"
local sig="$2"
local current new
debug 3 "remove $remove from $sig"
current="$(trap -p "$sig"|awk -F"'" '{print $2}')"
new="$(printf '%s' "$current"|sed "s#;* *$remove##")"
trap "$new" "$sig"
}
mktemp(){
eval set -- "$(option_parse $'d directory -\ne extension +\nm memory -\np path +\nr random -\nT ttl +' "$@")"
local dir ext result rand
local path=${TMPDIR:-/tmp}
while true;do
case "$1" in
-d|--directory)dir=1&&shift;;
-e|--extension)ext=".$2"&&shift 2;;
-m|--memory)path="/dev/shm"&&shift;;
-p|--path)path="$2"&&shift 2;;
-r|--random)rand=$RANDOM&&shift;;
-T|--ttl)ttl="$(duration_format seconds "$2")"&&shift 2;;
--)shift&&break;;
*)die "$(gettext "Unrecognized option"): $1"
esac
done
is integer --name=arguments --max=1 --die -- $#
local ident
is set -- "$1"&&ident="_$1"
result="$path/$(basename "$0")$ident$rand$ext"
if is set -- "$rand";then
while [ -e "$result" ];do
result="$path/$(basename "$0")$ident$RANDOM$ext"
done
fi
if [ ! -e "$result" ];then
if is set -- "$dir";then
debug "create dir $result"
mkdir -p "$result"
else
debug "create file $result"
touch "$result"
fi
fi
printf '%s' "$result"
is empty -- "$ttl"||(_rm_temp "$ttl" "$result" >/dev/null 2>&1&
disown)
}
_rm_temp(){
local wait="$1" file="$2"
while [ -e "$result" ]&&((wait>0));do
sleep 1
((wait--))
done
[ ! -e "$result" ]||rm -r "$result"
debug "Removed $file after TTL $1 seconds"
}
CURL_HTTP_CODE=""
curl(){
local args=() i=1 store
while [[ $i -le $# ]];do
if [[ ${!i} == "--store" ]];then
((i++))
store=${!i}
shift "$i"
i=1
continue
fi
args+=("${!i}")
((i++))
done
set -- "${args[@]}"
local args=("$@")
local file res
array args has '-o'||file=$(mktemp -r)
local opt
[ -z "$file" ]||opt="-o $file"
debug "curl -s $opt -L $(escape_args "$@")"
res=$(command curl -s -w "%{url_effective} with RC:%{http_code}" $opt -L "$@"|tail -1)
debug "Response: $res"
CURL_HTTP_CODE=${res: -3}
[ -z "$store" ]||variables store "$store" CURL_HTTP_CODE
if [[ ! $CURL_HTTP_CODE =~ ^2[0-9]{2}$ ]];then
error "Error: $res" >&2
if [ -e "$file" ];then
local val
val="$(cat "$file")"
[[ $val =~ ^\{ ]]&&jq . <<<"$val"|warn >&2||warn "$val" >&2
fi
fi
if [ -n "$file" ];then
cat "$file"
rm "$file"
fi
[[ $CURL_HTTP_CODE =~ ^2[0-9]{2}$ ]]
}
first(){
local value
for value in "$@";do
if [[ $value ]];then
printf '%s' "$value"
return 0
fi
done
return 1
}
debug(){
local level=1 func text sign='>'
is integer --name=arguments --max=2 --die -- $#
is integer --min 1 -- "$1"&&level="$1"&&shift||true
IFS=$' \t\n' read -r _ func _ <<<"$(caller 0||true)"
func="${func:-(main)}"
is set -- "$DEBUG"||return 0
text="$(input "$@")"
[[ $BASHLIB_LOADER != "remote" ]]||sign='>>'
if is integer -- "$DEBUG";then
is integer --min=0 --die -- "$DEBUG"
((level<=DEBUG))||return 0
else
[[ $func =~ .*(${DEBUG//,? /|}) ]]||return 0
fi
while IFS= read -r line;do
is integer --min=9 -- "$DEBUG"&&printf "$CC_BLACK%-2s %7d %-20s %s$CC_RESET\n" "$sign" "$BASHPID" "$func" "$line" >&2||printf "$CC_BLACK%-2s %-20s %s$CC_RESET\n" "$sign" "$func" "$line" >&2
done <<<"$text"
! command -v log >/dev/null||log debug "$func: $text"
