ask(){
local default empty negative timeout
eval set -- "$(option_parse $'e empty -\nd default +\nT timeout +\nn allow-negative -' "$@")"
while true;do
case "$1" in
-e|--empty)empty=1
shift
;;
-d|--default)default="$2"
shift 2
;;
-T|--timeout)timeout="$(duration_format seconds "$2")"
shift 2
;;
-n|--allow-negative)negative=1
shift
;;
--)shift
break
;;
*)die "$(gettext "Unrecognized option"): $1"
esac
done
local prompt pattern mask
local format="$1"
case $format in
integer|number)prompt="${2:-$(gettext "Enter integer number")}"
if [ -n "$negative" ];then
pattern="^(0|-?([1-9][0-9]*)?)$"
final="^-?[0-9]+$"
else
pattern="^(0|[1-9][0-9]*)$"
fi
;;
float)prompt="${2:-$(gettext "Enter float number")}"
if [ -n "$negative" ];then
pattern="^(0|-?([1-9][0-9]*)?)(\.[0-9]*)?$"
final="^(0|-?[1-9][0-9]*)(\.[0-9]+)?$"
else
pattern="^(0|[1-9][0-9]*)(\.[0-9]*)?$"
final="^(0|[1-9][0-9]*)(\.[0-9]+)?$"
fi
;;
password)prompt="${2:-$(gettext "Enter password")}"
mask=1
;;
time)prompt="${2:-$(gettext "Enter time")}"
pattern="^([0-1]?[0-9]|2[0-3])(:([0-5]?[0-9])?)?$"
final="^([0-1][0-9]|2[0-3]):[0-5][0-9]$"
;;
*)prompt="${2:-$(gettext "Enter short text")}"
esac
local input="" char="" seq invalid itext utext q
local countdown="$timeout"
[ -z "$default" ]&&[ -z "$empty" ]||prompt="$prompt [$default]"
echo -en "$CC_INFO$prompt:$CC_RESET " >/dev/tty
stty -echo </dev/tty
while IFS= read -r -s -t 1 -n 1 char </dev/tty||rc=$?;do
if [ -n "$invalid" ];then
invalid=0
printf ' %.0s' {1..30} >/dev/tty
printf '\b%.0s' {1..30} >/dev/tty
fi
if ((rc==142));then
rc=0
if [ -n "$timeout" ];then
((countdown--))
if ((countdown>0));then
itext="  $(duration_format human "$countdown")     "
echo -ne "$itext$(printf '\b%.0s' $(seq 1 ${#itext}))" >/dev/tty
continue
fi
else
continue
fi
fi
if [[ $char == "" ]];then
if [ -n "$final" ];then
if [[ $input =~ $final ]];then
echo "          " >/dev/tty
break
else
itext="$(gettext 'incomplete')"
echo -en "   $CC_RED$itext$CC_RESET$(printf '\b%.0s' $(seq 1 $((${#itext}+3))))" >/dev/tty
invalid=1
fi
elif [ -n "$input" ];then
echo "          " >/dev/tty
break
elif [ -n "$default" ];then
input="$default"
echo "          " >/dev/tty
break
elif [ -n "$empty" ];then
echo >/dev/tty
break
elif [ -n "$itext" ];then
itext="$(gettext 'value needed')"
echo -en "   $CC_RED$itext$CC_RESET$(printf '\b%.0s' $(seq 1 $((${#itext}+3))))" >/dev/tty
invalid=1
fi
elif [[ $char == $'\177' ]];then
if [ ${#input} -gt 0 ];then
input=${input:0:-1}
echo -ne "\b \b" >/dev/tty
fi
elif [[ $char == $'\033' ]];then
read -r -s -n 1 -t 0.01 seq
while [[ $seq == "[" || $seq =~ [0-9A-Za-z~] ]];do
read -r -s -n 1 -t 0.01 seq||break
done
else
if [ -n "$pattern" ];then
debug 7 "$(od -An -to1 -v <<<"$char") [[ \"$input$char\" =~ $pattern ]] $([[ "$input$char" =~ $pattern ]]&&echo true||echo false)"
if [ "$format" = "float" ]&&[ "$char" = "," ];then
char=.
fi
if [[ ! "$input$char" =~ $pattern ]];then
itext="$(gettext 'invalid character')"
echo -en "   $CC_RED$itext$CC_RESET$(printf '\b%.0s' $(seq 1 $((${#itext}+3))))" >/dev/tty
invalid=1
continue
fi
fi
input+="$char"
[ -n "$mask" ]&&echo -n "*" >/dev/tty||echo -n "$char" >/dev/tty
if [ "$format" = "password" ];then
q=$(_password_strength "$input")
if ((q<25));then
itext="$CC_RED$(gettext 'bad')$CC_RESET"
elif ((q<50));then
itext="$CC_YELLOW$(gettext 'weak')$CC_RESET"
elif ((q<75));then
itext="$(gettext 'good')"
else
itext="$CC_GREEN$(gettext 'strong')$CC_RESET"
fi
utext="$(uncolorize "$itext")"
echo -en "   $itext$(printf '\b%.0s' $(seq 1 $((${#utext}+3))))" >/dev/tty
invalid=1
fi
fi
itext=""
done
stty echo </dev/tty
debug 4 "Octal result: $(od -An -to1 -v <<<"$input")"
echo "$input"
}
_password_strength(){
local password="$1"
local len=${#password}
local score=0
((score+=len*4))
((score=score>40?40:score))
debug 7 "len $score"
[[ $password =~ [a-z] ]]&&((score+=5))
[[ $password =~ [A-Z] ]]&&((score+=5))
[[ $password =~ [0-9] ]]&&((score+=5))
[[ $password =~ [^a-zA-Z0-9] ]]&&((score+=5))
debug 7 "variety $score"
local unique
unique=$(echo "$password"|fold -w1|sort -u|wc -l)
((score+=unique*2))
((score=score>100?100:score))
debug 7 "uniqueness $score"
local check
for check in password qwerty qwertz;do
[[ ${password,,} =~ $check ]]&&((score-=40))
done
for check in 123 456 789 abc def ghi jkl mno pqr stv xyz;do
[[ ${password,,} =~ $check ]]&&((score-=15))
done
[[ $password =~ (.)\1{2,} ]]&&((score-=10))
((score=score<0?0:score))
debug 7 "penalties $score"
echo "$score"
}
choose(){
local end default timeout
eval set -- "$(option_parse $'t title +\nx exit +\nd default +\nT timeout +' "$@")"
while true;do
case "$1" in
-t|--title)info "$2" >/dev/tty
shift 2
;;
-d|--default)default="$2"
shift 2
;;
-x|--exit)end="$2"
shift 2
;;
-T|--timeout)timeout="$(duration_format seconds "$2")"
shift 2
;;
--)shift
break
;;
*)die "$(gettext "Unrecognized option"): $1"
esac
done
local list line key display num=0 pattern max
list="$(input_lines "$@")"
list="$(trim "$list"|grep -v ^#)"
max="$(wc -l <<<"$list")"
length="${#max}"
while read -r line;do
num=$((num+1))
IFS="|" read -r key display <<<"$line"
if [ -n "$default" ];then
[ "$default" = "$(trim "$key")" ]&&default="$num"||true
[ "$default" = "$(trim "$display")" ]&&default="$num"||true
fi
printf "  %0${length}d) $(trim "${display:-$key}")\n" "$num" >/dev/tty
done <<<"$list"
[ -z "$default" ]||is_integer "$default"||die "Default option $default not recognized."
[ -z "$end" ]||printf "  %${length}s) $end\n" x >/dev/tty
if ((length==1));then
pattern="[1-$max]"
elif ((length==2));then
pattern="0[1-9]?|"
((${max:0:1}==1))||pattern+="[1-$((${max:0:1}-1))][0-9]?|"
pattern+="${max:0:1}[0-${max:1:1}]?"
elif ((length==3));then
pattern="0(0[1-9]?)?|0([1-9][0-9]?)?|"
((${max:0:1}==1))||pattern+="[1-$((${max:0:1}-1))]([0-9][0-9]?)?|"
pattern+="${max:0:1}([0-$((${max:1:1}-1))][0-9]?)?|"
pattern+="${max:0:1}(${max:1:1}[0-${max:3:1}]?)?"
else
pattern="[0-9]*"
fi
((length==1))||pattern="(0|$pattern)"
[ -z "$end" ]||pattern="(x|$pattern)"
pattern="^$pattern$"
local input="" char="" itext invalid
local countdown="$timeout"
local question="$(gettext "Select one of the above options")"
[ -z "$default" ]&&timeout=""||question="$question [$default]"
echo -n "$question: " >/dev/tty
stty -echo </dev/tty
while read -r -s -t 1 -n 1 char </dev/tty||rc=$?;do
if [ -n "$invalid" ];then
invalid=0
printf ' %.0s' {1..30} >/dev/tty
printf '\b%.0s' {1..30} >/dev/tty
fi
if ((rc==142));then
rc=0
if [ -n "$timeout" ];then
((countdown--))
if ((countdown>0));then
itext="  $(duration_format human "$countdown")     "
echo -ne "$itext$(printf '\b%.0s' $(seq 1 ${#itext}))" >/dev/tty
continue
fi
else
continue
fi
fi
if [[ $char == "" ]];then
if [ -n "$final" ];then
echo "          " >/dev/tty
break
elif [ -n "$input" ];then
echo "          " >/dev/tty
break
elif [ -n "$default" ];then
input="$default"
echo "          " >/dev/tty
break
else
itext="$(gettext 'value needed')"
echo -en "   $CC_RED$itext$CC_RESET$(printf '\b%.0s' $(seq 1 $((${#itext}+3))))" >/dev/tty
invalid=1
fi
elif [[ $char == $'\177' ]];then
if [ ${#input} -gt 0 ];then
input=${input:0:-1}
echo -ne "\b \b" >/dev/tty
fi
elif [[ $char == $'\033' ]];then
read -r -s -n 1 -t 0.01 seq
while [[ $seq == "[" || $seq =~ [0-9A-Za-z~] ]];do
read -r -s -n 1 -t 0.01 seq||break
done
elif [ -n "$end" ]&&[[ $char =~ [xX] ]];then
echo "$char" >/dev/tty
echo "exit"
stty echo </dev/tty
return 0
else
if [[ ! "$input$char" =~ $pattern ]];then
itext="$(gettext 'invalid character')"
echo -en "   $CC_RED$itext$CC_RESET$(printf '\b%.0s' $(seq 1 $((${#itext}+3))))" >/dev/tty
invalid=1
continue
fi
input+="$char"
echo -n "$char" >/dev/tty
if ((${#input}==length));then
echo >/dev/tty
break
fi
fi
done
stty echo </dev/tty
sed -n "${input}p" <<<"$list"|sed 's/\s*|.*//'
}
tasks(){
local end title _default opt loop
eval set -- "$(option_parse $'t title +\nd default +\nT timeout +\nl loop -' "$@")"
while true;do
case "$1" in
-t|--title)title="-t$2" >/dev/tty
shift 2
;;
-d|--default)_default="$2" >/dev/tty
shift 2
;;
-T|--timeout)opt="-T $2 " >/dev/tty
shift 2
;;
-l|--loop)loop=1
shift
;;
--)shift
break
;;
*)die "$(gettext "Unrecognized option"): $1"
esac
done
local raw list task num newlist cmd name
find /dev/shm -regex ".*/$0_tasks_[0-9]*" -mmin +60 -delete 2>/dev/null||true
newlist="$(mktemp -m "tasks_$$")"
raw="$(input_lines "$@"|grep -v '^[[:space:]]*#')"||true
while true;do
list="$raw"
while grep -qv '|' <<<"$list";do
: >"$newlist"
while IFS= read -r line;do
IFS='|' read -r cmd name <<<"$line"
if [ -n "$name" ];then
echo "$line" >>"$newlist"
else
$cmd </dev/null >>"$newlist"||die "$(gettext "Could not get task list from command"): $cmd"
fi
done <<<"$list"
list="$(sed '/^[[:space:]]*$/d' "$newlist")"
rm "$newlist"
if [ -z "$list" ];then
ok "$(gettext "No tasks found to be executed.")"
return
fi
done
_default="$(value_if_variable "$_default")"
task=$(choose "$title" -x "$(gettext "Exit")" $opt -d "$_default" <<<"$list")
debug "choosen $task"
[[ $task != "exit" ]]||break
local error
if ! eval "$task";then
error=$?
die "$(eval_gettext 'Got error $error running $task')"
fi
echo ""
[ -n "$loop" ]||break
done
}
declare -A _mattermost_cache
_mattermost_user(){
if [[ ! -v _mattermost_cache["__u"] ]];then
debug "GET mattermost/users/me"
_mattermost_cache["__u"]="$(curl -H "Authorization: Bearer $MATTERMOST_TOKEN" "$MATTERMOST_API"/users/me|jq '.id' -r)"||die "Could not find myself in mattermost!"
fi
echo "${_mattermost_cache["__u"]}"
}
_mattermost_team(){
if [[ ! -v _mattermost_cache["__t_$1"] ]];then
debug "GET mattermost/teams"
_mattermost_cache["__t_$1"]="$(curl -H "Authorization: Bearer $MATTERMOST_TOKEN" "$MATTERMOST_API"/teams|jq '.[] | select(.display_name == "'"$1"'") | .id' -r)"||die "Could not get ID of team $1 in mattermost!"
fi
[ -n "${_mattermost_cache["__t_$1"]}" ]||die "Team $1 does not exist in mattermost."
echo "${_mattermost_cache["__t_$1"]}"
}
_mattermost_channel(){
if [[ ! -v _mattermost_cache["channel_$1_$2"] ]];then
debug "GET mattermost/users/me/teams/<team-id>/channels"
_mattermost_cache["channel_$1_$2"]="$(curl -H "Authorization: Bearer $MATTERMOST_TOKEN" "$MATTERMOST_API"/users/me/teams/"$1"/channels|jq '.[] | select(.display_name == "'"$2"'") | .id' -r)"||die "Could not get ID of channel $1/$2 in mattermost!"
fi
[ -n "${_mattermost_cache["channel_$1_$2"]}" ]||die "Channel $2 does not exist in mattermost (team $1)"
echo "${_mattermost_cache["channel_$1_$2"]}"
}
_mattermost_channel_bypost(){
debug "GET mattermost/posts/<post-id>"
curl -H "Authorization: Bearer $MATTERMOST_TOKEN" "$MATTERMOST_API"/posts/"$1"|jq '.channel_id' -r||die "Could not get channel of post $1 in mattermost!"
}
_mattermost_post(){
local att=""
if [ -n "$3" ];then
[[ $3 == \[* ]]&&att="$3"||att="[$3]"
att=', "props": {"attachments": '"$att"'}'
fi
local json pid
json="$(jq -n --arg c "$1" --arg t "$2" '{ channel_id: $c, message: $t '"$att"' }')"
debug "POST mattermost/posts"
debug "JSON: $json" >&2
pid=$(curl -H "Authorization: Bearer $MATTERMOST_TOKEN" -H 'Content-Type: application/json' -X POST "$MATTERMOST_API"/posts -d "$json"|jq '.id' -r)||die "Couls not send new post to mattermost!"
debug "-> $pid"
echo "$1/$pid"
}
_mattermost_repost(){
local att=""
if [ -n "$4" ];then
[[ $4 == \[* ]]&&att="$4"||att="[$4]"
att=', "props": {"attachments": '"$att"'}'
fi
local json pid
json="$(jq -n --arg c "$1" --arg r "$2" --arg t "$3" '{ channel_id: $c, root_id: $r, message: $t '"$att"' }')"
debug "POST mattermost/posts"
debug "JSON: $json" >&2
pid=$(curl -H "Authorization: Bearer $MATTERMOST_TOKEN" -H 'Content-Type: application/json' -X POST "$MATTERMOST_API"/posts -d "$json"|jq '.id' -r)||die "Could not send repost to mattermost!"
echo "$1/$pid"
}
_mattermost_reaction(){
local json
json="$(jq -n --arg u "$(_mattermost_user)" --arg p "$1" --arg t "$2" '{ user_id: $u, post_id: $p, emoji_name: $t }')"
debug "POST mattermost/reactions"
curl -X POST -H "Authorization: Bearer $MATTERMOST_TOKEN" -H 'Content-Type: application/json' "$MATTERMOST_API"/reactions -d "$json" > \
/dev/null||die "Could not add reaction to mattermost post!"
}
_mattermost_delete(){
debug "DELETE mattermost/posts"
curl -H "Authorization: Bearer $MATTERMOST_TOKEN" -H 'Content-Type: application/json' -X DELETE "$MATTERMOST_API"/posts/"$1"||die "Could not send delete to mattermost!"
}
_mattermost_find_channels(){
id(){
local val
val=$(_mattermost_channel "$1" "$2")||exit 1
echo -n "$1/$val "
}
local channel=${1:-$server}
local divibib ekz result
divibib=$(_mattermost_team divibib)||exit 1
ekz=$(_mattermost_team ekz)||exit 1
result=""
shopt -s nocasematch
local missing=0 found team
shopt -s nocasematch
for team in divibib ekz;do
found=0
for ((i=0; i<${#MATTERMOST_CHANNEL_PATTERN[@]}; i+=3));do
[[ ${MATTERMOST_CHANNEL_PATTERN[i]} == "$team" ]]||continue
if [[ $channel =~ ${MATTERMOST_CHANNEL_PATTERN[i+1]} ]];then
if [[ ${MATTERMOST_CHANNEL_PATTERN[i+2]} != "-" ]];then
id "${!team}" "${MATTERMOST_CHANNEL_PATTERN[i+2]}"
found=1
else
((missing++))||true
fi
debug "Match Mattermost channel ${MATTERMOST_CHANNEL_PATTERN[i]} ${MATTERMOST_CHANNEL_PATTERN[i+1]} ${MATTERMOST_CHANNEL_PATTERN[i+2]}"
break
fi
done
if ((found>0));then
debug "search for links"
for ((i=0; i<${#MATTERMOST_LINK_PATTERN[@]}; i+=3));do
[[ ${MATTERMOST_LINK_PATTERN[i]} == "$team" ]]||continue
if [[ $channel =~ ${MATTERMOST_LINK_PATTERN[i+1]} ]];then
id "${!team}" "${MATTERMOST_LINK_PATTERN[i+2]}"
debug "Match Mattermost link ${MATTERMOST_LINK_PATTERN[i]} ${MATTERMOST_LINK_PATTERN[i+1]} ${MATTERMOST_LINK_PATTERN[i+2]}"
break
fi
done
fi
echo ""
done
shopt -u nocasematch
((missing<2))||die "Could not detect mattermost channel for $1"
shopt -s nocasematch
}
mattermost_post_ids=""
mattermost(){
if [ -z "$MATTERMOST_API" ]||[ -z "$MATTERMOST_TOKEN" ];then
debug "Disabled because MATTERMOST_API and MATTERMOST_TOKEN are not both set"
return 0
fi
install jq
local channels line main links link mainid postid result
channels="$(_mattermost_find_channels "$1")"||exit 1
while read -r line;do
[ -n "$line" ]||continue
read -r main links <<<"$line"
IFS="/" read -r _ channel <<<"$main"
mainid=$(_mattermost_post "$channel" "$2" "$3")
IFS="/" read -r _ post <<<"$mainid"
result="$result\n$mainid"
while IFS=" " read -r link;do
[ -n "$link" ]||continue
IFS="/" read -r _ channel <<<"$link"
postid=$(_mattermost_post "$channel" "https://mattermost.ekz.de/divibib/pl/$post")
result="$result $postid"
done <<<"$links"
done <<<"$channels"
mattermost_post_ids="${result:2}"
}
