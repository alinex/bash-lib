contains(){
_deprecated "use array <array-name> has <value>"
}
array(){
local cmd value
is set --name=array-name --die -- "$1"
is enum --name=command --allow="has indexof" --die --output=cmd -- "$2"
is set --name=value --die --output=value -- "$3"
is integer --name=arguments --max=3 --die -- $#
declare -n arr="$1"
case "$cmd" in
has)for e in "${arr[@]}"
do
[ ! "$e" = "$value" ]||return 0
done
return 1
;;
indexof)for i in "${!arr[@]}"
do
if [ "${arr[i]}" = "$value" ];then
printf '%s' "$i"
return 0
fi
done
return 1
esac
}
join(){
is integer --name=arguments --max=2 --die -- $#
is set --name=array-name --die -- "$1"
local -n array=$1
local sep="${2:-,}"
local joined="${array[0]}"
for element in "${array[@]:1}";do
joined+="$sep$element"
done
printf '%s' "$joined"
}
split(){
is integer --name=arguments --max=3 --die -- $#
is set --name=array-name --die -- "$2"
local string="$1"
local -n array=$2
local sep="${3:-,}"
IFS="$sep" read -ra array <<<"$string"
}
hash(){
local keyFormat="simple"
eval set -- "$(option_parse $'k key-format +' "$@")"
while true;do
case "$1" in
-k|--key-format)is enum --allow="simple base64" --output -- "$2"&&keyFormat="$2"&&shift 2;;
--)shift&&break;;
*)die "$(gettext "Unrecognized option"): $1"
esac
done
is integer --name=arguments --max=4 --die -- $#
is set --name=array-name --die -- "$1"
is enum --name=command --allow="set get unset has contains" --die -- "$2"
declare -n arr="$1"
local cmd="$2" key value="$4"
case $keyFormat in
base64)key="$(base64 -w0 <<<"$3")";;
simple)key="${3//[^a-zA-Z0-9_]/_}"
esac
case "$cmd" in
set)is set --name=key --die -- "$3"&&arr["$key"]="$value";;
get)is set --name=key --die -- "$3"&&printf '%s' "${arr["$key"]}";;
unset)is set --name=key --die -- "$3"&&unset 'arr[$key]';;
has)is set --name=key --die -- "$3"&&[[ -v arr["$key"] ]];;
contains)is set --name=value --die -- "$3"
for key in "${!arr[@]}";do
[[ ${arr["$key"]} != "$3" ]]||return 0
done
return 1
esac
}
