}
date_diff(){
is integer --name=arguments --max=2 --die -- $#
local start end
end="${2:-$(now)}"
is integer -- "$1"&&start="$1"||start=$(date -d "$1" +%s)||die "Date format '$1' not parsable!"
is integer -- "$end"||end=$(date -d "$end" +%s)||die "Date format '$2' not parsable!"
printf '%s' $((end-start))
}
date_format(){
is integer --name=arguments --max=2 --die -- $#
is set --name=format --die -- "$1"
local value format opt
case $1 in
iso)format="-Iseconds";;
iso-date)format="-I";;
zulu)opt="-u"&&format="+%Y-%m-%dT%H:%M:%SZ";;
sql)format="+%Y-%m-%d %H:%M:%S";;
unix)format="+%s";;
eu-date)format="+%Y-%m-%d";;
us-date)format="+%m/%d/%Y";;
human)format="$(gettext "+%A, %B %d, %Y at %H:%M:%S")";;
human-date)format="$(gettext "+%A, %B %d, %Y")";;
time)format="+%H:%M:%S";;
time-short)format="+%H:%M";;
*)format="+$1"
esac
value="${2-$(now)}"
is integer -- "$value"&&eval "date -d @$value '$format'"||eval "date -d \"$value\" $opt '$format'"||die "Date format '$value' not parsable!"
}
sleep_until(){
is integer --name=arguments --max=1 --die -- $#
is set --name=date --die -- "$1"
local secs
secs="$(date_diff "$(now)" "$1")"
((secs>0))||die "Date has to be in the future for sleep_until"
sleep "$secs"
}
duration_format(){
is integer --name=arguments --max=2 --die -- $#
is enum --name=format --allow="seconds minutes hours days human" --die -- "$1"
local value
is integer -- "$2"&&value="$2"||value="$(_parse_duration "$2")"
case $1 in
seconds)printf '%s' "$value";;
minutes)printf '%s' $((value/60));;
hours)printf '%s' $((value/3600));;
days)printf '%s' $((value/86400));;
human)_format_duration "$value"
esac
}
_parse_duration(){
local input="$1"
local total=0
local overall_sign=1
local value unit v_num
if [[ $input == -* ]];then
overall_sign=-1
input="${input#-}"
elif [[ $input == +* ]];then
overall_sign=1
input="${input#+}"
fi
while read -r value unit;do
if [[ $value =~ ^[+-] ]];then
v_num="$value"
else
v_num=$((overall_sign*value))
fi
case "$unit" in
''|s|sec|secs|second|seconds)total=$((total+v_num));;
m|min|mins|minute|minutes)total=$((total+v_num*60));;
h|hr|hrs|hour|hours)total=$((total+v_num*3600));;
d|day|days)total=$((total+v_num*86400));;
w|week|weeks)total=$((total+v_num*604800));;
*)printf "$(gettext 'Invalid duration unit'): %s\n" "$unit" >&2
return 1
esac
done < <(grep -Eo '[+-]?[0-9]+[[:alpha:]]*' <<<"$input"|sed -E 's/^([+-]?[0-9]+)([[:alpha:]]*)$/\1 \2/')
printf '%d\n' "$total"
}
_format_duration(){
local total="$1"
local sign=""
if ((total<0));then
sign="-"
total=$((-total))
fi
local w=$((total/604800))
local d=$((total/86400))
local h=$(((total%86400)/3600))
local m=$(((total%3600)/60))
local s=$((total%60))
local out=""
((w))&&out+="${w}w "
((d))&&out+="${d}d "
((h))&&out+="${h}h "
((m))&&out+="${m}m "
((s))&&out+="${s}s "
is empty -- "$out"&&out="0s"&&sign=""||true
printf '%s' "$sign${out% }"
}
_timer_start=0
timer(){
case $1 in
start)_timer_start=$(date +%s.%N)
;;
stop)local seconds nano len
IFS='.' read -r seconds nano < <(printf '%s' "$(date +%s.%N) - $_timer_start"|bc)
len=$((4-${#seconds}))
((len>=0))||len=0
LANG=C printf "%0.${len}f\n" "$seconds.$nano"
debug "Measurement: $seconds.$nano"
;;
*)die "Command $1 undefined, use: start stop"
esac
}
