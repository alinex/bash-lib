### Users / SSH
######################################################################################

# Get information about user
#
# The sudo column will show: no, all, specified.
# Find more about the sudo rights using @sudo_info.
#
# Usage:    user_info [<user>]
# Output:   <tsv with header>
#           User UID  GID  Home       SuDo Login                     From    Duration
#           alex 1000 1000 /home/alex all  2026-01-13T07:01:09+01:00 0.0.0.0 still logged in
user_info() {
    local user home from login logout time uid gid shell sudo info
    getent passwd $1 | awk -F: '$3 >= 1000 && $3 < 60000 && $1 !~ /^snap_/ && $1 !~ /^(nobody|daemon|www-data|postgres|mysql|redis|git)/ {print $1}' | while IFS= read -r user; do
        IFS=: read -r _ _ uid gid _ home shell < <(getent passwd "$user")
        read -r _ _ from login logout < <(last -dw --time-format=iso -n 1 "$user")
        time="$(sed 's/.*(\|).*//g;s/+0\?/d /;s/:/h /;s/00/0/;s/\([0-9]\)$/\1m/' <<<"$logout")"

        info=$(LANG=C sudo -l -U "$user" 2>/dev/null)
        if grep -q "not allowed\|Sorry" <<<"$info" || [ -z "$info" ]; then
            sudo=no
        elif grep -q "(ALL.*ALL)" <<<"$info"; then
            sudo=all
        else
            sudo=specified
        fi
        # no output: $shell
        printf '%-20s\t' "$(gettext User)" "$(gettext UID)" "$(gettext GID)" "$(gettext Home)" "$(gettext SuDo)" "$(gettext Login)" "$(gettext From)" "$(gettext Duration)"
        printf '\n'
        printf '%-20s\t' "$user" "$uid" "$gid" "$home" "$sudo" "$login" "$from" "$time"
        printf '\n'
    done
}

# Get sudo information
#
# This lists all allowed sudo commands for the user.
#
# Usage:    sudo_info [<user>]
# Output:   <tsv with header>
#           username as UID as GID  command
#           alex     ALL            /usr/bin/openfortivpn
#           alex     ALL    ALL     ALL
sudo_info() {
    echo -e "username\tas UID\tas GID\tcommand"

    getent passwd $1 | awk -F: '$3 >= 1000 && $3 < 60000 {print $1}' |
        while IFS= read -r user; do
            LANG=C sudo -lU "$user" 2>/dev/null | sed '1,/User .* may run the following commands/d' |
                while read -r line; do
                    sed 's/(\([A-Z0-9]*\) *:\? *\([A-Z0-9]*\)\?) * \(NOPASSWD:\)\? */'"$user"'\t\1\t\2\t/' <<<"$line"
                done
        done
}

######################################################################################
### LVM
######################################################################################

# Check if LVM is used
#
# Usage:    uses_lvm
# Return:   0 for uses LVM
#           1 if not
uses_lvm() {
    is integer --name=arguments --max=0 --die -- $#
    sudo bash -lc 'command -v vgs' >/dev/null &&      # installed
        sudo vgs --noheadings >/dev/null &&           # vgs returns ok
        [ -n "$(sudo vgs --noheadings)" ] &>/dev/null # vgs returns at least one group
}
