#!/usr/bin/env bash

# Array helpers.

######################################################################################
### Array analyzing
######################################################################################

# Check if value is contained in array
# Usage:    contains <array-name> <match>
# Example:  x=( one two three )
#           contains x two && echo YES || echo NO
contains() {
    local -n array=$1
    local value=$2
    local e
    for e in "${array[@]}"; do
        [[ "$e" != "$value" ]] || return 0
    done
    return 1
}
