#!/usr/bin/env bash
# shellcheck source=base
source /dev/null

# Module for process control

######################################################################################
# Sudo
######################################################################################

# Check if sudo is needed for command
#
# This will @die if the user is not allowed to use `sudo`.
#
# Usage:    sudo_allow <command-line>
# Return:   0 if allowed
#           @die if not allowed
sudo_allow() {
    is integer --name=arguments --max=1 --die -- $#
    # processing
    ((EUID != 0)) || return 0
    command -v sudo >/dev/null || return 0
    command sudo -ln "$@" >/dev/null || die "User $(whoami) is not allowed to call 'sudo $*', but this is necessary!"
}

# Sudo overwrite to only use sudo if needed
#
# Usage:    sudo <command-line>
sudo() {
    if ((EUID != 0)) && command -v sudo >/dev/null; then
        command sudo "$@"
    else
        "$@"
    fi
}

######################################################################################
# Looping
######################################################################################

# Execute command in N times
#
# Usage:    repeat <N> <command> [<params>]...
repeat() {
    is integer --name=num --min=0 --die -- "$1"
    is set --name=command --die -- "$2"
    local -i n=$1
    # processing
    ((n > 0)) || return
    shift
    for n in $(seq "$n"); do
        debug 3 "call #$n: $*"
        "$@"
    done
}

# Retry a command multiple times until it succeeds
#
# Using escalating delay between attempts. Delay is 2 * n + random up to 30s, then 30s + random after that.
# For large numbers of retries the max delay is effectively the retry count in minutes.
#
# Usage:    retry <N> <command> [<params>]...
retry() {
    is integer --name=num --min=0 --die -- "$1"
    is set --name=command --die -- "$2"
    local retries=$1
    # processing
    shift
    local count=0 exit wait
    until "$@"; do
        exit=$?
        wait=$((2 ** count))
        count=$((count + 1))
        if ((count < retries)); then
            debug 3 "Try $count/$retries exited $exit, retrying in $wait seconds..."
            sleep "$wait"
        else
            debug 3 "Try $count/$retries exited $exit, no more retries left."
            return "$exit"
        fi
    done
    return 0
}

######################################################################################
# Locking
######################################################################################

LOCK_SLEEP=10

_lock_remove() {
    # Remove old locks for non existing processes or the defined pid lock
    # Usage: _lock_remove
    pid=$(cat "$lockfile") || true
    ([ -n "$pid" ] && kill -0 "$pid" 2>/dev/null) ||
        rm -f "$lockfile" "$lockfile.$pid" || die "$(gettext "Failed to remove lockfile"): $lockfile"
}

# Set a lock or wait till it can be set
#
# In any part of your script you can surround a block with @lock and @unlock statements. The
# process will wait on the lock statement till no other process with the same lock is running
# before going on.
#
# Usage:    lock
# Files:    /tmp/<prog>_lockfile        # hard link to active process
#           /tmp/<prog>_lockfile.<pid>  # active or waiting process
# Output:   <wait message>
lock() {
    is integer --name=arguments --max=0 --die -- $#
    local lockfile logged pid
    lockfile="$(mktemp 'lockfile')"
    # make a file with our PID
    # shellcheck disable=SC2059
    printf $$ >"$lockfile.$$" 2>/dev/null || die "$(gettext "Failed to create PID lockfile"): $lockfile.$$"
    # remove old lock if no longer running
    _lock_remove
    # try it, till it works
    logged=0
    while ! ln "$lockfile.$$" "$lockfile" 2>/dev/null; do
        if ((logged == 0)); then # write message once
            pid="$(cat "$lockfile")"
            printf '%s\n' "$(eval_gettext "Waiting for unlock in \$lockfile by PID \$pid")..." >&1
            logged=1
        fi
        # if the symlink failed, wait for the current lock holder to exit
        sleep "$LOCK_SLEEP"
        # make a file with our PID, if no longer existent
        # shellcheck disable=SC2059
        printf $$ >"$lockfile.$$" 2>/dev/null
        # check again for zombies
        _lock_remove
    done
    # if the locking process exits without unlocking, delete our lock
    trap add unlock EXIT
}

# Set the lock or exit with optional error message
#
# While another program is running with this lock active it will @die.
#
# Usage:    lock_exit
# Files:    /tmp/<prog>-lockfile        # hard link to active process
#           /tmp/<prog>-lockfile.<pid>  # active or waiting process
lock_exit() {
    is integer --name=arguments --max=0 --die -- $#
    local lockfile logged pid
    lockfile="$(mktemp 'lockfile')"
    # make a file with our PID
    # shellcheck disable=SC2059
    printf $$ >"$lockfile.$$" 2>/dev/null || die "$(gettext "Failed to create PID lockfile"): $lockfile.$$"
    # move old lock if no longer running
    _lock_remove
    # try to symlink it
    if ! ln "$lockfile.$$" "$lockfile" 2>/dev/null; then
        unlock
        pid="$(cat "$lockfile")"
        die "$(eval_gettext "Stop processing because this is locked in \$lockfile by PID $pid")"
    fi
    # if the locking process exits without unlocking, delete our lock
    trap_add unlock EXIT
}

# Remove the lock
#
# Usage:    unlock
# shellcheck disable=SC2120
unlock() {
    is integer --name=arguments --max=0 --die -- $#
    local lockfile
    lockfile="$(mktemp 'lockfile')"
    # remove own lockfile
    [ ! -e "$lockfile.$$" ] || rm -f "$lockfile.$$" 2>/dev/null
    # remove link if no pid or pointing to myself
    pid=$(cat "$lockfile") || true
    [ -z "$pid" ] || [[ "$pid" != "$$" ]] || rm -r "$lockfile" 2>/dev/null
    # remove the trap
    trap_remove unlock EXIT
    return 0
}

######################################################################################
# Persistent variables store
######################################################################################

# Store variables into shared memory/file
#
# The <ident> specifies also who will use the same file.
# To get the same file in all your invocations of this script only use a fixed string here.
# To have a different file for each script invocation include `$$` or '${$}'.
# Or to have another file in each sub process include $BASHPID.
#
# You may do the following:
#
# - `store` all or some variables
# - `restore` all or some variables
# - `clean` remove the store
# - `change` run a command which will change the variables in the store
#
# Usage:    variables store [<ident>] [<variable>]...   # store complete or only listed variables (ident can be empty string)
#           variables restore [<ident>] [<variable>]... # restore all or defined variables
#           variables clean [<ident>]                   # remove the store
#           variables update <ident> <cmd-line> [<variable>]..   # update some variables by the cmd-line
# Options:  d, disk                             # store on disk in temporary folder
#           p, path <base-dir>                  # store on disk in given folder
#           c, clean                            # remove after restore is done
# Files:    `/dev/shm/<prog>[-<ident>].env`     # stored environment
# Files:    `/tmp/<prog>[-<ident>].env`         # if `--disk` was used
# Example:  ```bash
#           variables restore
#           ...<code>
#           variables store # save changes
#           ....
#           variables store # save changes
#           ....
#           variables clean # everything done remove progress
#           ```
variables() {
    # parameter parsing
    eval set -- "$(option_parse $'d disk -\np path +\nc clean -' "$@")"
    local self opt="-m" command clean
    while true; do
        case "$1" in
        -d | --disk) self+=" -d" && opt="" && shift ;;
        -p | --path) self+=" -p \"$2\"" && opt="$1 $2" && shift 2 ;;
        -c | --clean) self+=" -c" && clean=1 && shift ;;
        --) shift && break ;;
        *) shift ;; # ignore
        esac
    done
    is enum --name=command --allow="store restore clean change" --die --output=command -- "$1"
    shift
    local ident=$1
    shift || true
    # processing
    local file
    # shellcheck disable=SC2086
    file="$(mktemp $opt --extension=env "$ident")"
    case "$command" in
    store) declare -p "$@" | sed 's/^declare\b/declare -g/' >"$file" ;;
    restore)
        [ -s "$file" ] || return 0
        if [[ $# -gt 0 ]]; then
            temp="$(mktemp -me env-sub "${ident}_${BASHPID}")"
            grep -E "$(tr ' ' '|' <<<"$*")" "$file" >"$temp" || true
            # shellcheck disable=SC1090
            source "$temp" || true
            rm -r "$temp" || true
        else
            # shellcheck disable=SC1090
            source "$file" 2>/dev/null || true
        fi
        [ -z "$clean" ] || rm -f "$file" # also directly clean it
        ;;
    clean) rm -f "$file" ;;
    change)
        is set --name=cmd-line --die -- "$1"
        # processing
        local command=$1
        shift || true
        # shellcheck disable=SC2086
        variables restore $self "$ident"
        eval "$command"
        # shellcheck disable=SC2086
        variables store $self "$ident" "$@"
        ;;
    esac
}

######################################################################################
# Sync/Async calls with optional step control
######################################################################################

declare -A _async_running

# Set the variables which should be stored with step control
STEPS_VARIABLES=
_STEPS_NAME=

# Step control allows jobs to resume on another run.
#
# After starting step control this will be used in @sync, @async and @queue.
#
# Usage:    steps init [<name>]     # to start step control
#           steps end               # to end step control
steps() {
    is enum --allow="init end" --die -- "$1"
    case $1 in
    init)
        is integer --name=arguments --max=2 --die -- $#
        _STEPS_NAME=${2:-all}
        debug "start step control"
        declare -g -A _STEPS
        variables restore "steps_${_STEPS_NAME}"
        # shellcheck disable=SC2086
        variables store "steps_${_STEPS_NAME}" _STEPS $STEPS_VARIABLES # initial store
        printf '%s\n' "$(gettext "Work steps are logged so that you can resume work mid-process")..." >&2
        ;;
    end)
        is integer --name=arguments --max=1 --die -- $#
        debug "end step control"
        _steps_done
        ;;
    esac
}

# Check if step already finished successful
#
# Usage:    steps_check <name>
# Exit:     0 if done else not done or with failure
_steps_check() {
    local name="$1"
    is set --name=name --die -- "$1"
    is integer --name=arguments --max=2 --die -- $#
    # processing
    is set -- "$_STEPS_NAME" || return 1 # return not found if no step control
    [ -n "${_STEPS["$name"]}" ] && return 0 || return 1
}

# Set step as successfully done
#
# Usage:    steps_done <name>   # finished one step
#           steps_done          # completely finished -> cleanup
_steps_done() {
    is integer --name=arguments --max=2 --die -- $#
    # processing
    is set -- "$_STEPS_NAME" || return 0 # do nothing if no step control
    if [ -n "$1" ]; then
        _STEPS["$1"]=1
        # shellcheck disable=SC2086
        variables store "steps_${_STEPS_NAME}" _STEPS $STEPS_VARIABLES
    else
        variables clean "steps_${_STEPS_NAME}"
        _STEPS_NAME=""
    fi
}

# Run the given command with optional step control
#
# The command and arguments given will be called like directly run. But if @steps is started it will check if already done.
# Further in `--verbose` mode a message for start and end will be printed on STDERR with the command or the given `--name`.
#
# Usage:    sync [<options>] <command> [<params>...]
# Options:  v, verbose           # display notice/info message
#           n, name=<string>     # define name or use command with args
# Stderr:   - notice message for start (in verbose mode)
#           - info message for finish (in verbose mode)
sync() {
    # parameter parsing
    eval set -- "$(option_parse $'+n name +\nv verbose -' "$@")"
    local name verbose message
    while true; do
        case "$1" in
        -n | --name) is set --name=name --die --output=name -- "$2" && shift 2 ;;
        --verbose) verbose=1 && shift ;;
        --) shift && break ;;
        *) die "$(gettext "Unrecognized option"): $1" ;;
        esac
    done
    is integer --name=arguments --min=1 --die -- $#
    [ -n "$name" ] || name="$*"
    # processing
    if _steps_check "$name"; then
        message="$(eval_gettext 'Skip: $name (already done)')"
        is set -- "$verbose" && warn "$message" >&2 || debug "$message"
        return
    fi
    message="$(eval_gettext 'Start: $name')"
    is set -- "$verbose" && notice "$message" >&2 || debug "$message"
    "$@"
    message="$(eval_gettext 'Finished: $name')"
    is set -- "$verbose" && info "$message" >&2 || debug "$message"
    _steps_done "$name" "$verbose"
}

# Run the given command asynchronous ang go on in the calling routine
#
# While this command runs you may start more @async commands and use @async_wait to wait for a specific one to end or all to end.
#
# The command and arguments given will be called like directly run. But if @steps is started it will check if already done.
# Further in `--verbose` mode a message for start and end will be printed on STDERR with the command or the given `--name`.
#
# Usage:    async [<options>] <command> [<params>...]
#           async [<options>] wait [<command> [<params>...]]
# Options:  v, verbose           # display notice/info message
#           n, name=<string>     # define name or use command with args
# Stderr:   - notice message for start (in verbose mode)
#           - info message for finish (in verbose mode)
# Example:  ```bash
#           async task1
#           async task2
#           async wait task1
#           async task3
#           wait # for all to end
#           ```
async() {
    # parameter parsing
    eval set -- "$(option_parse $'+n name +\nv verbose -' "$@")"
    local name verbose message
    while true; do
        case "$1" in
        -n | --name) is set --name=name --die --output=name -- "$2" && shift 2 ;;
        --verbose) verbose=1 && shift ;;
        --) shift && break ;;
        *) die "$(gettext "Unrecognized option"): $1" ;;
        esac
    done
    is integer --name=arguments --min=1 --die -- $#
    [ -n "$name" ] || name="$*"
    # detect finished ones and wait for it
    _async_done
    if [ "$1" = "wait" ]; then
        local pid
        if [ "$name" = "wait" ]; then
            for name in "${!_async_running[@]}"; do
                hash _async_running has "$name" || continue
                IFS=$'\t' read pid _ <<<"$(hash _async_running get "$name")"
                wait "$pid" || true
                _async_done
            done
        else
            hash _async_running has "$name" || return 0
            IFS=$'\t' read pid _ <<<"$(hash _async_running get "$name")"
            wait "$pid" || true
            _async_done
        fi
        return 0
    fi
    # processing
    if _steps_check "$name"; then
        message="$(eval_gettext 'Skip: $name (already done)')"
        is set -- "$verbose" && warn "$message" >&2 || debug "$message"
        return
    fi
    message="$(eval_gettext 'Start: $name')"
    is set -- "$verbose" && notice "$message" >&2 || debug "$message"
    "$@" &
    hash _async_running set "$name" $!$'\t'"$verbose"
}

_async_done() {
    local check pid verbose
    for check in "${!_async_running[@]}"; do
        IFS=$'\t' read -r pid verbose <<<"${_async_running[$check]}"
        if ! kill -0 "$pid" 2>/dev/null; then
            message="$(eval_gettext 'Finished: $check')"
            is set -- "$verbose" && info "$message" >&2 || debug "$message"
            hash _async_running unset "$check"
        fi
    done
}

######################################################################################
# Job Queue
######################################################################################

# Maximum number of parallel tasks for queue
QUEUE_MAX_PARALLEL=10
# Percentage of 1 Minute Load per CPU (100% 8Cpu => 8.0)
QUEUE_MAX_LOAD=75

_queue_jobs=()
declare -A _queue_running

# Run bash commands parallel with limits from a queue.
#
# The queue first collects all jobs and then you execute them all in parallel. Therefore you can give a max number of parallel calls and a max percentage load limit for then to start the next job.
# You may also set the limits using environment $QUEUE_MAX_PARALLEL and $QUEUE_MAX_LOAD.
# If the server is over the configured load limit one job will always run, but parallel execution will only start if possible.
#
# Usage:    queue [<options>] add <job> [<args>...]             # add job to queue
#           queue [--progress] run [<parallel>] [<load-percent>] # run the queue with specified limits
# Options:  v, verbose           # display notice/info message
#           n, name=<string>     # define name or use command with args
#           p, progress          # show progress
# Stderr:   - notice message for start (in verbose mode)
#           - info message for finish (in verbose mode)
#           - info with progress of queue
queue() {
    eval set -- "$(option_parse $'+n name +\nv verbose -' "$@")"
    local name verbose=0 message progress
    while true; do
        case "$1" in
        -n | --name) is set --name=name --die --output=name -- "$2" && shift 2 ;;
        --verbose) verbose=1 && shift ;;
        --progress) progress=1 && shift ;;
        --) shift && break ;;
        *) die "$(gettext "Unrecognized option"): $1" ;;
        esac
    done
    is enum --name=command --allow="add run" --die -- "$1" && local command="$1" && shift
    [ -n "$name" ] || name="$*"
    # processing
    case $command in
    add)
        is set --name=job --die -- "$1"
        if _steps_check "$name"; then
            message="$(eval_gettext 'Skip: $name (already done)')"
            is set -- "$verbose" && warn "$message" >&2 || debug "$message"
            return
        fi
        message="$(eval_gettext 'Queue: $name')"
        is true -- "$verbose" && info "$message" >&2 || debug "$message"
        _queue_jobs+=("$(printf '%s\t%s\t%s' "$name" "$verbose" "$*")")
        ;;
    run)
        is empty -- "$1" || is integer --name=parallel --min 1 --die "$1"
        is empty -- "$2" || is integer --name=load-percent --min 1 --die "$2"
        local max="${1:-$QUEUE_MAX_PARALLEL}"
        local load="${2:-$QUEUE_MAX_LOAD}"
        local job total=${#_queue_jobs[@]} started=0
        debug "$total Jobs to be run..."
        while true; do
            # check for finished jobs
            for pid in "${!_queue_running[@]}"; do
                if [[ ! -d /proc/$pid ]]; then
                    IFS=$'\t' read -r name verbose <<<"${_queue_running[$pid]}"
                    _steps_done "$name"
                    message="$(eval_gettext 'Finished: $name')"
                    is true -- "$verbose" && info "$message" >&2 || debug "$message"
                    unset "_queue_running[$pid]"
                fi
            done
            # check if possible to run (nothing is running or below limit)
            if ((${#_queue_running[@]} == 0)) ||
                ( ((${#_queue_running[@]} < max)) &&
                    (($(cut -d' ' -f1 /proc/loadavg | sed 's/\.//;s/^0*//') / $(nproc) < load))); then
                # get next job
                if ((${#_queue_jobs[@]} > 0)); then
                    IFS=$'\t' read -r name verbose job <<<"${_queue_jobs[0]}"
                    _queue_jobs=("${_queue_jobs[@]:1}") # remove first
                    # run job
                    message="$(eval_gettext 'Start: $name')"
                    is true -- "$verbose" && notice "$message" >&2 || debug "$message"
                    eval "$job" &
                    ((started++)) || true
                    is empty -- "$progress" || info "$(eval_gettext 'Queued $started/$total jobs')"
                    _queue_running[$!]="$name"$'\t'"$verbose"
                # end if no new jobs and nothing running
                elif ((${#_queue_running[@]} == 0)); then
                    break
                else
                    sleep 1
                fi
            else
                debug "Limit reached: Running ${#_queue_running[@]} (max), Load: $(($(cut -d' ' -f1 /proc/loadavg | sed 's/\.//;s/^0*//') / $(nproc)))% (max $load%)"
                sleep 1
            fi
        done
        ;;
    esac
}

######################################################################################
# Random string
######################################################################################

# Return a random string in specific length
#
# The default length is 16.
#
# The `<pattern>` is a list of allowed characters in range:
#
# - num - `0-9`
# - letters - 'a-z'
# - LETTERS - 'A-Z'
# - alpha - `a-zA-Z`
# - alphanum - `a-zA-Z0-9`
# - base64 - `a-zA-Z0-9+/`
# - printable - `a-zA-Z0-9!@#$%^&*()-_=+[](){}|;:,.<>?/` (in german including umlaut)
# - hex - `0-9a-f`
# - HEX - `0-9A-F`
# - directly give pattern
#
# Usage:    random <pattern> [<length>]
random() {
    is integer --name=arguments --max=2 --die -- $#
    is set --name=pattern --die -- "$1"
    is set -- "$2" && is integer --name=length --min=0 --die -- "$2"
    local pattern="$1"
    local length=${2:-16}
    # processing
    local result=""
    local umlaut UMLAUT
    if [[ "$LANG" =~ ^de ]]; then
        umlaut="äöüß€"
        UMLAUT="ÄÖÜ"
    fi
    case $pattern in
    num) pattern="0-9" ;;
    letters) pattern="a-z" ;;
    LETTERS) pattern="A-Z" ;;
    alpha) pattern="a-zA-Z" ;;
    alphanum) pattern="a-zA-Z0-9" ;;
    base64) pattern="a-zA-Z0-9+/" ;;
    printable) pattern="a-zA-Z0-9!@#$%^&*()-_=+[](){}|;:,.<>?/$umlaut$UMLAUT" ;;
    hex) pattern="0-9a-f" ;;
    HEX) pattern="0-9A-F" ;;
    esac
    while ((${#result} < length)); do
        result+="$(head /dev/urandom | tr -dc "$pattern")"
    done
    printf '%s' "${result:0:$length}"
}

######################################################################################
# OS Process
######################################################################################

# Process control
#
# This function will work on the main pid for the matching process groups:
#
# - if a <pid> is given the top parent of this is used
# - if a name is given matching process groups in name or path are searched and their top parents are used
#
# Usage:    process info <pid>|<string>     # show summary for all matching processes
#           process list <pid>|<string>     # show list of process groups (one summary per group) as tsv
#           process tree <pid>|<string>     # show process trees
#           process wait [<options>] <pid>|<string>
#           process kill <pid>|<string> [<signal>]
# Options:  w, watch        # (for wait) watch health status till done
#           t, timeout      # (for wait) end with
# Output:   - info: human readable line
#           - list/tree: tsv with header
process() {
    local command watch timeout
    # parameter parsing
    eval set -- "$(option_parse $'t timeout +\nw watch -' "$@")"
    while true; do
        case "$1" in
        -t | --timeout) is duration --name=timeout --die --output=timeout -- "$2" && shift 2 ;;
        -w | --watch) watch=1 && shift ;;
        --) shift && break ;;
        *) die "$(gettext "Unrecognized option"): $1" ;;
        esac
    done
    # processing
    is enum --allow="info list tree wait kill" --die --output=command -- "$1"
    is set --name=process-id-or-name --die -- "$2"
    is integer --name=arguments --max=3 --die -- $#
    # get pid
    local list
    if is integer -- "$2"; then
        local pid="$2"
        kill -0 "$2" >/dev/null || die "$(eval_gettext 'No process with pid $pid')"
        list=("$2")
    else
        mapfile -t list < <(pgrep "$2" | _process_main_pid | sort -nu || true)
        # shellcheck disable=SC2128
        [ -n "$list" ] || mapfile -t list < <(pgrep -f "$2" | _process_main_pid | sort -nu || true)
        # shellcheck disable=SC2128
        local search="$2"
        [ -n "$list" ] || die "$(eval_gettext 'No processes found for $search')"
    fi
    debug "pids: ${list[*]}"
    # processing
    case $command in
    info)
        local pid comm tree_pid
        for pid in "${list[@]}"; do
            [ -n "$comm" ] || comm="$(_process_name "$pid")"
            # shellcheck disable=SC2207
            tree_pid+=($(_process_children "$pid"))
            tree_pid+=("$pid") # Include root PID
        done
        printf '%s' "$comm"
        #echo "> ${#tree_pid[@]}"
        ps -o pcpu,rss --no-headers -p "$(IFS=, echo "${tree_pid[*]}")" |
            awk '{ cpu+=$1; mem+=$2; count++ } END { printf " %.2f%% CPU %.2f MB in %d processes\n", cpu, mem/1024, count }' || true
        ;;
    list)
        local pid tree_pid
        printf '%s\t%s\t%s\t%s\t%s\n' Command PID 'CPU %' 'RSS MB' Processes
        for pid in "${list[@]}"; do
            printf '%s\t%s' "$(_process_name "$pid")" "$pid"
            # shellcheck disable=SC2207
            tree_pid=($(_process_children "$pid"))
            tree_pid+=("$pid") # Include root PID
            ps -o pcpu,rss --no-headers -p "$(IFS=, echo "${tree_pid[*]}")" |
                awk '{ cpu+=$1; mem+=$2; count++ } END { printf "\t%.2f\t%.2f\t%d\n", cpu, mem/1024, count }' || true
        done
        ;;
    tree)
        local pid
        printf '%s\t%s\t%s\t%s\n' Command PID 'CPU %' 'RSS kB'
        for pid in "${list[@]}"; do
            _process_tree "$pid"
        done
        ;;
    wait)
        local pid
        start="$(date +%s)"
        for pid in "${list[@]}"; do
            while kill -0 "$pid" 2>/dev/null; do
                if [ -n "$watch" ]; then
                    local pcpu
                    pcpu="$(trim "$(ps -o pcpu= -p "$pid")")" || true
                    printf "$CURSOR_POS1$CLEAR_LINE%s" "$(eval_gettext 'Waiting for $pid ($pcpu% CPU)')"
                fi
                if [ -n "$timeout" ] && (($(date +%s) - start > timeout)); then
                    printf "$CURSOR_POS1$CLEAR_LINE"
                    warn "$(eval_gettext 'Timeout after ${timeout}s')"
                    return 1
                fi
                sleep 0.1
            done
        done
        printf "$CURSOR_POS1$CLEAR_LINE"
        ;;
    kill)
        local pid signal="${3:-SIGTERM}"
        for pid in "${list[@]}"; do
            debug "kill -s $signal $pid"
            kill -s "$signal" "$pid" 2>/dev/null || true
        done
        ;;
    esac
}

# Usage:    _process_name <pid>
_process_name() {
    ps -o args= -p "$1" | cut -d' ' -f1 | xargs basename
}
# Usage:    <pids> | _process_main_pid
_process_main_pid() {
    local pid current
    while read -r pid; do
        current="$pid"
        while true; do
            parent="$(trim "$(ps -o ppid= -p "$current" 2>/dev/null)" || true)"
            if [[ -z "$parent" || "$parent" == "1" ]] || grep -Fxq "$(_process_name "$parent")" <<<"plasmashell"; then
                echo "$current"
                break
            else
                current="$parent"
            fi
        done
    done
}
# Usage:    _process_children <pid>
_process_children() {
    local children child
    children=$(pgrep -P "$1" || true)
    for child in $children; do
        echo "$child"
        _process_children "$child"
    done
}
# Usage_    _process_tree <pid> <indent>
_process_tree() {
    local pcpu rss children child
    read -r pcpu rss < <(ps -o pcpu,rss --no-headers -p "$1")
    printf '%s%s\t%s\t%s\t%s\n' "$2" "$(_process_name "$1")" "$1" "$pcpu" "$rss"
    children=$(pgrep -P "$1" || true)
    for child in $children; do
        _process_tree "$child" "$2  "
    done

}
