#!/usr/bin/env bash
# shellcheck source=base
source /dev/null

# File and directory helpers.

######################################################################################
### Path
######################################################################################

# Strip directory from filepath
# This is a much faster implementation as the basename command because it is using shell parameter expansion.
# It will remove the directory and output only the filename.
# Usage:    basename <path>
#           <path> | basename
# Output:   `<file>`
basename() {
    is integer --name=arguments --max=1 --die -- $#
    # processing
    local path
    path="$(input "$@")"
    path="${path%/}"
    echo "${path##*/}"
}

# Strip last component from file path
# This is a much faster implementation as the dirname command because it is using shell parameter expansion.
# It will remove the last element in path.
# Usage:    dirname <path>
#           <path> | dirname
# Output:   `<base-path>`
dirname() {
    is integer --name=arguments --max=1 --die -- $#
    # processing
    local path
    path="$(input "$@")"
    [[ $path == '/' ]] && echo '/' && return 0
    [[ $path =~ ^'../' ]] && echo '.' && return 0
    [[ ! $path =~ / ]] && echo '.' && return 0
    echo "${path%/*}"
}

# Returns the extension of the path
# From the last occurrence of the . (period) character to end of string in the last portion of the path. If there is no . in the last portion of the path, or if the first character of the basename of path (see path.basename()) is ., then an empty string is returned.
# Usage:    extname <path>
#           <path> | extname
# Output:   `<extension>`
extname() {
    is integer --name=arguments --max=1 --die -- $#
    # processing
    local path
    path="$(input "$@")"
    [[ $path =~ ^\. ]] && echo '' && return
    [[ ! $path =~ \. ]] && echo '' && return
    echo ".${path##*.}"
}

# Get the path from the called command
# Usage:    script_path
# Output:   full real directory path to script
script_path() {
    is integer --name=arguments --max=0 --die -- $#
    # processing
    dirname "$(readlink -f "${BASH_SOURCE[-1]:-$(pwd)/x}")"
}
