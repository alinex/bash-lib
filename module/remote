_module_resolve() {
    local modules=()
    split "$1" modules ,
    local init=1 module line
    for module in "${modules[@]}"; do
        [[ "$module" =~ ^(full|base|.*/.*)$ ]] || module="module/$module"
        [ -n "$init" ] && init= || echo -n ,
        echo -n "$module"
        while read -r line; do
            echo -n ",$(_module_resolve "$line")"
        done < <(grep '^use ' "$BASHLIB_HOME/$module" | sed 's/^use //' || true)
    done
}

# Deprected: Run bashlib command on remote.
# The `modules` are a comma separated list of module names like network os.
# The modules can be:
# - `base` or `full` as first element
# - `module/<name>` to load the named module (if not full is used)
# - `extra/<name>` to load an extra module
# - `configs` to also transfer all the configurations
# - `config/<name>` to load only one config
# - any other name will be interpreted as `module/<name>` (short form)
# Usage:    remote_bashlib [<options>] <module>[,<module>...] <command> [<args>...]
#           <command> [<args>...] | remote_bashlib [<options>] <module>[,<module>...]
# Options:  # following options, only before `<module>`
#           -l, --login <user>
#           -h, --host <host>
#           -j, --jump <user>@<host>
# Globals:  $server
#           $login - default is "operator"
# Examples: IP="$(remote_bashlib ip ip_intern)"
remote_bashlib() {
    # parameter parsing
    local opt
    eval set -- "$(option_parse $'+l login +\nh host +\nj jump +' "$@")"
    while true; do
        case "$1" in
        -l | --login | -h | --host | -j | --jump)
            opt+=" $1 $2"
            shift 2
            ;;
        --)
            shift
            break
            ;;
        *) die "$(gettext "Unrecognized option"): $1" ;;
        esac
    done
    # processing
    local list modules
    list="$(_module_resolve "${1-}")"
    IFS=',' read -ra modules <<<"$list"
    debug "Modules: ${modules[*]}"
    shift
    local pattern='^#!/usr/bin/env'" bash|source "'/dev/null'
    # shellcheck disable=SC2086
    (
        echo "#!/usr/bin/env" bash
        echo "DEBUG=${DEBUG:-}"
        echo "BASHLIB_LOADER=remote"
        # load base
        if [[ "${modules[0]}" =~ ^(full|base)$ ]]; then
            grep -Ev "$pattern" "$BASHLIB_HOME/${modules[0]}"
            modules=("${modules[@]:1}")
        else
            grep -Ev "$pattern" "$BASHLIB_HOME"/base
        fi
        # load modules
        for module in "${modules[@]}"; do
            if [ "$module" = "configs" ]; then
                for f in "$BASHLIB_HOME"/config/*; do
                    if [[ -f "$f" && "$f" != *.* ]]; then
                        grep -Ev "$pattern" "$f"
                    fi
                done
            else
                grep -Ev "$pattern" "$BASHLIB_HOME/$module"
            fi
        done
        (($# == 0)) || debug "Running: $*"
        (($# == 0)) || escape_args "$@"
        [ ! -p /dev/stdin ] || debug "Running piped command!"
        [ ! -p /dev/stdin ] || cat </dev/stdin
    ) | shfmt -mn | remote $opt
}

