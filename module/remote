#!/usr/bin/env bash

# Module with remote calling/execution helpers.

# load other modules if not already done
declare -F "num_parameters" || source $BASHLIB_HOME/module/validator

######################################################################################
# Remote SSH
######################################################################################

# Run command on remote host
# Usage:    remote <command>... # special characters in command masked with backslash
#           #                     <special char> := | & * > < $
#           <commands> | remote
# Globals:  $server
#           $login - default is "operator"
# Output:   passed through
remote() {
    local ssh="${slogin:-operator}@${server}"
    if [ -p /dev/stdin ]; then
        ssh $ssh bash -s
        return ${PIPESTATUS[0]}
    else
        # this allows interactivity
        ssh $ssh "$@"
        return ${PIPESTATUS[0]}
    fi
}

# Run remote command with pseudo terminal
# \r\n my be contained, remove with nocr
# "Connection ... closed" in stderr: remove using: 2> >(grep -v '^Connection to .* closed\.' >&2)
# Usage:    remote <command>... # special characters have to be masked: | & * > <
#           <title> | remote
# Globals:  $server
#           $login - default is "operator"
# Output:   passed through
remote_term() {
    local ssh="${slogin:-operator}@${server}"
    if [ -p /dev/stdin ]; then
        ssh -t $ssh bash -s
        return ${PIPESTATUS[0]}
    else
        # this allows interactivity
        ssh -t $ssh "$@"
        return ${PIPESTATUS[0]}
    fi
}

# Run remote command with pseudo terminal but line based output (problematic with questions)
# Usage:    remote <command>... # special characters have to be masked: | & * > <
#           <title> | remote
# Globals:  $server
#           $login - default is "operator"
# Output:   passed through
remote_term_line() {
    local ssh="${slogin:-operator}@${server}"
    if [ -p /dev/stdin ]; then
        ssh -t $ssh bash -s 2> >(grep -v '^Connection to .* closed\.' >&2) | nocr
        return ${PIPESTATUS[0]}
    else
        # this allows interactivity
        ssh -t $ssh "$@" 2> >(grep -v '^Connection to .* closed\.' >&2) | nocr
        return ${PIPESTATUS[0]}
    fi
}
# STDERR_CLEANUP="2> >(grep -v '^Connection to .* closed\.' >&2)"

# Run local script on remote
# Usage:    remote_file <file>
#           <file> | remote_file
# Globals:  $server
#           $login - default is "operator"
# Output:   passed through
remote_file() {
    local file
    file="$(input "$@")"
    test "${file:0:1}" = "/" || file="$(path)/$file"
    test -f "$file" || die "No file to execute remotely under $file"
    local ssh="${slogin:-operator}@${server}"
    ssh $ssh 'bash -s' <$file
}

# Upload file
# Usage:    upload <source> <dest>
# Globals:  $server
#           $login - default is "operator"
upload() {
    local ssh="${slogin:-operator}@${server}"
    local dir=${2:-~}
    rsync -av "$1" "$ssh:$dir"
}

# Download file
# Usage:    download <source> <dest>
# Globals:  $server
#           $login - default is "operator"
download() {
    local ssh="${slogin:-operator}@${server}"
    local dir=${2:-.}
    rsync -av "$ssh:$1" "$dir"
}

