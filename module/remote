# Run command on remote host
# Usage:    remote [<options>] <command>... # special characters in command masked with backslash
#           # <special char> := | & * > < $
#           <commands> | remote [<options>]
# Options:  # following options, only before `<command>`
#           -l, --login <user>
#           -h, --host <host>
#           -j, --jump <user>@<host>
# Globals:  $server
#           $login - default is "operator"
# Output:   passed through
remote() {
    # parameter parsing
    local _login host jump
    eval set -- "$(option_parse $'+l login +\nh host +\nj jump +' "$@")"
    while true; do
        case "$1" in
        -l | --login)
            _login="$2"
            shift 2
            ;;
        -h | --host)
            host="$2"
            shift 2
            ;;
        -j | --jump)
            jump="$2"
            shift 2
            ;;
        --)
            shift
            break
            ;;
        *) die "$(gettext "Unrecognized option"): $1" ;;
        esac
    done
    # processing
    _login=${_login:-${login:-$REMOTE_LOGIN_DEFAULT}}
    host=${host:-$server}
    local ssh="${_login}@${host}"
    [ -z "$jump" ] || ssh="-J $jump $ssh"
    if [ -p /dev/stdin ] && (($# == 0)); then
        # shellcheck disable=SC2086
        ssh $ssh bash -s
        return "${PIPESTATUS[0]}"
    else
        # this allows interactivity
        # shellcheck disable=SC2086
        # shellcheck disable=SC2029
        ssh $ssh "$@"
        return "${PIPESTATUS[0]}"
    fi
}

# Run remote command with pseudo terminal
