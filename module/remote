# Run local script on remote
# Usage:    remote_file [<options>] <file>
#           <file> | remote_file [<options>]
# Options:  # following options, only before `<file>`
#           -l, --login <user>
#           -h, --host <host>
#           -j, --jump <user>@<host>
# Globals:  $server
#           $login - default is "operator"
# Output:   passed through
remote_file() {
    # parameter parsing
    local _login host jump
    eval set -- "$(option_parse $'+l login +\nh host +\nj jump +' "$@")"
    while true; do
        case "$1" in
        -l | --login)
            _login="$2"
            shift 2
            ;;
        -h | --host)
            host="$2"
            shift 2
            ;;
        -j | --jump)
            jump="$2"
            shift 2
            ;;
        --)
            shift
            break
            ;;
        *) die "$(gettext "Unrecognized option"): $1" ;;
        esac
    done
    # processing
    _login=${_login:-${login:-$REMOTE_LOGIN_DEFAULT}}
    host=${host:-$server}
    local ssh="${_login}@${host}"
    [ -z "$jump" ] || ssh="-J $jump $ssh"
    local file
    file="$(input "$@")"
    test "${file:0:1}" = "/" || file="$(path)/$file"
    test -f "$file" || die "$(eval_gettext "No file to execute remotely under \$file")"
    # shellcheck disable=SC2086
    ssh $ssh 'bash -s' <"$file"
}

# Open an interactive console on remote host
# The motd and banner are prevented by touching .hushlogin on the server.
# Usage:    remote_console [<options>]
# Options:  -l, --login <user>
#           -h, --host <host>
#           -j, --jump <user>@<host>
#           -A, --forward-agent     # use local ssh-agent also on remote host for authentication.
# Globals:  $server
#           $login - default is "operator"
# Output:   passed through
# Return:   passed through
remote_console() {
    # parameter parsing
    local _login host jump opt
    eval set -- "$(option_parse $'+l login +\nh host +\nj jump +\nA forward-agent -' "$@")"
    while true; do
        case "$1" in
        -l | --login)
            _login="$2"
            shift 2
            ;;
        -h | --host)
            host="$2"
            shift 2
            ;;
        -j | --jump)
            jump="$2"
            shift 2
            ;;
        -A | --forward-agent)
            opt="-A"
            shift
            ;;
        --)
            shift
            break
            ;;
        *) die "$(gettext "Unrecognized option"): $1" ;;
        esac
    done
    # processing
    num_parameters "$@" --min 2 --max 2 --die "Need exactly two parameters: semver_diff [-h] <first> <second>"
    _login=${_login:-${login:-$REMOTE_LOGIN_DEFAULT}}
    host=${host:-$server}
    local ssh="${_login}@${host}"
    [ -z "$jump" ] || ssh="-J $jump $ssh"
    local rc
    # shellcheck disable=SC2086
    ssh $ssh '(nohup touch .hushlogin && sleep 1 && rm .hushlogin) >/dev/null 2>&1 </dev/null &' # no banner
    # shellcheck disable=SC2086
    # shellcheck disable=SC2248
    ssh $opt $ssh </dev/tty || rc=$?
    return "$rc"
}

