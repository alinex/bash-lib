# Run local script on remote
# Usage:    remote_file <file>
#           <file> | remote_file
# Globals:  $server
#           $login - default is "operator"
# Output:   passed through
remote_file() {
    local file
    file="$(input "$@")"
    test "${file:0:1}" = "/" || file="$(path)/$file"
    test -f "$file" || die "$(eval_gettext "No file to execute remotely under \$file")"
    local ssh="${slogin:-operator}@${server}"
    ssh "$ssh" 'bash -s' <"$file"
}

# Open an interactive console on remote host
# The motd and banner are prevented by touching .hushlogin on the server.
# Usage:    remote_console
# Options:  -A, --forward-agent     # use local ssh-agent also on remote host for authentication.
# Globals:  $server
#           $login - default is "operator"
# Output:   passed through
# Return:   passed through
remote_console() {
    # parameter parsing
    eval set -- "$(option_parse "A forward-agent -" "$@")"
    local opt
    while true; do
        case "$1" in
        -A | --forward-agent)
            opt="-A"
            shift
            ;;
        --)
            shift
            break
            ;;
        *) die "$(gettext "Unrecognized option"): $1" ;;
        esac
    done
    num_parameters "$@" --min 2 --max 2 --die "Need exactly two parameters: semver_diff [-h] <first> <second>"
    # processing
    local rc
    local ssh="${slogin:-operator}@${server}"
    ssh "$ssh" '(nohup touch .hushlogin && sleep 1 && rm .hushlogin) >/dev/null 2>&1 </dev/null &' # no banner
    # shellcheck disable=SC2248
    # shellcheck disable=SC2029
    ssh $opt "$ssh" </dev/tty || rc=$?
    # shellcheck disable=SC2248
    return $rc
}

# Upload file
# Usage:    upload <source> <dest>
# Globals:  $server
#           $login - default is "operator"
upload() {
    local ssh="${slogin:-operator}@${server}"
    local dir=${2:-~}
    rsync -av "$1" "$ssh:$dir"
}

# Download file
# Usage:    download <source> <dest>
# Globals:  $server
#           $login - default is "operator"
download() {
    local ssh="${slogin:-operator}@${server}"
    local dir=${2:-.}
    rsync -av "$ssh:$1" "$dir"
}

