# Remote install package like @install
# Usage:    install <pack>...
# Globals:  $server
#           $login - default is "operator"
remote_install() {
    (
        cat $BASHLIB_BASE/1_color
        cat $BASHLIB_BASE/2_core
        cat $BASHLIB_BASE/software
        echo install "$@"
    ) | shfmt -mn | remote #> remote.sh
}

# Remote df with visual display
# The lines will be colorized based on $MOUNT_COLOR_LIMIT setting, which contains sets of 5 entries (pattern critical error warn ok). The first matching pattern will decide the color limits.
# Usage:    remote_df [<mount>...]                              # show table
#           remote_df <var> <operator> <limit%> [<mount>...]    # additionaly collect specific volumes
# Options:  -l, --local     # only list local devices
remote_df() {
    # parameter parsing
    local opt=""
    eval set -- "$(option_parse $'l locale -' "$@")"
    while true; do
        case "$1" in
        -l | --locale)
            opt="-l"
            shift
            ;;
        --)
            shift
            break
            ;;
        *) die "Unerwartete option in: $1" ;;
        esac
    done
    # collect specific limit
    if [ -n "$3" ] && is_integer "$3"; then
        declare -n ref="$1"
        local op="$2"
        local limit=$3
        shift 3
    fi
    # processing
    local firstline="" percent mount device limit_c limit_e limit_w limit_o
    # display
    IFS=$'\n'
    for line in $(remote df -h $opt -x tmpfs -x efivarfs -x devtmpfs -x squashfs "$@"); do
        if [ -z "$firstline" ]; then
            firstline=1
            invers $line
        else
            percent=$(echo $line | xargs echo | cut -d' ' -f5 | sed 's/%//')
            mount=$(echo $line | xargs echo | cut -d' ' -f6 | nocr)
            # get color limits
            device=$(echo $line | xargs echo | cut -d' ' -f1)
            for ((i = 0; i < ${#MOUNT_COLOR_LIMIT[@]}; i += 5)); do
                pattern="${MOUNT_COLOR_LIMIT[i]}"
                if [[ "$device" =~ $pattern ]]; then
                    limit_c="${MOUNT_COLOR_LIMIT[i + 1]}"
                    limit_e="${MOUNT_COLOR_LIMIT[i + 2]}"
                    limit_w="${MOUNT_COLOR_LIMIT[i + 3]}"
                    limit_o="${MOUNT_COLOR_LIMIT[i + 4]}"
                    break
                fi
            done
            # display
            if [ $percent -eq $limit_c ]; then
                critical "$line"
            elif [ $percent -ge $limit_e ]; then
                error "$line"
            elif [ $percent -ge $limit_w ]; then
                warn "$line"
            elif [ $percent -ge $limit_o ]; then
                ok "$line"
            else
                echo "$line"
            fi
            if [ -n "$limit" ] && compare $percent $op $limit; then
                ref="${ref}${mount} "
            fi
        fi
    done
    unset IFS
    echo ""
}

# Remote check if LVM is used
# Usage:    remote_lvm
# Return:   0 for uses LVM
#           1 if not
remote_lvm() {
    remote sudo vgs --noheadings \&\& [ -n "$(sudo vgs --noheadings 2>/dev/null)" ] &>/dev/null
}

# Wait till reboot is finished
# Usage:    boot_wait
# Options:  -q, --quiet
# Globals:  $server
#           $login - default is "operator"
# Error:    <sql-time>
boot_wait() {
    # parameter parsing
    eval set -- "$(option_parse $'q quiet -' "$@")"
    local quiet
    while true; do
        case "$1" in
        -q | --quiet)
            quiet=1
            shift
            ;;
        --)
            shift
            break
            ;;
        *) die "Unrecognized option: $1" ;;
        esac
    done
    # processing
    local uptime seconds=15
    echo -ne "Warten bis der Reboot fertig ist" >&2
    sleep $seconds
    while true; do
        [ -n "$quiet" ] || echo -ne "\rWarten bis der Reboot fertig ist ($seconds Sekunden)" >&2
        uptime=$(remote cut -d"' '" -f1 /proc/uptime 2>/dev/null | sed 's/[ .].*//')
        if [ -n "$uptime" ] && [ $uptime -lt 300 ]; then
            break
        else
            sleep 1
            ((seconds++))
        fi
    done
    [ -n "$quiet" ] || recho ""
    [ -n "$quiet" ] || remote uptime --since
}

######################################################################################
# Remote HTTP
######################################################################################

# Last HTTP return code from curl
CURL_HTTP_CODE=""

# Curl with added error handling
# Usage:    like curl
# Globals:  $server
#           $login - default is "operator"
#           CURL_HTTP_CODE set with last code
# Error:    <text> if not RC:2xx
# Return:   0 if RC:2xx
#           1 if not
curl() {
    local file res
    file=$(mkshm)
    res=$(command curl -s -w "Error: %{method} %{url_effective} with RC:%{http_code}" -o $file -L "$@")
    CURL_HTTP_CODE=${res:(-3)}
    if [[ "$rc" =~ ^2[0-9]{2}$ ]]; then
        cat $file
        rm $file
    else
        error "$res" >&2
        jq . $file >&2 2>/dev/null || cat $file >&2
        #cat $file
        rm $file
        return 1
    fi
}

######################################################################################
# Special Software
######################################################################################

# Run command on Mongo DB
# Usage:    mongosh "" <command>            # global command
#           mongosh <database> <command>    # work in database
# Global:   $server
#           $MONGO_ADMIN_USERPASS
mongosh() {
    num_parameters --min 2 --max 2 --die "Mongosh needs two parameters: Usage mongosh <database> <command>" "$@"
    local cluster
    cluster="$(echo $server | sed 's/^[^.]*\.//')"
    command mongosh "mongodb://${MONGO_ADMIN_USERPASS["$cluster"]}@$server:27017/$1" --eval "$2"
}
