#!/usr/bin/env bash
# shellcheck source=base
source /dev/null
# shellcheck source=config/environment
source /dev/null
# shellcheck source=config/secrets
source /dev/null

# Module with remote calling/execution helpers.

######################################################################################
# Remote SSH
######################################################################################

_module_resolve() {
    local modules=()
    split "$1" modules ,
    local init=1 module line
    for module in "${modules[@]}"; do
        [[ "$module" =~ ^(full|base|.*/.*)$ ]] || module="module/$module"
        [ -n "$init" ] && init= || printf ,
        printf '%s' "$module"
        while read -r line; do
            printf '%s' ",$(_module_resolve "$line")"
        done < <(grep '^use ' "$BASHLIB_HOME/$module" | sed 's/^use //' || true)
    done
}

# Run command on remote host.
#
# You can let it use the `$server` and `$login` variables or give it in the options.
#
# If you use a pseudo `--terminal`, `\r\n` may be contained in output, remove with @nocr.`
# This will also return "Connection ... closed" in stderr after done. Handle it or use the `--line-based` option, which will return output line by line (problematic on some interactive parts) but without the connection closed message an no `\r\\n`.
#
# If you run a `remote bashlib <modules> <command>` command the `modules` are a comma separated list of module names like network os.
# The modules can be:
#
# - `base` or `full` as first element
# - `module/<name>` to load the named module (if not full is used)
# - `extra/<name>` to load an extra module
# - `configs` to also transfer all the configurations
# - `config/<name>` to load only one config
# - any other name will be interpreted as `module/<name>` (short form)
#
# If you get something like `tput: No value for $TERM and no -T specified` then you should run the remote call with `remote --terminal`.
#
# Usage:    remote [<options>] <command>...     # special characters in command masked with backslash ( | & * > < $ )
#           <commands> | remote [<options>]     # pipe the command which prevents masking
#           remote [<options>] --file <file>    # run file content on remote host
#           remote [<options>] console          # open a remote console to the user
#           remote [<options>] bashlib <modules> <command>...         # run bashlib command on remote (no need to be installed)
# Options:  # following options, only before `<command>`
#           l, login <user>         # username for login
#           h, host <host>          # destination host
#           j, jump <user>@<host>   # to use a jump host before
#           t, terminal             # to use a pseudo terminal
#           line-based              # line based return for terminal
#           f, file                 # the command is a file reference which has to be used
# Globals:  $server
#           $login - default is "operator"
# Output:   passed through
# Return:   Error code from remote command
#           (255) will die because it is a connection problem
#           (143) will exit because it was from a SIGTERM on the remote
# Example:  &remote shows how to use it
remote() {
    # parameter parsing
    local _login host jump term lines file
    eval set -- "$(option_parse $'+l login +\nh host +\nj jump +\nt terminal -\n- line-based -\nf file -' "$@")"
    while true; do
        case "$1" in
        -l | --login) is set --name=login --die --output=_login -- "$2" && shift 2 ;;
        -h | --host) is set --name=host --die --output=host -- "$2" && shift 2 ;;
        -j | --jump) is set --name=jump --die --output=jump -- "$2" && shift 2 ;;
        -t | --terminal) term=1 && shift ;;
        --line-based) lines=1 && shift ;;
        -f | --file) file=1 && shift ;;
        --) shift && break ;;
        *) die "$(gettext "Unrecognized option"): $1" ;;
        esac
    done
    # processing
    _login=${_login:-${login:-$REMOTE_LOGIN_DEFAULT}}
    host=${host:-$server}
    local ssh="${_login}@${host}" rc=0
    [ -z "$jump" ] || ssh="-J $jump $ssh" # use a jump host
    [ -z "$term" ] || ssh="-t $ssh"       # add pseudo terminal
    if [ "$1" = "console" ]; then
        local rc
        # shellcheck disable=SC2086
        ssh $ssh '(nohup touch .hushlogin && sleep 1 && rm .hushlogin) >/dev/null 2>&1 </dev/null &' # no banner
        # shellcheck disable=SC2086
        # shellcheck disable=SC2248
        ssh $opt $ssh </dev/tty || rc=$?
    # bashlib
    elif [ "$1" = "bashlib" ]; then
        shift
        local list modules
        list="$(_module_resolve "${1-}")"
        IFS=',' read -ra modules <<<"$list"
        debug "Modules: ${modules[*]}"
        shift
        # processing
        local pattern='^#!/usr/bin/env'" bash|source "'/dev/null'
        # shellcheck disable=SC2086
        (
            printf '%s\n' "#!/usr/bin/env bash"
            printf '%s\n' "DEBUG=${DEBUG:-}"
            printf '%s\n' "BASHLIB_LOADER=remote"
            # load base
            if [[ "${modules[0]}" =~ ^(full|base)$ ]]; then
                grep -Ev "$pattern" "$BASHLIB_HOME/${modules[0]}"
                modules=("${modules[@]:1}")
            else
                grep -Ev "$pattern" "$BASHLIB_HOME"/base
            fi
            # load modules
            for module in "${modules[@]}"; do
                if [ "$module" = "configs" ]; then
                    for f in "$BASHLIB_HOME"/config/*; do
                        if [[ -f "$f" && "$f" != *.* ]]; then
                            grep -Ev "$pattern" "$f"
                        fi
                    done
                else
                    grep -Ev "$pattern" "$BASHLIB_HOME/$module"
                fi
            done
            (($# == 0)) || debug "Running: $*"
            (($# == 0)) || escape_args "$@"
            [ ! -p /dev/stdin ] || debug "Running piped command!"
            [ ! -p /dev/stdin ] || cat </dev/stdin
        ) | shfmt -mn | ssh $ssh bash -s || rc=$?
    # file
    elif [ -n "$file" ]; then
        is set --name=arguments --max=1 --die -- $#
        is readable --name=file --die -- "$1"
        # shellcheck disable=SC2086
        ssh $ssh 'bash -s' <"$1" || rc=$?
    # piped input
    elif [ -p /dev/stdin ] && (($# == 0)); then
        if [ -z "$lines" ]; then
            # shellcheck disable=SC2086
            ssh $ssh bash -s || rc=$?
        else
            # shellcheck disable=SC2086
            # shellcheck disable=SC2119
            ssh $ssh bash -s 2> >(grep -v '^Connection to .* closed\.' >&2 || true) >&2 | nocr || rc=$?
        fi
        return "${PIPESTATUS[0]}"
    # arguments
    else
        if [ -z "$lines" ]; then
            # shellcheck disable=SC2086
            # shellcheck disable=SC2029
            ssh $ssh "$@" || rc="${PIPESTATUS[0]}"
        else
            # shellcheck disable=SC2086
            # shellcheck disable=SC2119
            # shellcheck disable=SC2029
            ssh $ssh "$@" 2> >(grep -v '^Connection to .* closed\.' >&2 || true) >&2 | nocr || rc=$?
        fi
    fi
    # connection problem
    if ((rc == 255)); then
        die "SSH Connection to $ssh not possible"
    # process SIGKILL if issued on remote
    elif ((rc == 143)); then
        kill -- -$$ 2>/dev/null
        exit 143
    fi
    return "$rc"
}

# Upload file
#
# Usage:    upload [<options>] <source> <dest>
# Options:  # following options, only before `<source>`
#           l, login <user>
#           h, host <host>
#           j, jump <user>@<host>
#           f, files <list>     # each file in a line, must be relative from <source>
# Globals:  $server
#           $login - default is "operator"
upload() {
    # parameter parsing
    local _login host jump files
    eval set -- "$(option_parse $'+l login +\nh host +\nj jump +\nf files +' "$@")"
    while true; do
        case "$1" in
        -l | --login) is set --name=login --die --output=_login -- "$2" && shift 2 ;;
        -h | --host) is set --name=host --die --output=host -- "$2" && shift 2 ;;
        -j | --jump) is set --name=jump --die --output=jump -- "$2" && shift 2 ;;
        -f | --files) is set --name=files --die --output=files -- "$2" && shift 2 ;;
        --) shift && break ;;
        *) die "$(gettext "Unrecognized option"): $1" ;;
        esac
    done
    is integer --name=arguments --max=2 --die -- $#
    is set --name=source --die -- "$1"
    is set --name=dest --die -- "$2"
    # processing
    _login=${_login:-${login:-$REMOTE_LOGIN_DEFAULT}}
    host=${host:-$server}
    local ssh="${_login}@${host}"
    [ -z "$jump" ] || ssh="-J $jump $ssh"
    local dir=${2:-~}
    debug "rsync -av $1 $ssh:$dir"
    # shellcheck disable=SC2086
    if is set -- "$files"; then
        rsync -avz --files-from=<(printf '%s\n' "$files") "$1" $ssh:"$dir"
    else
        rsync -avz "$1" $ssh:"$dir"
    fi
}

# Download file
#
# Usage:    download [<options>] <source> <dest>
# Options:  # following options, only before `<source>`
#           l, login <user>
#           h, host <host>
#           j, jump <user>@<host>
# Globals:  $server
#           $login - default is "operator"
download() {
    # parameter parsing
    local _login host jump
    eval set -- "$(option_parse $'+l login +\nh host +\nj jump +' "$@")"
    while true; do
        case "$1" in
        -l | --login) is set --name=login --die --output=_login -- "$2" && shift 2 ;;
        -h | --host) is set --name=host --die --output=host -- "$2" && shift 2 ;;
        -j | --jump) is set --name=jump --die --output=jump -- "$2" && shift 2 ;;
        --) shift && break ;;
        *) die "$(gettext "Unrecognized option"): $1" ;;
        esac
    done
    is integer --name=arguments --max=2 --die -- $#
    is set --name=source --die -- "$1"
    is set --name=dest --die -- "$2"
    # processing
    _login=${_login:-${login:-$REMOTE_LOGIN_DEFAULT}}
    host=${host:-$server}
    local ssh="${_login}@${host}"
    [ -z "$jump" ] || ssh="-J $jump $ssh"
    local dir=${2:-.}
    # shellcheck disable=SC2086
    rsync -avz $ssh:"$1" "$dir"
}

