# Remote df with visual display
# The lines will be colorized based on $MOUNT_COLOR_LIMIT setting, which contains sets of 5 entries (pattern critical error warn ok). The first matching pattern will decide the color limits.
# Usage:    remote_df [<mount>...]                              # show table
#           remote_df <var> <operator> <limit%> [<mount>...]    # additionaly collect specific volumes
# Options:  -l, --local     # only list local devices
remote_df() {
    # parameter parsing
    local opt=""
    eval set -- "$(option_parse $'l locale -' "$@")"
    while true; do
        case "$1" in
        -l | --locale)
            opt="-l"
            shift
            ;;
        --)
            shift
            break
            ;;
        *) die "$(gettext "Unrecognized option"): $1" ;;
        esac
    done
    # collect specific limit
    if [ -n "$3" ] && is_integer "$3"; then
        declare -n ref="$1"
        local op="$2"
        local limit=$3
        shift 3
    fi
    # processing
    local firstline="" percent mount device limit_c limit_e limit_w limit_o
    # display
    IFS=$'\n'
    # shellcheck disable=SC2248
    for line in $(remote df -h $opt -x tmpfs -x efivarfs -x devtmpfs -x squashfs "$@"); do
        if [ -z "$firstline" ]; then
            firstline=1
            invers "$line"
        else
            percent=$(echo "$line" | xargs echo | cut -d' ' -f5 | sed 's/%//')
            mount=$(echo "$line" | xargs echo | cut -d' ' -f6 | nocr)
            # get color limits
            device=$(echo "$line" | xargs echo | cut -d' ' -f1)
            for ((i = 0; i < ${#MOUNT_COLOR_LIMIT[@]}; i += 5)); do
                pattern="${MOUNT_COLOR_LIMIT[i]}"
                if [[ "$device" =~ $pattern ]]; then
                    limit_c="${MOUNT_COLOR_LIMIT[i + 1]}"
                    limit_e="${MOUNT_COLOR_LIMIT[i + 2]}"
                    limit_w="${MOUNT_COLOR_LIMIT[i + 3]}"
                    limit_o="${MOUNT_COLOR_LIMIT[i + 4]}"
                    break
                fi
            done
            # display
            if ((percent == limit_c)); then
                critical "$line"
            elif ((percent == limit_e)); then
                error "$line"
            elif ((percent == limit_w)); then
                warn "$line"
            elif ((percent == limit_o)); then
                ok "$line"
            else
                echo "$line"
            fi
            # shellcheck disable=SC1105
            if [ -n "$limit" ] && eval "(( percent $op limit ))"; then
                ref="${ref}${mount} "
            fi
        fi
    done
    unset IFS
    echo ""
}

# Remote check if LVM is used
# Usage:    remote_lvm
# Return:   0 for uses LVM
#           1 if not
remote_lvm() {
    remote sudo vgs --noheadings \&\& [ -n "$(sudo vgs --noheadings 2>/dev/null)" ] &>/dev/null
}

# Wait till reboot is finished
# Usage:    boot_wait
# Options:  -q, --quiet
# Globals:  $server
#           $login - default is "operator"
# Error:    <sql-time>
boot_wait() {
    # parameter parsing
    eval set -- "$(option_parse $'q quiet -' "$@")"
    local quiet
    while true; do
        case "$1" in
        -q | --quiet)
            quiet=1
            shift
            ;;
        --)
            shift
            break
            ;;
        *) die "$(gettext "Unrecognized option"): $1" ;;
        esac
    done
    # processing
    local uptime seconds=15
    echo -ne "Warten bis der Reboot fertig ist" >&2
    sleep "$seconds"
    while true; do
        [ -n "$quiet" ] || echo -ne "\r$(eval_gettext "Wait until the reboot is complete (\$seconds seconds)")" >&2
        uptime=$(remote cut -d"' '" -f1 /proc/uptime 2>/dev/null | sed 's/[ .].*//')
        if ((uptime > 0 && uptime < 300)); then
            break
        else
            sleep 1
            ((seconds++))
        fi
    done
    [ -n "$quiet" ] || remote uptime --since
    [ -n "$quiet" ] || recho ""
}

######################################################################################
# Remote HTTP
######################################################################################

# Last HTTP return code from curl
CURL_HTTP_CODE=""

# Curl with added error handling
# This will load the content into a temporary shared memory file while running.
# Usage:    like curl
# Globals:  $server
#           $login - default is "operator"
#           CURL_HTTP_CODE set with last code
# Error:    <text> if not RC:2xx
# Return:   0 if RC:2xx
#           1 if not
curl() {
    local file res
    file=$(mktemp -m -r)
    res=$(command curl -s -w "Error: %{method} %{url_effective} with RC:%{http_code}" -o "$file" -L "$@")
    CURL_HTTP_CODE=${res:(-3)}
    if [[ "$CURL_HTTP_CODE" =~ ^2[0-9]{2}$ ]]; then
        cat "$file"
        rm "$file"
    else
        error "$res" >&2
        jq . "$file" >&2 2>/dev/null || cat "$file" >&2
        rm "$file"
        return 1
    fi
}

