# Wait till reboot is finished
# Usage:    boot_wait [<options>]
# Options:  l, login <user>
#           h, host <host>
#           j, jump <user>@<host>
#           q, quiet
# Globals:  $server
#           $login - default is "operator"
# Error:    <sql-time>
boot_wait() {
    # parameter parsing
    eval set -- "$(option_parse $'q quiet -' "$@")"
    local quiet
    while true; do
        case "$1" in
        -q | --quiet) quiet=1 && shift ;;
        --) shift && break ;;
        *) die "$(gettext "Unrecognized option"): $1" ;;
        esac
    done
    is integer --name=arguments --max=0 --die -- $#
    # processing
    local uptime seconds=15
    echo -ne "Warten bis der Reboot fertig ist" >&2
    sleep "$seconds"
    while true; do
        [ -n "$quiet" ] || echo -ne "\r$(eval_gettext "Wait until the reboot is complete (\$seconds seconds)")" >&2
        uptime=$(remote cut -d"' '" -f1 /proc/uptime 2>/dev/null | sed 's/[ .].*//')
        if ((uptime > 0 && uptime < 300)); then
            break
        else
            sleep 1
            ((seconds++))
        fi
    done
    [ -n "$quiet" ] || remote uptime --since
    [ -n "$quiet" ] || echo ""
}
