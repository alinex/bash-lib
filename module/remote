# Run command on remote host.
# You can let it use the `$server` and `$login` variables or give it in the options.
#
# If you use a pseudo `--terminal`, `\r\n` may be contained in output, remove with @nocr.`
# This will also return "Connection ... closed" in stderr after done. Handle it or use the `--line-based` option, which will return output line by line (problematic on some interactive parts) but without the connection closed message an no `\r\\n`.
# Usage:    remote [<options>] <command>...     # special characters in command masked with backslash ( | & * > < $ )
#           <commands> | remote [<options>]     # pipe the command which prevents masking
#           remote [<options>] --file <file>    # run file content on remote host
#           remote [<options>] console          # open a remote console to the user
# Options:  # following options, only before `<command>`
#           l, login <user>         # username for login
#           h, host <host>          # destination host
#           j, jump <user>@<host>   # to use a jump host before
#           t, terminal             # to use a pseudo terminal
#           line-based              # line based return for terminal
#           f, file                 # the command is a file reference which has to be used
# Globals:  $server
#           $login - default is "operator"
# Output:   passed through
# Example:  &remote shows how to use it
remote() {
    # parameter parsing
    local _login host jump term lines file
    eval set -- "$(option_parse $'+l login +\nh host +\nj jump +\nt terminal -\n- line-based -\nf file -' "$@")"
    while true; do
        case "$1" in
        -l | --login) _login="$2" && shift 2 ;;
        -h | --host) host="$2" && shift 2 ;;
        -j | --jump) jump="$2" && shift 2 ;;
        -t | --terminal) term=1 && shift ;;
        --line-based) lines=1 && shift ;;
        -f | --file) file=1 && shift ;;
        --) shift && break ;;
        *) die "$(gettext "Unrecognized option"): $1" ;;
        esac
    done
    # processing
    _login=${_login:-${login:-$REMOTE_LOGIN_DEFAULT}}
    host=${host:-$server}
    local ssh="${_login}@${host}"
    [ -z "$jump" ] || ssh="-J $jump $ssh" # use a jump host
    [ -z "$term" ] || ssh="-t $ssh"       # add pseudo terminal
    if [ -n "$file" ]; then
        is set --name=arguments --max=1 --die -- $#
        is readable --name=file --die -- "$1"
        ssh $ssh 'bash -s' <"$1"
    elif [ "$1" = "console" ]; then
        local rc
        # shellcheck disable=SC2086
        ssh $ssh '(nohup touch .hushlogin && sleep 1 && rm .hushlogin) >/dev/null 2>&1 </dev/null &' # no banner
        # shellcheck disable=SC2086
        # shellcheck disable=SC2248
        ssh $opt $ssh </dev/tty || rc=$?
        return "$rc"
    elif [ -p /dev/stdin ] && (($# == 0)); then
        if [ -z "$lines" ]; then
            # shellcheck disable=SC2086
            ssh $ssh bash -s
        else
            # shellcheck disable=SC2086
            # shellcheck disable=SC2119
            ssh $ssh bash -s 2> >(grep -v '^Connection to .* closed\.' >&2 || true) >&2 | nocr
        fi
        return "${PIPESTATUS[0]}"
    else
        if [ -z "$lines" ]; then
            # shellcheck disable=SC2086
            ssh $ssh "$@"
        else
            # shellcheck disable=SC2086
            # shellcheck disable=SC2119
            ssh $ssh "$@" 2> >(grep -v '^Connection to .* closed\.' >&2 || true) >&2 | nocr
        fi
        return "${PIPESTATUS[0]}"
    fi
}

