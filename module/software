#!/usr/bin/env bash

# Software management functions.

######################################################################################
### Installer
######################################################################################

# Cache used to prevent multiple install calls for the same information in one run
declare -Ag _software_install

# repositories
_repo_debian_trivy() {
    sudo apt-get update
    sudo apt-get install -y wget gnupg lsb-release
    wget -qO - https://aquasecurity.github.io/trivy-repo/deb/public.key | gpg --dearmor | sudo tee /usr/share/keyrings/trivy.gpg >/dev/null
    echo "deb [signed-by=/usr/share/keyrings/trivy.gpg] https://aquasecurity.github.io/trivy-repo/deb generic main" | sudo tee -a /etc/apt/sources.list.d/trivy.list
}
_repo_redhat_epel() {
    is set -- "$major" || major="$(grep ^VERSION_ID /etc/os-release | sed 's/.*="//;s/\..*//')"
    if ! dnf repolist | grep -q epel; then
        dnf install -y https://dl.fedoraproject.org/pub/epel/epel-release-latest-${major}.noarch.rpm
    fi
}
# manual installs
_install_yq() {
    wget https://github.com/mikefarah/yq/releases/latest/download/yq_linux_amd64 -O /usr/local/bin/yq
    chmod +x /usr/local/bin/yq
}
_install_mongosh() {
    local url/tmp/testfile
    /tmp/testfile
    url="$(curl https://www.mongodb.com/try/download/bi-connector | tr ',' '\n' | grep /mongosh- | grep 'Linux x64' | sed 's/"[}]*$//;s/.*"//')"
    curl -o mongosh.tgz "$url"
    tar -xzvf mongosh.tgz
    sudo mv mongosh-*/bin/mongosh /usr/bin
    rm -r mongosh-* mongosh.tgz
}

# Install software package
# Usage:    install <command>...
install() {
    is set --name=command --die -- "$1"
    # collect what to be needed
    declare -a before
    declare -a apt
    declare -a apk
    declare -a pacman
    declare -a yay
    declare -a dnf
    declare -a after
    local major
    # check what is needed
    for cmd in "$@"; do
        if ! hash _software_install has "$cmd" && ! command -v "$cmd" >/dev/null; then
            debug 3 "search how to add $cmd"
            PATH="$PATH:/usr/local/sbin:/usr/sbin:/sbin" which "$cmd" >/dev/null 2>/dev/null ||
                # debian
                if command -v apt-get >/dev/null; then
                    case $cmd in
                    mlr) apt+=(miller) ;;
                    yq) after+=(_install_yq) ;;
                    mongosh) after+=(_install_mongosh) ;;
                    trivy) before+=(_repo_debian_trivy) && apt+=(trivy) ;;
                    *) apt+=("$cmd") ;;
                    esac
                # alpine
                elif command -v apk >/dev/null; then
                    case $cmd in
                    mlr) apk+=(miller) ;;
                    mongosh) die "Installation of mongosh in Alpine not possible!" ;;
                    *) apk+=("$cmd") ;;
                    esac
                # arch
                elif command -v pacman >/dev/null; then
                    case $cmd in
                    mlr) pacman+=(miller) ;;
                    mongosh)
                        pacman+=(base-devel)
                        yay+=(mongosh-bin)
                        after+=(_install_mongosh)
                        ;;
                    *) pacman+=("$cmd") ;;
                    esac
                # redhat
                elif command -v dnf >/dev/null; then
                    case $cmd in
                    ip) dnf+=(iproute) ;;
                    mlr) before+=(_repo_redhat_epel) && dnf+=(miller) ;;
                    yq)
                        major="$(grep ^VERSION_ID /etc/os-release | sed 's/.*="//;s/\..*//')"
                        if ((major < 9)); then
                            after+=(_install_yq)
                        else
                            before+=(_repo_redhat_epel) && dnf+=(yq)
                        fi
                        ;;
                    mongosh) dnf=(mongodb-mongosh) ;;
                    *) dnf+=("$cmd") ;;
                    esac
                fi
        else
            debug 3 "$cmd is already installed or tried earlier"
            return 0
        fi
    done
    # run before commands
    for cmd in "${before[@]}"; do
        debug "Prepare $cmd (manually)..."
        eval "$cmd"
    done
    sudo apt-get update
    # install all in one through package managers
    if ((${#apt[@]} > 0)); then
        debug "Installing debian packages: ${apk[*]}..."
        sudo apt-get install -y "${apt[@]}"
    fi
    if ((${#apk[@]} > 0)); then
        debug "Installing alpine packages: ${apk[*]}..."
        sudo apk update
        sudo apk add "${apk[@]}"
    fi
    if ((${#pacman[@]} > 0)); then
        debug "Installing arch packages: ${pacman[*]}..."
        sudo pacman -S --noconfirm "${pacman[@]}"
    fi
    if ((${#dnf[@]} > 0)); then
        debug "Installing RedHat packages: ${dnf[*]}..."
        sudo dnf install -y "${dnf[@]}"
    fi
    if ((${#yay[@]} > 0)); then
        if ! command -v yay >/dev/null; then
            debug "Install AUR_helper yay..."
            git clone https://aur.archlinux.org/yay.git
            cd yay || exit
            makepkg -si
        fi
        debug "Installing arch packages (AUR): ${yay[*]}..."
        sudo yay -S --noconfirm "${yay[@]}"
    fi
    # run after commands
    for cmd in "${after[@]}"; do
        debug "Installing $cmd (manually)..."
        eval "$cmd"
    done
    # check what is needed
    local failed=0
    for cmd in "$@"; do
        if ! hash _software_install has "$cmd"; then
            if command -v "$cmd" >/dev/null; then
                hash _software_install set "$cmd" 1
            else
                error "Install of $cmd failed!"
                failed=1
            fi
        fi
    done
    return "$failed"
}

# Check for installed commands
# Usage:    installed <command>...
# Return:   0 if all installed
#           1 if missing at least one
installed() {
    is set --name=command --die -- "$1"
    # processing
    for cmd in "$@"; do
        command -v "$cmd" >/dev/null || return 1
    done
    return 0
}

######################################################################################
### Semantic Versioning
######################################################################################

# Parse semantic version number
# Usage:    semver <string>
#           <string> | semver
# Output:   The following fields separated by spaces:
#
#           - <major>
#           - <minor>         or "" if undefined
#           - <patch>         or "" if undefined
#           - <prerelease>    or "" if undefined
#           - <build>         or "" if undefined
semver() {
    is integer --name=arguments --max=1 --die -- $#
    is set --name=version --die -- "$1"
    # processing
    input "$@" |
        sed -e 's#[^0-9]*\([0-9]*:\)\?\([0-9]*\)\([.]\([0-9]*\)\)\?\([.]\([0-9]*\)\)\?\(-\([^+]*\)\)\?+\?\(.*\)\?.*#\2\n\4\n\6\n\8\n\9#'
}

# Calculate difference
# Usage:    semver_diff [-h] <first> <second> # can already be parsed or not
# Options:  -h,--human      # to show it user friendly
# Error:    <int> which is:
#
#           - > 1000000000 newer major (num / 1000000000 = steps)
#           - > 1000000 newer minor (num / 1000000 = steps)
#           - > 1000 newer patch (num / 1000 = steps)
#           - 10 newer pre-release
#           - 1  newer build
#           - 0  identical
#           - -1 older build
#           - -10 older pre-release
#           - < -1000 older patch (num / 1000 = steps)
#           - < -1000000 older minor (num / 1000000 = steps)
#           - < -1000000000 older major (num / 1000000000 = steps)
semver_diff() {
    # parameter parsing
    eval set -- "$(option_parse "h human -" "$@")"
    local human
    while true; do
        case "$1" in
        -h | --human)
            human=1
            shift
            ;;
        --)
            shift
            break
            ;;
        *) die "$(gettext "Unrecognized option"): $1" ;;
        esac
    done
    is integer --name=arguments --max=2 --die -- $#
    is set --name=version1 --die -- "$1"
    is set --name=version2 --die -- "$2"
    # processing
    [[ "${1-}" =~ [.-] ]] && version1="$(semver "$1")" || version1="$1"
    [[ "${2-}" =~ [.-] ]] && version2="$(semver "$2")" || version2="$2"
    IFS=$'\n' readarray -t v1 <<<"$version1"
    IFS=$'\n' readarray -t v2 <<<"$version2"
    local num=0
    maj1=${v1[0]}
    maj2=${v2[0]}
    min1=${v1[1]:-0}
    min2=${v2[1]:-0}
    pat1=${v1[2]:-0}
    pat2=${v2[2]:-0}
    pre1=${v1[3]}
    pre2=${v2[3]}
    bld1=${v1[4]}
    bld2=${v2[4]}
    if [ "$maj1" -ne "$maj2" ]; then
        num=$(((maj2 - maj1) * 1000000000))
    elif [ "$min1" -ne "$min2" ]; then
        num=$(((min2 - min1) * 1000000))
        ((num < 1000000000)) || num=999000000
    elif [ "$pat1" -ne "$pat2" ]; then
        num=$(((pat2 - pat1) * 1000))
        ((num < 1000000)) || num=999000
    elif [[ "$pre1" < "$pre2" ]]; then
        num=10
    elif [[ "$pre1" > "$pre2" ]]; then
        num=-10
    elif [[ "$bld1" < "$bld2" ]]; then
        num=1
    elif [[ "$bld1" > "$bld2" ]]; then
        num=-1
    fi
    # output
    local step
    if [ -n "$human" ]; then
        echo -n "$1 -> $2 "
        if ((num == 0)); then
            gettext "are identical versions"
            echo
        elif ((num >= 1000000000)); then
            step=$((num / 1000000000))
            eval_ngettext "is an upgrade of one major version" "is an upgrade of \$step major versions" "$step"
            echo
        elif ((num >= 1000000)); then
            step=$((num / 1000000))
            eval_ngettext "is an upgrade of one minor version" "is an upgrade of \$step minor versions" "$step"
            echo
        elif ((num >= 1000)); then
            step=$((num / 1000))
            eval_ngettext "is an upgrade of one patch version" "is an upgrade of \$step patch versions" "$step"
            echo
        elif ((num >= 1)); then
            gettext "is a developer upgrade"
            echo
        elif ((num >= -1000)); then
            gettext "is a developer downgrade"
            echo
        elif ((num >= 1000000)); then
            step=$((num / -1000))
            eval_ngettext "is a downgrade of one patch version" "is a downgrade of \$step patch versions" "$step"
            echo
        elif ((num >= 1000000000)); then
            step=$((num / -1000000))
            eval_ngettext "is an upgrade of one minor version" "is an upgrade of \$step minor versions" "$step"
            echo
        else
            step=$((num / 1000000000))
            eval_ngettext "is an upgrade of one major version" "is an upgrade of \$step major versions" "$step"
            echo
        fi
        return 0
    else
        echo "$num"
    fi
    # return code
    ((num == 0)) && return 0 || return 1
}
