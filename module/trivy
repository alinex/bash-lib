_trivy_cache=/tmp/trivy-cache
declare -A _trivy_jira
_trivy_report() {
    debug "trivy_report \"$1\" \"$2\" \"$3\""
    local work="$1"
    local file="$2"
    local source="$3"
    # initialize data and structure
    local type severity target id json title pkgPath description cvss installed sourceLine
    json="$(cat "$file")"
    type="$(jq .Type -r <<<"$json")"
    severity="$(jq .Severity -r <<<"$json")"
    target="$(jq .Target -r <<<"$json")"
    id="$(jq .VulnerabilityID -r <<<"$json")"
    title="$(jq .Title -r <<<"$json")"
    pkgPath="$(jq .PkgPath -r <<<"$json")"
    test ! "$pkgPath" = "null" || pkgPath=""
    description="$(jq .Description -r <<<"$json")"
    cvss="$(jq '.CVSS[]?.V3Score' -r <<<"$json")" | tr $'\n' '\;' | sed 's/;$//;s/;/; /g'
    installed="$(jq .InstalledVersion -r <<<"$json")"
    sourceLine="$source $target ($type) $pkgPath - Version $installed"
    # collect json changes
    local changes=() rules=() action
    # new findings
    local date
    date="$(jq .PublishedDate -r <<<"$json")"
    test ! "$date" = "null" || date=""
    if (($(date_format unix "$date") > $(now) - $(duration_format seconds 3d))) &&
        [[ "$severity" = "HIGH" || "$severity" = "CRITICAL" ]]; then
        action="Downgrade $severity -> MEDIUM because it was published less than 3 days ago"
        info "$id at $target: $action" >&2
        changes+=("{\"Severity\": \"MEDIUM\",\"OriginalSeverity\": \"$severity\"}")
        rules+=("{\"Title\": \"Just Published\",\"Description\": \"$action.\"}")
    fi
    # exploited
    local exploited
    exploited="$(jq '.vulnerabilities[]|select(.cveID=="'$id'")' "$_trivy_cache/exploits.json")"
    if is set -- "$exploited"; then
        action="Add information of known exploits and cancel downgrades in case of just published"
        info "$id at $target: $action" >&2
        changes+=("{\"Exploited\": $exploited, \"Severity\": \"$severity\"}")
        rules+=("{\"Title\": \"Exploited\",\"Description\": \"$action.\"}")
    fi
    # node dev-dependency -> downgrade to medium
    if [ "$type" = "npm" ] &&
        [[ "$severity" = "HIGH" || "$severity" = "CRITICAL" ]] && is file -- "$target" &&
        [ "$(jq '.packages|with_entries(select(.key|contains("'pkgname'")))|.[]|select(has("dev"))|[.dev]|any' $target/package-lock.json)" = "true" ]; then
        action="Downgrade $severity -> MEDIUM because it is a dev dependency"
        info "$id at $target: $action" >&2
        changes+=("{\"Severity\": \"MEDIUM\",\"OriginalSeverity\": \"$severity\"}")
        rules+=("{\"Title\": \"NPM Dev Dependency\",\"Description\": \"$action.\"}")
    fi
    # jira issues
    if is set -- "$TRIVY_JIRA_BOARD" && [[ "$severity" = "HIGH" || "$severity" = "CRITICAL" ]]; then
        # get information
        local issue created fixed fixStatus links
        issue="$(jira search "project = ${_trivy_jira[board]} AND summary ~ $id ORDER BY created ASC" | head -1)"
        fixed="$(jq .FixedVersion -r <<<"$json")"
        [ "$fixed" != "null" ] || fixed="-"
        fixStatus="$(jq .Status -r <<<"$json")"
        [ "$fixStatus" != "null" ] || fixStatus="-"
        links="$(jq '.References[]?' -r <<<"$json" | sed 's/^/- /')"
        if is empty -- "$issue"; then
            # create new jira issue
            local fields priority=Low
            case $severity in
            HIGH) priority=Major ;;
            CRITICAL) priority=Critical ;;
            esac
            jira json fields set project json "{\"id\":${_trivy_jira[board]}}"
            jira json fields set issuetype json "{\"id\":${_trivy_jira[issueType]}}"
            jira json fields set priority json "{\"name\":\"$priority\"}"
            jira json fields set summary "$id"
            jira json fields set description adf "$title"$'\n\n'"$description"
            jira json fields set ${_trivy_jira[field_sources]} adf "$(date +%Y-%m) > $source $target ($type)"
            jira json fields set ${_trivy_jira[field_rating]} adf "$severity (CVSS Rating ${cvss:--})"
            jira json fields set ${_trivy_jira[field_version]} adf "Gefixt ab Version $fixed $fixStatus"
            jira json fields set ${_trivy_jira[field_links]} adf "$links"
            jira json fields set ${_trivy_jira[field_sources]} adf "$(date +%Y-%m) > $sourceLine"
            jira json fields set labels json "[\"cve\", \"$(sed 's#.*ekz.de/##;s#/-/.*##;s#[/.]#", "#g' <<<"$source")\"]"
            issue="$(jira create "$fields")"
            created=1
        fi
        local jira deploy commentDate
        jira="$(jira get "$issue")"
        deploy="$(jq '.fields.'"${_trivy_jira[field_approval]}"'?.value' -r <<<"$jira")"
        commentDate=$(jq '.fields.comment.comments[].updated' -r <<<"$jira" | sort | tail -1)
        # downgrade
        if [[ "$severity" = "HIGH" || "$severity" = "CRITICAL" ]]; then
            if ([ "$deploy" = "$TRIVY_JIRA_APPROVAL_IRRELEVANT" ] || ([ "$deploy" = "$TRIVY_JIRA_APPROVAL_TEMP" ] && (($(date_diff "$(now)" "$commentDate") < $(duration_format seconds '30d'))))); then
                action="Downgrade $severity -> MEDIUM because of Jira status '$deploy'"
                info "$id at $target: $action" >&2
                changes+=("{\"Severity\": \"MEDIUM\",\"OriginalSeverity\": \"$severity\"}")
                rules+=("{\"Title\": \"Jira Approval\",\"Description\": \"$action.\"}")
            #elif [ "$deploy" = "$TRIVY_JIRA_APPROVAL_TEMP" ] && is set -- "$commentDate" && (($(date_diff "$(now)" "$commentDate") > $(duration_format seconds '30d'))); then
            #    expired=1
            fi
        fi
        # update jira
        if ! is set -- "$created"; then
            local old new fields update
            # update description
            old="$(jira json jira get description adf)"
            new="$title"$'\n\n'"$description"
            if [[ "$new" != "$old" ]]; then
                jira json fields set description adf "$new"
                update=1
            fi
            # update sources
            old="$(jira json jira get "${_trivy_jira[field_sources]}" md)"
            new="$(echo -e "$old\n$(date +%Y-%m) > $sourceLine" | sed -n '/>/p' | sort -t'>' -r -k2,1 | sort -t'>' -u -r -k2)"
            if [[ "$new" != "$old" ]]; then
                jira json fields set ${_trivy_jira[field_sources]} adf "$new"
                update=1
            fi
            # update rating
            old="$(jira json jira get "${_trivy_jira[field_rating]}" md)"
            new="$severity (CVSS Rating ${cvss:--})"
            if [[ "$new" != "$old" ]]; then
                jira json fields set ${_trivy_jira[field_rating]} adf "$new"
                update=1
            fi
            # update version
            old="$(jira json jira get "${_trivy_jira[field_version]}" md)"
            new="Gefixt ab Version $fixed $fixStatus"
            if [[ "$new" != "$old" ]]; then
                jira json fields set ${_trivy_jira[field_version]} adf "$new"
                update=1
            fi
            # update links
            old="$(jira json jira get "${_trivy_jira[field_links]}" md)"
            new="$links"
            if [[ "$new" != "$old" ]]; then
                jira json fields set ${_trivy_jira[field_links]} adf "$new"
                update=1
            fi
            # update labels
            local labels addLabel=()
            labels="$(jq '.fields.labels[]' -r <<<"$jira")"
            for label in $(echo "$source" | sed 's#.*ekz.de/##;s#/-/.*##;s#[/.]# #g'); do
                [[ ! "$labels" =~ $label ]] || continue
                addLabel+=('{"add": "'$label'"}')
            done
            if is set -- "$update"; then
                update="$fields"
                if ((${#addLabel[@]} > 0)); then
                    fields="$(jq --argjson l "[$(join $json ",")]" '.update = { "labels": $l }' <<<"$fields")"
                fi
                jira update "$issue" "$fields"
            fi
        fi
        action="Add information from Jira"
        info "$id at $target: $action" >&2
        changes+=("{\"Jira\": {\"id\": $issue, \"key\": $(jq .key <<<"$jira"), \"approval\": \"$deploy\", \"lastComment\": \"$commentDate\"}}")
        rules+=("{\"Title\": \"Jira Info\",\"Description\": \"$action.\"}")
    fi
    # store json changes
    is empty -- "$rules" || changes+=("{\"Rules\": [$(join rules)]}")
    for change in "${changes[@]}"; do
        json="$(jq -n --argjson o "$json" --argjson c "$change" '$o * $c')"
    done
    severity="$(jq .Severity -r <<<"$json")"
    local folder="$work/${severity,,}/$type/$id"
    mkdir -p "$folder"
    echo "$json" >"$folder/data.json"
    # create console text
    file="$folder/header.txt"
    if ! is file -- "$file"; then
        # set color
        case $severity in
        CRITICAL) echo -n "$CC_CRITICAL" >"$file" ;;
        HIGH) echo -n "$CC_ERROR" >"$file" ;;
        MEDIUM) echo -n "$CC_WARN" >"$file" ;;
        *) echo "" >"$file" ;;
        esac
        echo "================================================================================" >>"$file"
        echo "$severity $id $title" >>"$file"
        echo "--------------------------------------------------------------------------------" >>"$file"
        echo "$description" >>"$file"
        echo "    " >>"$file"
        echo "Rating: $severity (CVSS Rating $cvss)" >>"$file"
        echo "    " >>"$file"
        #test -z "$fixed" || echo -n " gefixt ab Version $fixed" >>$file_txt
        #test -z "$fixstatus" || echo -n " $fixstatus" >>$file_txt
        #test -z "$date" || echo "Eintragung vom: $date (vor $age)" >>$file
        #echo "$exploited" | jq '"Exploit bekannt seit "+.dateAdded+" bei "+.vendorProject+" "+.product' -r >>$file_txt
        #echo "$exploited" | jq '.notes' -r >>$file_txt
        #echo "Jira Ticket: https://ekz-gruppe.atlassian.net/browse/$issue" >>$file_txt
        #echo "Status: $status    Priorität: $priority    Zuständig: $assignee    Deploy: $deploy" >>$file_txt
        #echo "Letzte Kommentare:" >>$file_txt
        #echo -e "$comments" | sed 's/^/- /' >>$file_txt
        echo "Sources:" >>"$file"
    fi
    file="$folder/sources.txt"
    echo "- $sourceLine" >>"$file"
    file="$folder/footer.txt"
    if ! is file -- "$file"; then
        true
        #test -z "$links" || echo -e "Links:\n$links" >>$file_txt
    fi

    ## create markdown file
    #file="$folder/report.md"
    #if ! is file -- "$file"; then
    #    echo "  Title:      $title" >"$file"
    #fi
    ## create csv line
    #file="$folder/report.csv"
    #echo -e "$severity\t$type\t$id\t$title" >>"$file"

}
