#!/usr/bin/env bash
# shellcheck source=config/environment
source /dev/null
# shellcheck source=base
source /dev/null

# Run trivy security scan and analyze results.

TRIVY_EXPLOITS_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

TRIVY_JIRA_BOARD=SEC
TRIVY_JIRA_ISSUE_TYPE=Code
TRIVY_JIRA_FIELD_SOURCES=Vorkommen
TRIVY_JIRA_FIELD_RATING=Fremdeinschätzung
TRIVY_JIRA_FIELD_VERSION=Version
TRIVY_JIRA_FIELD_LINKS=Links
TRIVY_JIRA_FIELD_APPROVAL=Freigabe
TRIVY_JIRA_APPROVAL_TEMP="Ok für 30 Tage"
TRIVY_JIRA_APPROVAL_IRRELEVANT="Irrelevant"

# Run a trivy security analysis.
#
# If not installed it will install trivy and then use it.
# It will run the security analysis and output the directory in which you find all data:
#
# ```
# trivy.json - the original output of trivy containing all vulnerabilities
# <severity>/
#   <type>/
#       <cve-id>/
#           data.json
# ```
#
# After use you should remove this temporary folder to reclaim space.
#
# The pure trivy data will be optimized by:
#
# - downgrade security level if published in the last days
# - add exploit information
# - downgrade if node development package
# - connect with jira ticket management
#
# The jira ticket management needs some setup to work, all `JIRA_TRIVY_*` settings have to be set defined and therefore you need a board there you manage this tickets.
# Please make sure the custom fields are created for each of the setting. The approval needs also two defined values for temporarily allowed or irrelevant = always allowed.
#
# An Example is Board SEC with an `IssueType=Code`  which has the fields:
#
# - Sources as textarea field to store information of there this was found
# . Rating as textarea field containing the values from CVSS
# - Version as textarea field containing the installed and fixed version
# - Links as textarea field for all the references from trivy
# - Approval as enumeration with: Null, Blocked, Irrelevant, Allowed for 30 days
#
# Warning: This will overwrite the original trivy command, so if you want to use trivy directly while bashlib is loaded, use `command trivy ....`
#
# Usage:    trivy [<options>] root
#           trivy [<options>] files <path>
#           trivy [<options>] docker <file>
#           trivy [<options>] docker <image>
# Options:  t, timeout <duration>   set the timeout for the job in <int>m or <int>h
#           o, only-os              let `root` command only scan OS without filesystem traversal
# Output:   <report-path> or nothing if no vulnerabilities found
# Return:   1 if there are at least one CRITICAL or HIGH vulnerabilities
trivy() {
    is enum --name=command --allow="root files docker" --die -- "$1" && local command="$1" && shift
    local timeout
    timeout=${TRIVY_DEFAULT_TIMEOUT:-60m}
    # parameter parsing
    local _login host jump term lines file
    eval set -- "$(option_parse $'t timeout +\no only-os -' "$@")"
    while true; do
        case "$1" in
        -t | --timeout) timeout="$2" && shift 2 ;;
        -o | --only-os) onlyOS=1 && shift ;;
        --) shift && break ;;
        *) die "$(gettext "Unrecognized option"): $1" ;;
        esac
    done
    # processing
    install trivy
    local work cmd opt="--exit-code 0 --no-progress --skip-version-check --timeout $timeout -f json"
    local source="$1"
    work="$(mktemp --directory "${$}_trivy")"
    cmd="$(command -v trivy)"
    opt+=" -o $work/trivy.json"
    is empty -- "$DEBUG" || opt+=" --debug"
    is empty -- "$TRIVY_CACHE_SERVER" || opt+=" --server $TRIVY_CACHE_SERVER"
    case $command in
    root)
        is empty -- "$onlyOS" || opt+=" --pkg-types os"
        source="$(hostname -f)"
        sudo $cmd rootfs $opt $exclude / 2>&1 | sed 's/[^A-Z]*T[^A-Z]*//' | debug
        ;;
    files) command $cmd fs $opt "$1" 2>&1 | sed 's/[^A-Z]*T[^A-Z]*//' | debug ;;
    docker) command $cmd image $opt --input "$1" 2>&1 | sed 's/[^A-Z]*T[^A-Z]*//' | debug ;;
    esac
    # Splitting
    debug "Optimize JSON structure for splitting..."
    jq '.Results[]?|. as $g|.Vulnerabilities[]?|{Class: $g.Class, Target: $g.Target, Type: $g.Type}*.' "$work"/trivy.json >"$work"/split.json
    debug "Splitting JSON..."
    mkdir "$work"/split
    csplit -f "$work"/split/ -b '%06d' -zs $work/split.json /^{/ "{*}"
    rm "$work"/split.json
    # skip if nothing found
    local found
    found="$(ls -1 "$work"/split/ | wc -l)"
    if ((found == 0)); then
        debug "Nothing found."
        rm -r "$work"
        return 0
    fi
    debug "Found $found reports."
    # trivy report cache
    mkdir -p "$_trivy_cache/jira"
    ! is file -- "$_trivy_cache/exploits.json" || find "$_trivy_cache/exploits.json" -mmin +1440 -delete
    is file -- "$_trivy_cache/exploits.json" || curl -s "$TRIVY_EXPLOITS_URL" -o "$_trivy_cache/exploits.json"
    # initialize jira
    local project
    project="$(jira project "$TRIVY_JIRA_BOARD")"
    _trivy_jira[board]="$(jq .id -r <<<"$project")"
    is set -- "${_trivy_jira[board]}" || die "Could not find JIRA Board ID for $TRIVY_JIRA_BOARD!"
    _trivy_jira[issueType]="$(jq '.issueTypes[] | select(.name == "'"$TRIVY_JIRA_ISSUE_TYPE"'").id' -r <<<"$project")"
    is set -- "${_trivy_jira[issueType]}" || die "Could not find JIRA Issue Type ID for $TRIVY_JIRA_BOARD/$TRIVY_JIRA_ISSUE_TYPE!"
    fields="$(jira fields "${_trivy_jira[board]}" "${_trivy_jira[issueType]}")"
    _trivy_jira[field_sources]="$(jq '.fields[] | select(.name == "'"$TRIVY_JIRA_FIELD_SOURCES"'").key' -r <<<"$fields")"
    is set -- "${_trivy_jira[field_sources]}" || die "Could not find JIRA Field \"$TRIVY_JIRA_FIELD_SOURCES\" in $TRIVY_JIRA_BOARD/$TRIVY_JIRA_ISSUE_TYPE!"
    _trivy_jira[field_rating]="$(jq '.fields[] | select(.name == "'"$TRIVY_JIRA_FIELD_RATING"'").key' -r <<<"$fields")"
    is set -- "${_trivy_jira[field_rating]}" || die "Could not find JIRA Field \"$TRIVY_JIRA_FIELD_RATING\" in $TRIVY_JIRA_BOARD/$TRIVY_JIRA_ISSUE_TYPE!"
    _trivy_jira[field_version]="$(jq '.fields[] | select(.name == "'"$TRIVY_JIRA_FIELD_VERSION"'").key' -r <<<"$fields")"
    is set -- "${_trivy_jira[field_version]}" || die "Could not find JIRA Field \"$TRIVY_JIRA_FIELD_VERSION\" in $TRIVY_JIRA_BOARD/$TRIVY_JIRA_ISSUE_TYPE!"
    _trivy_jira[field_links]="$(jq '.fields[] | select(.name == "'"$TRIVY_JIRA_FIELD_LINKS"'").key' -r <<<"$fields")"
    is set -- "${_trivy_jira[field_links]}" || die "Could not find JIRA Field \"$TRIVY_JIRA_FIELD_LINKS\" in $TRIVY_JIRA_BOARD/$TRIVY_JIRA_ISSUE_TYPE!"
    _trivy_jira[field_approval]="$(jq '.fields[] | select(.name == "'"$TRIVY_JIRA_FIELD_APPROVAL"'").key' -r <<<"$fields")"
    is set -- "${_trivy_jira[field_approval]}" || die "Could not find JIRA Field \"$TRIVY_JIRA_FIELD_APPROVAL\" in $TRIVY_JIRA_BOARD/$TRIVY_JIRA_ISSUE_TYPE!"
    # Loop over entries and create report
    local num
    for file in "$work"/split/*; do
        num="$(basename "$file")"
        queue add _trivy_report "$work" "$file" "$source"
    done
    queue run
    #rm -r "$work"/split

    # Output folder
    echo "$work"
}
