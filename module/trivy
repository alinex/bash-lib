#!/usr/bin/env bash
# shellcheck source=config/environment
source /dev/null
# shellcheck source=base
source /dev/null

# Run trivy security scan and analyze results.

TRIVY_EXPLOITS_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
TRIVY_JIRA_BOARD=SEC
TRIVY_JIRA_ISSUE_TYPE=Code

# Run a trivy security analysis.
#
# If not installed it will install trivy and then use it.
# It will run the security analysis and output the directory in which you find all data:
#
# ```
# trivy.json - the original output of trivy containing all vulnerabilities
# <severity>/
#   <type>/
#       <cve-id>/
#           data.json
# ```
#
# The pure trivy data will be optimized by:
#
# - downgrade security level if published in the last days
# - add exploit information
# - downgrade if node development package
# - connect with jira ticket management
#
# After use you should remove this temporary folder to reclaim space.
#
# Warning: This will overwrite the original trivy command, so if you want to use trivy directly while bashlib is loaded, use `command trivy ....`
#
# Usage:    trivy [<options>] root
#           trivy [<options>] files <path>
#           trivy [<options>] docker <file>
#           trivy [<options>] docker <image>
# Options:  t, timeout <duration>   set the timeout for the job in <int>m or <int>h
#           o, only-os              let `root` command only scan OS without filesystem traversal
# Output:   <report-path> or nothing if no vulnerabilities found
# Return:   1 if there are at least one CRITICAL or HIGH vulnerabilities
trivy() {
    is enum --name=command --allow="root files docker" --die -- "$1" && local command="$1" && shift
    local timeout
    timeout=${TRIVY_DEFAULT_TIMEOUT:-60m}
    # parameter parsing
    local _login host jump term lines file
    eval set -- "$(option_parse $'t timeout +\no only-os -' "$@")"
    while true; do
        case "$1" in
        -t | --timeout) timeout="$2" && shift 2 ;;
        -o | --only-os) onlyOS=1 && shift ;;
        --) shift && break ;;
        *) die "$(gettext "Unrecognized option"): $1" ;;
        esac
    done
    # processing
    install trivy
    local work cmd opt="--exit-code 0 --no-progress --skip-version-check --timeout $timeout -f json"
    local source="$1"
    work="$(mktemp --directory "${$}_trivy")"
    cmd="$(command -v trivy)"
    opt+=" -o $work/trivy.json"
    is empty -- "$DEBUG" || opt+=" --debug"
    is empty -- "$TRIVY_CACHE_SERVER" || opt+=" --server $TRIVY_CACHE_SERVER"
    case $command in
    root)
        is empty -- "$onlyOS" || opt+=" --pkg-types os"
        source="$(hostname -f)"
        sudo $cmd rootfs $opt $exclude / 2>&1 | sed 's/[^A-Z]*T[^A-Z]*//' | debug
        ;;
    files) command $cmd fs $opt "$1" 2>&1 | sed 's/[^A-Z]*T[^A-Z]*//' | debug ;;
    docker) command $cmd image $opt --input "$1" 2>&1 | sed 's/[^A-Z]*T[^A-Z]*//' | debug ;;
    esac
    # Splitting
    debug "Optimize JSON structure for splitting..."
    jq '.Results[]?|. as $g|.Vulnerabilities[]?|{Class: $g.Class, Target: $g.Target, Type: $g.Type}*.' "$work"/trivy.json >"$work"/split.json
    debug "Splitting JSON..."
    mkdir "$work"/split
    csplit -f "$work"/split/ -b '%06d' -zs $work/split.json /^{/ "{*}"
    rm "$work"/split.json
    # skip if nothing found
    local found
    found="$(ls -1 "$work"/split/ | wc -l)"
    if ((found == 0)); then
        debug "Nothing found."
        rm -r "$work"
        return 0
    fi
    debug "Found $found reports."
    # trivy report cache
    mkdir -p "$_trivy_cache/jira"
    ! is file -- "$_trivy_cache/exploits.json" || find "$_trivy_cache/exploits.json" -mmin +1440 -delete
    is file -- "$_trivy_cache/exploits.json" || curl -s "$TRIVY_EXPLOITS_URL" -o "$_trivy_cache/exploits.json"
    #find "$_trivy_cache/jira" -type=f -mmin +5 -delete
    # Loop over entries and create report
    local num
    for file in "$work"/split/*; do
        num="$(basename "$file")"
        queue add _trivy_report "$work" "$file" "$source"
    done
    queue run
    #rm -r "$work"/split

    # Output folder
    echo "$work"
}
trivy_test() {
    work="$1"
    source="test"
    rm -r "$work"/split/critical "$work"/split/high "$work"/split/medium "$work"/split/low 2>/dev/null || true

    # initialize jira
    local project
    project="$(jira project "$TRIVY_JIRA_BOARD")"
    _trivy_jira[board]="$(jq .id -r <<<"$project")"
    _trivy_jira[issueType]="$(jq '.issueTypes[] | select(.name == "'"$TRIVY_JIRA_ISSUE_TYPE".'").id' -r <<<"$project")"
    fields="$(jira fields "${_trivy_jira[board]}" "${_trivy_jira[issueType]}")"
    JIRA_FIELD_VORKOMMEN=customfield_10090
    JIRA_FIELD_TEAM=customfield_10001
    JIRA_FIELD_FREMDEINSCHAETZUNG=customfield_10091
    JIRA_FIELD_VERSION=customfield_10089
    JIRA_FIELD_LINKS=customfield_10092
    JIRA_FIELD_FREIGABE=customfield_10094
    _trivy_jira[field_sources]="$(jq '.fields[] | select(.name == "'"$JIRA_FIELD_VORKOMMEN'").key' -r <<<"$fields")"
    _trivy_jira[field_team]="$(jq '.fields[] | select(.name == "'"$JIRA_FIELD_TEAM'").key' -r <<<"$fields")"
    _trivy_jira[field_rating]="$(jq '.fields[] | select(.name == "'"$JIRA_FIELD_FREMDEINSCHAETZUNG'").key' -r <<<"$fields")"
    _trivy_jira[field_version]="$(jq '.fields[] | select(.name == "'"$JIRA_FIELD_VERSION'").key' -r <<<"$fields")"
    _trivy_jira[field_links]="$(jq '.fields[] | select(.name == "'"$JIRA_FIELD_LINKS'").key' -r <<<"$fields")"
    _trivy_jira[field_approval]="$(jq '.fields[] | select(.name == "'"$JIRA_FIELD_FREIGABE'").key' -r <<<"$fields")"

    curl -s --request GET --url "https://${ATLASSIAN_DOMAIN}.atlassian.net/rest/api/3/issue/createmeta/${_trivy_jira[board]}/issuetypes/${_trivy_jira[issueType]}" --user "$ATLASSIAN_USER:$ATLASSIAN_TOKEN" --header 'Accept: application/json' | jq

    # Loop over entries and create report
    local num
    for file in "$work"/split/*; do
        num="$(basename "$file")"
        queue add _trivy_report "$work" "$file" "$source"
    done
    queue run
    #rm -r "$work"/split
}

_trivy_cache=/tmp/trivy-cache
declare -A _trivy_jira
_trivy_report() {
    local work="$1"
    local file="$2"
    local source="$3"
    # initialize data and structure
    local type severity target id folder json
    json="$(cat "$file")"
    type="$(jq .Type -r <<<"$json")"
    severity="$(jq .Severity -r <<<"$json")"
    target="$(jq .Target -r <<<"$json")"
    id="$(jq .VulnerabilityID -r <<<"$json")"
    folder="$work/${severity,,}/$type/$id"
    mkdir -p "$folder"
    # collect json changes
    local changes=() rules=() action
    # new findings
    local date
    date="$(jq .PublishedDate -r <<<"$json")"
    test ! "$date" = "null" || date=""
    if (($(date_format unix "$date") > $(now) - $(duration_format seconds 3d))) &&
        [[ "$severity" = "HIGH" || "$severity" = "CRITICAL" ]]; then
        action="Downgrade $severity -> MEDIUM because it was published less than 3 days ago"
        info "$id at $target: $action" >&2
        changes+=("{\"Severity\": \"MEDIUM\",\"OriginalSeverity\": \"$severity\"}")
        rules+=("{\"Title\": \"Just Published\",\"Description\": \"$action.\"}")
    fi
    # exploited
    local exploited
    exploited="$(jq '.vulnerabilities[]|select(.cveID=="'$id'")' "$_trivy_cache/exploits.json")"
    if is set -- "$exploited"; then
        action="Add information of known exploits and cancel downgrades in case of just published"
        info "$id at $target: $action" >&2
        changes+=("{\"Exploited\": $exploited, \"Severity\": \"$severity\"}")
        rules+=("{\"Title\": \"Exploited\",\"Description\": \"$action.\"}")
    fi
    # node dev-dependency -> downgrade to medium
    if [ "$type" = "npm" ] &&
        [[ "$severity" = "HIGH" || "$severity" = "CRITICAL" ]] && is file -- "$target" &&
        [ "$(jq '.packages|with_entries(select(.key|contains("'pkgname'")))|.[]|select(has("dev"))|[.dev]|any' $target/package-lock.json)" = "true" ]; then
        action="Downgrade $severity -> MEDIUM because it is a dev dependency"
        info "$id at $target: $action" >&2
        changes+=("{\"Severity\": \"MEDIUM\",\"OriginalSeverity\": \"$severity\"}")
        rules+=("{\"Title\": \"NPM Dev Dependency\",\"Description\": \"$action.\"}")
    fi
    # jira issues
    if is set -- "$TRIVY_JIRA_BOARD" && [[ "$severity" = "HIGH" || "$severity" = "CRITICAL" ]]; then
        local issue jira
        issue="$(jira search "project = ${_trivy_jira[board]} AND summary ~ $id ORDER BY created ASC" | head -1)"
        if is empty -- "$issue"; then
            local fields priority=Low title description
            case $severity in
            HIGH) priority=Major ;;
            CRITICAL) priority=Critical ;;
            esac
            title="$(jq .Title -r <<<"$json")"
            description="$(jq .Description -r <<<"$json")"
            jira json fields set project "${_trivy_jira[board]}"
            jira json fields set priority "$priority"
            jira json fields set summary "$id"
            jira json fields set description "$(jira adf format "$title"$'\n\n'"$description")"
            jira json fields set issuetype "{\"id\": \"${_trivy_jira[issueType]}\"}"

            "$JIRA_FIELD_VORKOMMEN": "$SOURCE $target ($type)",
            "$JIRA_FIELD_FREMDEINSCHAETZUNG": "$severity (CVSS Rating $cvss)",
            "$JIRA_FIELD_VERSION": "Installiert ist Version $installed gefixt ab Version $fixed $fixstatus",
            "$JIRA_FIELD_LINKS": $(jq -n --arg t "$links" '$t'),

            "labels": ["cve", "$(echo "$SOURCE" | sed 's#.*ekz.de/##;s#/-/.*##;s#[/.]#", "#g')"]
            issue="$(jira create "$fields")"
        fi
        warn xxx $issue >&2
        jira="$(jira get "$issue")"
        warn "Jira $issue" >&2
    fi
    # store json changes
    is empty -- "$rules" || changes+=("{\"Rules\": [$(join rules)]}")
    for change in "${changes[@]}"; do
        json="$(jq -n --argjson o "$json" --argjson c "$change" '$o * $c')"
    done
    echo "$json" >"$folder/data.json"
}
