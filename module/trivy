_trivy_cache=/tmp/trivy-cache
declare -A _trivy_jira
_trivy_report() {
    debug "trivy_report \"$1\" \"$2\" \"$3\""
    local work="$1"
    local file="$2"
    local source="$3"
    local progress="$4"
    # initialize data and structure
    local type severity target id json title pkgName pkgPath description cvss installed sourceLine date fixed fixStatus links
    json="$(cat "$file")"
    type="$(jq .Type -r <<<"$json")"
    severity="$(jq .Severity -r <<<"$json")"
    target="$(jq .Target -r <<<"$json")"
    id="$(jq .VulnerabilityID -r <<<"$json")"
    title="$(jq .Title -r <<<"$json")"
    pkgPath="$(jq .PkgPath -r <<<"$json")"
    test ! "$pkgPath" = "null" || pkgPath=""
    pkgName="$(jq .PkgName -r <<<"$json")"
    test ! "$pkgName" = "null" || pkgName=""
    description="$(jq .Description -r <<<"$json")"
    cvss="$(jq '.CVSS[]?.V3Score' -r <<<"$json" | tr $'\n' '\;' | sed 's/;$//;s/;/; /g')"
    installed="$(jq .InstalledVersion -r <<<"$json")"
    sourceLine="$source $target ($type) $pkgPath - Version $installed"
    fixed="$(jq .FixedVersion -r <<<"$json")"
    [ "$fixed" != "null" ] || fixed="-"
    fixStatus="$(jq .Status -r <<<"$json")"
    [ "$fixStatus" != "null" ] || fixStatus="-"
    date="$(jq .PublishedDate -r <<<"$json")"
    test ! "$date" = "null" || date=""
    links="$(jq '.References[]?' -r <<<"$json" | sed 's/^/- /')"
    # collect json changes
    local changes=() rules=() action
    # new findings
    # shellcheck disable=SC2119
    if (($(date_format unix "$date") > $(now) - $(duration_format seconds 3d))) &&
        [[ "$severity" = "HIGH" || "$severity" = "CRITICAL" ]]; then
        action="$(eval_gettext 'Downgrade $severity -> MEDIUM because it was published less than 3 days ago')"
        [ -z "$progress" ] || info "$id at $target: $action" >&2
        changes+=("{\"Severity\": \"MEDIUM\",\"OriginalSeverity\": \"$severity\"}")
        rules+=("{\"Title\": \"Just Published\",\"Description\": \"$action.\"}")
    fi
    # exploited
    local exploited
    exploited="$(jq '.vulnerabilities[]|select(.cveID=="'"$id"'")' "$_trivy_cache/exploits.json")"
    if is set -- "$exploited"; then
        action="$(gettext 'Add information of known exploits and cancel downgrades in case of just published')"
        [ -z "$progress" ] || info "$id at $target: $action" >&2
        changes+=("{\"Exploited\": $exploited, \"Severity\": \"$severity\"}")
        rules+=("{\"Title\": \"Exploited\",\"Description\": \"$action.\"}")
    fi
    # node dev-dependency -> downgrade to medium
    if [ "$type" = "npm" ] &&
        [[ "$severity" = "HIGH" || "$severity" = "CRITICAL" ]] && is file -- "$target" &&
        [ "$(jq '.packages|with_entries(select(.key|contains("'"$pkgName"'")))|.[]|select(has("dev"))|[.dev]|any' "$target"/package-lock.json)" = "true" ]; then
        action="$(eval_gettext 'Downgrade $severity -> MEDIUM because it is a dev dependency')"
        [ -z "$progress" ] || info "$id at $target: $action" >&2
        changes+=("{\"Severity\": \"MEDIUM\",\"OriginalSeverity\": \"$severity\"}")
        rules+=("{\"Title\": \"NPM Dev Dependency\",\"Description\": \"$action.\"}")
    fi
    # jira issues
    local issue key approval comments expired
    if is set -- "$TRIVY_JIRA_BOARD" && [[ "$severity" = "HIGH" || "$severity" = "CRITICAL" ]]; then
        # get information
        local created
        issue="$(jira search "project = ${_trivy_jira[board]} AND summary ~ $id ORDER BY created ASC" | head -1)"
        if is empty -- "$issue"; then
            # create new jira issue
            local fields priority=Low
            case $severity in
            HIGH) priority=Major ;;
            CRITICAL) priority=Critical ;;
            esac
            jira json fields set project json "{\"id\":${_trivy_jira[board]}}"
            jira json fields set issuetype json "{\"id\":${_trivy_jira[issueType]}}"
            jira json fields set priority json "{\"name\":\"$priority\"}"
            jira json fields set summary "$id"
            jira json fields set description adf "$title"$'\n\n'"$description"
            jira json fields set "${_trivy_jira[field_rating]}" adf "$severity (CVSS rating ${cvss:--})"
            jira json fields set "${_trivy_jira[field_version]}" adf "Gefixt ab Version ${fixed:--} $fixStatus"
            jira json fields set "${_trivy_jira[field_links]}" adf "$links"
            jira json fields set "${_trivy_jira[field_sources]}" adf "$(date +%Y-%m) > $sourceLine"
            jira json fields set labels json "[\"cve\", \"$(sed 's#.*ekz.de/##;s#/-/.*##;s#[/.]#", "#g' <<<"$source")\"]"
            issue="$(jira create "$fields")"
            created=1
        fi
        local jira deploy commentDate jiraStatus assignee
        jira="$(jira get "$issue")"
        deploy="$(jq '.fields.'"${_trivy_jira[field_approval]}"'?.value' -r <<<"$jira")"
        commentDate="$(jq '.fields.comment.comments[].updated' -r <<<"$jira" | sort | tail -1)"
        key="$(jq .key -r <<<"$jira")"
        jiraStatus="$(jq .fields.status.name -r <<<"$jira")"
        assignee="$(jq .fields.assignee.displayName -r <<<"$jira")"
        local date author comments=()
        while IFS=$'\t' read -r date author comment; do
            comments+=("$date $author: $(jira adf_to_md "$comment" | grep -v ^$)")
        done < <(jq '.fields.comment.comments[-3:][] | [.updated, .updateAuthor.displayName, (.body | @json)] | @tsv' -r <<<"$jira" | tac)
        # downgrade
        if [[ "$severity" = "HIGH" || "$severity" = "CRITICAL" ]]; then
            if ([ "$deploy" = "$TRIVY_JIRA_APPROVAL_IRRELEVANT" ] || ([ "$deploy" = "$TRIVY_JIRA_APPROVAL_TEMP" ] && (($(date_diff "$commentDate") <= $(duration_format seconds '30d'))))); then
                action="$(eval_gettext 'Downgrade $severity -> MEDIUM because of Jira status $deploy')"
                info "$(eval_gettext '$id at $target'): $action" >&2
                changes+=("{\"Severity\": \"MEDIUM\",\"OriginalSeverity\": \"$severity\"}")
                rules+=("{\"Title\": \"Jira Approval\",\"Description\": \"$action.\"}")
            fi
            if ([ "$deploy" = "$TRIVY_JIRA_APPROVAL_TEMP" ] && (($(date_diff "$commentDate") > $(duration_format seconds '30d')))); then
                expired=1
            fi
        fi
        # update jira
        if ! is set -- "$created"; then
            local old new fields update
            # update description
            old="$(jira json jira get description adf)"
            new="$title"$'\n\n'"$description"
            if [[ "$new" != "$old" ]]; then
                jira json fields set description adf "$new"
                update=1
            fi
            # update sources
            old="$(jira json jira get "${_trivy_jira[field_sources]}" md)"
            new="$(printf '%s\n%s' "$old" "$(date +%Y-%m) > $sourceLine" | sed -n '/>/p' | sort -t'>' -k1,1r -k2,2)"
            if [[ "$new" != "$old" ]]; then
                jira json fields set "${_trivy_jira[field_sources]}" adf "$new"
                update=1
            fi
            # update rating
            old="$(jira json jira get "${_trivy_jira[field_rating]}" md)"
            new="$severity (CVSS Rating ${cvss:--})"
            if [[ "$new" != "$old" ]]; then
                jira json fields set "${_trivy_jira[field_rating]}" adf "$new"
                update=1
            fi
            # update version
            old="$(jira json jira get "${_trivy_jira[field_version]}" md)"
            new="Gefixt ab Version ${fixed:--} $fixStatus"
            if [[ "$new" != "$old" ]]; then
                jira json fields set "${_trivy_jira[field_version]}" adf "$new"
                update=1
            fi
            # update links
            old="$(jira json jira get "${_trivy_jira[field_links]}" md)"
            new="$links"
            if [[ "$new" != "$old" ]]; then
                jira json fields set "${_trivy_jira[field_links]}" adf "$new"
                update=1
            fi
            # update labels
            local labels addLabel=()
            labels="$(jq '.fields.labels[]' -r <<<"$jira")"
            # shellcheck disable=SC2013
            for label in $(sed 's#.*ekz.de/##;s#/-/.*##;s#[/.]# #g' <<<"$source"); do
                [[ ! "$labels" =~ $label ]] || continue
                addLabel+=('{"add": "'"$label"'"}')
            done
            if is set -- "$update"; then
                update=1
                if ((${#addLabel[@]} > 0)); then
                    fields="$(jq --argjson l "[$(array addLabel join ",")]" '.update = { "labels": $l }' <<<"$fields")"
                fi
                jira update "$issue" "$fields"
            fi
        fi
        action="$(gettext 'Add information from Jira')"
        [ -z "$progress" ] || info "$(eval_gettext '$id at $target'): $action" >&2
        changes+=("{\"Jira\": {\"id\": $issue, \"key\": \"$key\", \"approval\": \"$deploy\", \"lastComment\": \"$commentDate\"}}")
        rules+=("{\"Title\": \"Jira Info\",\"Description\": \"$action.\"}")
    fi
    # store json changes
    # shellcheck disable=SC2128
    is empty -- "$rules" || changes+=("{\"Rules\": [$(array rules join)]}")
    for change in "${changes[@]}"; do
        json="$(jq -n --argjson o "$json" --argjson c "$change" '$o * $c')"
    done
    severity="$(jq .Severity -r <<<"$json")"
    local folder="$work/${severity,,}/$type/$id"
    mkdir -p "$folder"
    printf '%s\n' "$json" >"$folder/data.json"
    # get more information for reports
    local exploitDate exploitVendor exploitProduct issue key approval
    exploitDate="$(jq .Exploited.dateAdded -r <<<"$json")"
    test ! "$exploitDate" = "null" || exploitDate=""
    # shellcheck disable=SC2034
    if is set -- "$exploitDate"; then
        exploitVendor="$(jq .Exploited.vendorProject -r <<<"$json")"
        exploitProduct="$(jq .Exploited.product -r <<<"$json")"
    fi
    # create console text
    file="$folder/header.txt"
    if ! is file -- "$file"; then
        {
            # set color
            # shellcheck disable=SC2059
            case $severity in
            CRITICAL) printf "$CC_CRITICAL" ;;
            HIGH) printf "$CC_ERROR" ;;
            MEDIUM) printf "$CC_WARN" ;;
            *) printf "" ;;
            esac
            printf '%s\n' "================================================================================"
            printf '%s\n' "$severity $id $title"
            printf '%s\n' "--------------------------------------------------------------------------------"
            printf '%s\n' "$description"
            printf '%s\n' "    "
            local value="${cvss:--}" human
            printf '%s\n' "$(eval_gettext 'Rating: $severity (CVSS rating $value)')"
            value="${fixed:--}"
            printf '%s\n' "$(eval_gettext 'Status: Fixed from version $value $fixStatus')"
            # shellcheck disable=SC2034
            human="$(date_format human-date "$date")"
            value="$(duration_format days "$(date_diff "$date")")"
            printf '%s\n' "$(eval_gettext 'Date:   Vulnerability known since $human ($value days ago)')"
            printf '%s\n' "    "
            is empty -- "$exploitDate" || printf '%s\n\n' "$(eval_gettext 'Exploit known since $exploitDate at $exploitVendor $exploitProduct')"
            if is set -- "$issue"; then
                printf '%s\n' "Jira Issue: https://ekz-gruppe.atlassian.net/browse/$issue"
                printf '%s\n' "            $jiraStatus    $(gettext 'Responsible'): $assignee"
                printf '%s\n' "            $(gettext 'Deploy'): ${approval:-Undefiniert}"
                printf '%s\n' "$(gettext 'Last comments'):\n$(array comments join $'\n' | sed 's/^/             /')"
            fi
            printf '%s:\n' "$(gettext 'Sources')"
        } >>"$file"
    fi
    file="$folder/sources.txt"
    printf '%s\n' "- $sourceLine" >>"$file"
    file="$folder/footer.txt"
    if ! is file -- "$file"; then
        printf "%s$CC_RESET\n" "$(gettext 'Links'):\n$links" >>"$file"
    fi
    # create tsv line
    file="$folder/report.tsv"
    printf '%s\t%s\t%s\t%s\n' "$severity" "$type" "$id" "$title" >>"$file"
    # mark as expired or blocked
    is empty -- "$expired" || cat "$file" >"$folder/expired.tsv"
    [[ "$severity" = "LOW" || "$severity" = "MEDIUM" ]] || cat "$file" >"$folder/blocked.tsv"
    # prometheus
    file="$folder/prom.txt"
    if [[ "$severity" = "HIGH" || "$severity" = "CRITICAL" ]]; then
        case $severity in
        LOW) value=1 ;;
        MEDIUM) value=10 ;;
        HIGH) value=100 ;;
        CRITICAL) value=1000 ;;
        *) value=0 ;;
        esac
        printf '%s\n' "divibib_trivy_vulnerability{type=\"$type\",target=\"$target\",package=\"$pkgPath\",severity=\"$severity\",cve=\"$id\"} $value" >>"$file"
    fi
}
