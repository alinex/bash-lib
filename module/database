######################################################################################
# Mongo
######################################################################################

# Run command on Mongo DB
#
# Usage:    mongo [<options>] "" <command>            # global command
#           mongo [<options>] <database> <command>    # work in database
# Options:  h, host <host>          # destination host
# Global:   $server
#           $MONGO_ADMIN_USERPASS
mongo() {
    # parameter parsing
    local host="$server"
    eval set -- "$(option_parse $'h host +' "$@")"
    while true; do
        case "$1" in
        -h | --host) is set --name=host --die --output=host -- "$2" && shift 2 ;;
        --) shift && break ;;
        *) die "$(gettext "Unrecognized option"): $1" ;;
        esac
    done
    debug "$*"
    is integer --name=arguments --max=2 --die -- $#
    is set --name=command --die -- "$2"
    # processing
    local cluster key
    install mongosh
    # shellcheck disable=SC2001
    # shellcheck disable=SC2154
    cluster="$(sed 's/^[^.]*\.//' <<<"$host")"
    debug "Use settings for $cluster"
    command mongosh "mongodb://$(hash MONGO_ADMIN_USERPASS get "$cluster")@$host:27017/$1" \
        --eval "print(EJSON.stringify($2))"
}

