# Wait for some time or user input
#
# Usage:    pause <message>
#           <message> | pause
# Options:  T, timeout <duration>    # time after which the default will be used
#           a, abort                 # let the timeout abort by key press
# TTY:      <question> <key>
# Example:  &input#pause shows all possible use cases
pause() {
    # parameter parsing
    local timeout abort
    eval set -- "$(option_parse $'a abort -\nT timeout +' "$@")"
    while true; do
        case "$1" in
        -T | --timeout) is duration --name=timeout --die --output=timeout -- "$2" && shift 2 ;;
        -a | --abort) abort=1 && shift ;;
        --) shift && break ;;
        *) die "$(gettext "Unrecognized option"): $1" ;;
        esac
    done
    is integer --name=arguments --max=1 --die -- $#
    local text length
    text="$(input "$@")"
    # processing
    if is empty -- "$text"; then
        is set -- "$timeout" && is empty -- "$abort" && text="$(gettext 'Please wait to go on')" || text="$(gettext 'Press any key to continue...')"
    fi
    printf "${CC_NOTICE}%s${CC_RESET} ${CURSOR_STORE}" "$text"
    if is empty -- "$timeout"; then
        read -n 1 -s -r _ </dev/tty
    else
        stty -echo </dev/tty
        while ((timeout > 0)); do
            printf "${CURSOR_RESTORE}${CLEAR_EOL}%s " "$(duration_format human "$timeout")"
            if read -r -s -t 1 -n 1 _ </dev/tty; then
                if [ -n "$abort" ]; then
                    printf "$CURSOR_RESTORE%s\n" "$(gettext 'go on by user')"
                    stty echo </dev/tty
                    return 1
                fi
            fi
            ((timeout--))
            ((timeout > 0)) || printf "${CURSOR_RESTORE}${CLEAR_EOL}%s" "0s"
        done
        stty echo </dev/tty
    fi
    printf '\n'
}

# Ask a yes/no question.
#
# The default can be yes or no and if a default is set <return> will use it. Additional to a default a timeout can be set meaning to use default if timeout is reached. If an invalid character is typed, the timeout will restart.
#
# Usage:    confirm <question>
# Options:  t, true                  # default: yes
#           f, false                 # default: no
#           T, timeout <duration>    # time after which the default will be used
# TTY:      <question> [<default>]? <answer>
#           # read single characters
# Return:   0 for true/yes
#           1 for false/no
# Example:  &input#confirm shows all possible use cases
confirm() {
    # parameter parsing
    local default timeout
    eval set -- "$(option_parse $'t true -\nf false -\nT timeout +' "$@")"
    while true; do
        case "$1" in
        -t | --true) default=1 && shift ;;
        -f | --false) default=0 && shift ;;
        -T | --timeout) is duration --name=timeout --die --output=timeout -- "$2" && shift 2 ;;
        --) shift && break ;;
        *) die "$(gettext "Unrecognized option"): $1" ;;
        esac
    done
    is integer --name=arguments --max=1 --die -- $#
    local prompt
    prompt="${1:-$(gettext "Should this be done")}"
    # processing
    local char="" seq rc
    local countdown="$timeout"
    if is set -- "$default"; then
        ((default == 0)) && prompt="$prompt [$(gettext "No")]" || prompt="$prompt [$(gettext "Yes")]"
    fi
    printf "${CC_NOTICE}%s${CC_RESET} ${CURSOR_STORE}" "$prompt?" >/dev/tty
    # read input
    #stty -echo </dev/tty
    # shellcheck disable=SC2086
    # shellcheck disable=SC2229
    while IFS= read -r -s -t 1 -n 1 char </dev/tty || rc=$?; do
        # shellcheck disable=SC2059
        printf "${CLEAR_EOL}" >/dev/tty
        # check for countdown if timeout of read reached
        if ((rc == 142)); then
            rc=0
            if [ -n "$timeout" ]; then
                ((countdown--))
                if ((countdown > 0)); then
                    printf "${CURSOR_RESTORE}${CLEAR_EOL}%s" "$(duration_format human "$countdown")" >/dev/tty
                    continue
                fi
            else
                continue
            fi
        fi
        # stop maybe on enter (newline)
        if [[ $char == "" ]]; then
            # end if default is set
            if [ -n "$default" ]; then
                if ((default == 1)); then
                    printf "${CURSOR_RESTORE}${CLEAR_EOL}%s\n" "$(gettext "Yes")" >/dev/tty
                    stty echo </dev/tty
                    return 0
                else
                    printf "${CURSOR_RESTORE}${CLEAR_EOL}%s\n" "$(gettext "No")" >/dev/tty
                    stty echo </dev/tty
                    return 1
                fi
            else
                printf "${CURSOR_RESTORE}${CLEAR_EOL}${CC_RED}%s${CC_RESET}" "$(gettext 'value needed')" >/dev/tty
            fi
        # ignore escape sequences
        elif [[ $char == $'\e' ]]; then
            # Read next few characters non-blocking to drain escape sequence
            read -r -s -n 1 -t 0.01 seq
            while [[ $seq == "[" || $seq =~ [0-9A-Za-z~] ]]; do
                read -r -s -n 1 -t 0.01 seq || break
            done
        # yes
        elif [[ $char =~ [JjYy] ]]; then
            printf "${CURSOR_RESTORE}${CLEAR_EOL}%s\n" "$(gettext "Yes")" >/dev/tty
            stty echo </dev/tty
            return 0
        # no
        elif [[ $char =~ [Nn] ]]; then
            printf "${CURSOR_RESTORE}${CLEAR_EOL}%s\n" "$(gettext "No")" >/dev/tty
            stty echo </dev/tty
            return 1
        else
            printf "${CURSOR_RESTORE}${CLEAR_EOL}${CC_RED}%s${CC_RESET}" "$(gettext 'invalid character')" >/dev/tty
        fi
    done
    stty echo </dev/tty
}

