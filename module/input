# Ask for an input element
#
# This will also validate while typing if you select the correct format. So you can only input characters matching the input format.
# Possible formats are:
#
# - `string` - (default) allow anything
# - `text` - multiline text (ends with empty line)
# - `editor` - multiline text through system editor
# - `integer` or `number` - only allow [0-9]
# - `float` - allow number [0-9]+.[0-9]+ (alternative , is allowed as decimal separator)
# - `password` - will show only `*` characters to hide input
# - `time` - a time with hour and minute can be given
#
# If another format is needed, you can fall back to string and validate on your own after you got the response.
#
# Usage:    ask <format> <question>
# Options:  e, empty                 # allow empty value
#           n, allow-negative        # on number, integer, float
#           d, default <value>       # set default if none given
#           T, timeout <duration>    # time till default is used
# TTY:      <question> <valid characters>...
#           # input <keys> printed if valid
# Output:   <answer>
# Example:  &input#ask shows all possible use cases
ask() {
    # parameter parsing
    local default empty negative timeout
    eval set -- "$(option_parse $'e empty -\nd default +\nT timeout +\nn allow-negative -' "$@")"
    while true; do
        case "$1" in
        -e | --empty) empty=1 && shift ;;
        -d | --default) default="$2" && shift 2 ;;
        -T | --timeout) is duration --name=timeout --die --output=timeout -- "$2" && shift 2 ;;
        -n | --allow-negative) negative=1 && shift ;;
        --) shift && break ;;
        *) die "$(gettext "Unrecognized option"): $1" ;;
        esac
    done
    is integer --name=arguments --max=2 --die -- $#
    is empty -- "$1" || is enum --name=format --allow="string integer number float password time text editor" --die -- "$1"
    local prompt pattern mask
    local format="$1"
    # processing
    case $format in
    #string) prompt="${2:-$(gettext "Enter short line")}" ;; # is done through default
    integer | number)
        prompt="${2:-$(gettext "Enter integer number")}"
        if [ -n "$negative" ]; then
            pattern="^(0|-?([1-9][0-9]*)?)$"
            final="^-?[0-9]+$"
        else
            pattern="^(0|[1-9][0-9]*)$"
        fi
        ;;
    float)
        prompt="${2:-$(gettext "Enter float number")}"
        if [ -n "$negative" ]; then
            pattern="^(0|-?([1-9][0-9]*)?)(\.[0-9]*)?$"
            final="^(0|-?[1-9][0-9]*)(\.[0-9]+)?$"
        else
            pattern="^(0|[1-9][0-9]*)(\.[0-9]*)?$"
            final="^(0|[1-9][0-9]*)(\.[0-9]+)?$"
        fi
        ;;
    password)
        prompt="${2:-$(gettext "Enter password")}"
        mask=1
        ;;
    time)
        prompt="${2:-$(gettext "Enter time")}"
        pattern="^([0-1]?[0-9]|2[0-3])(:([0-5]?[0-9])?)?$"
        final="^([0-1][0-9]|2[0-3]):[0-5][0-9]$"
        ;;
    text) prompt="${2:-$(gettext "Enter text (end with empty line)")}" ;;
    editor) prompt="${2:-$(gettext "Enter text here")}" ;;
    *) prompt="${2:-$(gettext "Enter short line")}" ;;
    esac
    local input="" char="" seq i_text q
    local countdown="$timeout"
    local nl=$'\n'
    [ -z "$default" ] && [ -z "$empty" ] || prompt="$prompt [$default]"
    # external editor
    if [ "$format" = "editor" ]; then
        notice "$(gettext "Input through system editor...")"
        # shellcheck disable=SC2154
        EDITOR=$(first "$VISUAL" "$EDITOR" vi)
        while true; do
            sleep 2
            local answer
            answer="$(mktemp --random editor)"
            printf '%s\n' "$prompt" >"$answer"
            if [ -n "$timeout" ]; then
                debug timeout "$timeout" "$EDITOR" "$answer"
                $EDITOR "$answer" &
                sleep "$timeout"
                pkill -TERM -P $! || true
                stty sane
            else
                $EDITOR "$answer"
            fi
            input=$(grep -v -F "$prompt" "$answer") || true
            rm "$answer"
            debug "got: $input"
            [ -n "$input" ] || [ -z "$default" ] || input="$default"
            debug "maybe use default: $input"
            [ -z "$empty" ] || break
            [ -z "$input" ] || break
        done
        printf '%s\n' "$input"
        return 0
    fi
    # Read one character at a time silently (-s), without newline (-n 1)
    printf "${CC_NOTICE}%s: ${CC_RESET}" "$prompt" >/dev/tty
    stty -echo </dev/tty
    # shellcheck disable=SC2229
    # shellcheck disable=SC2086
    while IFS= read -r -s -t 1 -n 1 char </dev/tty || rc=$?; do
        # shellcheck disable=SC2059
        printf "${CLEAR_EOL}" >/dev/tty
        # check for countdown if timeout of read reached
        if ((rc == 142)); then
            rc=0
            if [ -n "$timeout" ]; then
                ((countdown--))
                if ((countdown > 0)); then
                    printf "${CURSOR_STORE}   %s${CURSOR_RESTORE}" "$(duration_format human "$countdown")" >/dev/tty
                    continue
                fi
            else
                continue
            fi
        fi
        # stop maybe on enter (newline)
        if [[ $char == "" ]]; then
            # end text
            if [ -n "$input" ] && [ "$format" = "text" ] && [[ ! "$input" == *"$nl" ]]; then
                input+=$'\n'
                printf '\n'
            # end if final pattern reached
            elif [ -n "$final" ]; then
                if [[ "$input" =~ $final ]]; then
                    # shellcheck disable=SC2059
                    printf '\n' >/dev/tty
                    break
                else
                    printf "${CURSOR_STORE}   ${CC_RED}%s${CC_RESET}${CURSOR_RESTORE}" "$(gettext 'incomplete')" >/dev/tty
                fi
            # end if input done
            elif [ -n "$input" ]; then
                # shellcheck disable=SC2059
                printf "${CLEAR_EOL}\n" >/dev/tty
                break
            # end if default possible
            elif [ -n "$default" ]; then
                # shellcheck disable=SC2059
                input="$default"
                # shellcheck disable=SC2059
                printf "${CLEAR_EOL}\n" >/dev/tty
                break
            # end if empty allowed
            elif [ -n "$empty" ]; then
                printf '\n' >/dev/tty
                break
            else
                printf "${CURSOR_STORE}   ${CC_RED}%s${CC_RESET}${CURSOR_RESTORE}" "$(gettext 'value needed')" >/dev/tty
            fi
        # Handle backspace
        elif [[ $char == $'\177' ]]; then
            if [ ${#input} -gt 0 ]; then
                input=${input:0:-1}
                printf '%s' "\b \b" >/dev/tty
            fi
        # ignore escape sequences
        elif [[ $char == $'\e' ]]; then
            # Read next few characters non-blocking to drain escape sequence
            read -r -s -n 1 -t 0.01 seq
            while [[ $seq == "[" || $seq =~ [0-9A-Za-z~] ]]; do
                read -r -s -n 1 -t 0.01 seq || break
            done
        # next character
        else
            if [ -n "$pattern" ]; then
                debug 7 "$(od -An -to1 -v <<<"$char") [[ \"$input$char\" =~ $pattern ]] $([[ "$input$char" =~ $pattern ]] && printf 'true\n' || printf 'false\n')"
                # alternative decimal point
                if [ "$format" = "float" ] && [ "$char" = "," ]; then
                    char=.
                fi
                if [[ ! "$input$char" =~ $pattern ]]; then
                    printf "${CURSOR_STORE}   ${CC_RED}%s${CC_RESET}${CURSOR_RESTORE}" "$(gettext 'invalid character')" >/dev/tty
                    continue
                fi
            fi
            input+="$char"
            [ -n "$mask" ] && printf '*' >/dev/tty || printf '%s' "$char" >/dev/tty
            if [ "$format" = "password" ]; then
                q=$(_password_strength "$input")
                if ((q < 25)); then
                    i_text="${CC_RED}$(gettext 'bad')${CC_RESET}"
                elif ((q < 50)); then
                    i_text="${CC_YELLOW}$(gettext 'weak')${CC_RESET}"
                elif ((q < 75)); then
                    i_text="$(gettext 'good')"
                else
                    i_text="${CC_GREEN}$(gettext 'strong')${CC_RESET}"
                fi
                printf '${CURSOR_STORE}   %s${CURSOR_RESTORE}' "$i_text" >/dev/tty
            fi
        fi
    done
    stty echo </dev/tty
    debug 4 "Octal result: $(od -An -to1 -v <<<"$input")"
    # return input
    [ "$format" != "text" ] || input="$(grep -v '^[[:space:]]*$' <<<"$input")"
    printf '%s\n' "$input"
}

# Calculate password strength
#
# Usage:    _password_strength <password>
# Output:   <int> 0 (weakest) up to 100 (strongest)
_password_strength() {
    local password="$1"
    local len=${#password}
    local score=0
    # +4 per char (up to 40 points)
    ((score += len * 4))
    ((score = score > 40 ? 40 : score))
    debug 7 "len $score"
    # character variety
    [[ "$password" =~ [a-z] ]] && ((score += 5))
    [[ "$password" =~ [A-Z] ]] && ((score += 5))
    [[ "$password" =~ [0-9] ]] && ((score += 5))
    [[ "$password" =~ [^a-zA-Z0-9] ]] && ((score += 5))
    debug 7 "variety $score"
    # uniqueness bonus - number of different characters
    local unique
    unique=$(printf '%s' "$password" | fold -w1 | sort -u | wc -l)
    ((score += unique * 2))
    ((score = score > 100 ? 100 : score))
    debug 7 "uniqueness $score"
    # penalties for patterns
    local check
    for check in password qwerty qwertz; do
        [[ "${password,,}" =~ $check ]] && ((score -= 40))
    done
    for check in 123 456 789 abc def ghi jkl mno pqr stv xyz; do
        [[ "${password,,}" =~ $check ]] && ((score -= 15))
    done
    [[ "$password" =~ (.)\1{2,} ]] && ((score -= 10))
    ((score = score < 0 ? 0 : score))
    debug 7 "penalties $score"
    printf '%s' "$score"
}

# Select from list (extended version of native select)
#
# The given list will be printed as numerical options from which you select one by typing it's number. Number validation is on, so you can only input a valid number. No return-key needed if the full number is given.
# Each list entry can be a single `<text>` or `<key>|<name>` while the `<name>` is shown the `<key>` will be returned if selected.
#
# With the options a default can be given, which will be selected using return-key or a timeout till this is used.
# With the option `--exit` the additional entry will break by returning `exit`.
#
# Usage:    choose [-t] <entry>...
#           <list> | choose [-t]
# Options:  t, title <title>         # display text line above selection
#           x, exit <string>         # will add an exit option at the end -> return "exit"
#           d, default <string|int>  # the command or number which will be returned on <enter>
#           T, timeout <duration>    # timeout till default selection as seconds or duration @duration_format
# Entry:    <entry> := <string> | <key> "|" <display> # whitespace around values are removed
# TTY:      [<title>]
#           <list>
#           ...
#           <question> <key>
# Output:   selected `<line>`
# Return:   `exit 0` # if run with `--exit` and this was chosen
# Example:  &input#choose shows all possible use cases
# TODO > 10 entries make two columns using
choose() {
    # parameter parsing
    local end default timeout
    eval set -- "$(option_parse $'t title +\nx exit +\nd default +\nT timeout +' "$@")"
    while true; do
        case "$1" in
        -t | --title) notice "$2" >/dev/tty && shift 2 ;;
        -d | --default) default="$2" && shift 2 ;;
        -x | --exit) end="$2" && shift 2 ;;
        -T | --timeout) is duration --name=timeout --die --output=timeout -- "$2" && shift 2 ;;
        --) shift && break ;;
        *) die "$(gettext "Unrecognized option"): $1" ;;
        esac
    done
    local list max length
    list="$(input_lines "$@")"
    list="$(trim "$list" | grep -v ^#)"
    max="$(wc -l <<<"$list")"
    length="${#max}"
    # output list
    local line key display num=0 pattern
    while read -r line; do
        num=$((num + 1))
        IFS="|" read -r key display <<<"$line"
        if [ -n "$default" ]; then
            [ "$default" = "$(trim "$key")" ] && default="$num" || true
            [ "$default" = "$(trim "$display")" ] && default="$num" || true
        fi
        printf "  %0${length}d) $(trim "${display:-$key}")\n" "$num" >/dev/tty
    done <<<"$list"
    is empty -- "$default" || is integer -- "$default" || die "Default option $default not recognized."
    [ -z "$end" ] || printf "  %${length}s) ${end}\n" x >/dev/tty
    # Pattern example parts:
    # 8      [1-8]
    # 78    0[1-9]                      [1-6][0-9]                7[0-8]
    # 345  00[1-9]   0[1-9][0-9]   [1-2][0-9][0-9]  3[0-3][0-9]  34[0-5]
    if ((length == 1)); then
        pattern="[1-$max]"
    elif ((length == 2)); then
        pattern="0[1-9]?|"
        ((${max:0:1} == 1)) || pattern+="[1-$((${max:0:1} - 1))][0-9]?|"
        pattern+="${max:0:1}[0-${max:1:1}]?"
    elif ((length == 3)); then
        pattern="0(0[1-9]?)?|0([1-9][0-9]?)?|"
        ((${max:0:1} == 1)) || pattern+="[1-$((${max:0:1} - 1))]([0-9][0-9]?)?|"
        pattern+="${max:0:1}([0-$((${max:1:1} - 1))][0-9]?)?|"
        pattern+="${max:0:1}(${max:1:1}[0-${max:3:1}]?)?"
    else
        pattern="[0-9]*"
    fi
    ((length == 1)) || pattern="(0|$pattern)"
    [ -z "$end" ] || pattern="(x|$pattern)"
    pattern="^$pattern$"
    # question
    local input="" char=""
    local countdown="$timeout"
    # shellcheck disable=SC2155
    local question="$(gettext "Select one of the above options")"
    [ -z "$default" ] && timeout="" || question="$question [$default]"
    printf '%s: ' "$question" >/dev/tty
    stty -echo </dev/tty
    # shellcheck disable=SC2086
    # shellcheck disable=SC2229
    while read -r -s -t 1 -n 1 char </dev/tty || rc=$?; do
        # shellcheck disable=SC2059
        printf "${CLEAR_EOL}" >/dev/tty
        # check for countdown if timeout of read reached
        if ((rc == 142)); then
            rc=0
            if [ -n "$timeout" ]; then
                ((countdown--))
                if ((countdown > 0)); then
                    printf "${CURSOR_STORE}   %s${CURSOR_RESTORE}" "$(duration_format human "$countdown")" >/dev/tty
                    continue
                fi
            else
                continue
            fi
        fi
        # stop maybe on enter (newline)
        if [[ $char == "" ]]; then
            # end if number completed TODO
            if [ -n "$final" ]; then
                # shellcheck disable=SC2059
                printf "${CLEAR_EOL}\n" >/dev/tty
                break
            # end if input done
            elif [ -n "$input" ]; then
                # shellcheck disable=SC2059
                printf "${CLEAR_EOL}\n" >/dev/tty
                break
            # end if default possible
            elif [ -n "$default" ]; then
                input="$default"
                # shellcheck disable=SC2059
                printf "${CLEAR_EOL}\n" >/dev/tty
                break
            else
                printf "${CURSOR_STORE}   %s${CURSOR_RESTORE}" "$(gettext 'value needed')" >/dev/tty
            fi
        # Handle backspace
        elif [[ $char == $'\177' ]]; then
            if [ ${#input} -gt 0 ]; then
                input=${input:0:-1}
                printf '\b \b' >/dev/tty
            fi
        # ignore escape sequences
        elif [[ $char == $'\e' ]]; then
            # Read next few characters non-blocking to drain escape sequence
            read -r -s -n 1 -t 0.01 seq || true
            while [[ $seq == "[" || $seq =~ [0-9A-Za-z~] ]]; do
                read -r -s -n 1 -t 0.01 seq || break
            done
        # exit
        elif [ -n "$end" ] && [[ "$char" =~ [xX] ]]; then
            printf '%s\n' "$char" >/dev/tty
            printf 'exit'
            stty echo </dev/tty
            return 0
        # next character
        else
            if [[ ! "$input$char" =~ $pattern ]]; then
                printf "${CURSOR_STORE}   ${CC_RED}%s${CC_RESET}${CURSOR_RESTORE}" "$(gettext 'invalid character')" >/dev/tty
                continue
            fi
            input+="$char"
            printf '%s' "$char" >/dev/tty
            # completed number
            if ((${#input} == length)); then
                printf '\n' >/dev/tty
                break
            fi
        fi
    done
    stty echo </dev/tty
    sed -n "${input}p" <<<"$list" | sed 's/\s*|.*//'
}

# Run tasks as selected by user
#
# Often the functions are also named `check-...` for the ones which will return tasks and `task-...` for the ones really doing the job. The first one may do a lot of analyzation and output user information on stdout.
# The '|' character is not possible within the commands. If a pipe is necessary put it within a function. Also some commands can be disabled in the list by preceding the command with an `#` character.
#
# If there are no tasks defined or the dynamic list will return no tasks it will end with a success message.
#
# Usage:    tasks <entry>...
#           # <entry>       := <check-fn> or "<task-line>"
#           # <check-fn>    := function called to return up to multiple <task-lines>
#           # <task-fn>     := function to be run when selected
#           # <task-line>   := "<task-fn> | <name>"
#           <task-lines> | tasks            # entries from pipe
#           tasks <check-fn>                # add entries from function (dynamic)
# Option    t, title <title>             # display text line above selection
#           d, default <string|int|variable>  # default command to start
#           T, timeout <sec>             # timeout till default selection
# Files:    `/dev/shm/<program>_tasks_<pid>` will be used while dynamically generating the tasks list and removed afterwards
# TTY:      Nächste Schritte
#              1) Analyse einzelner Partitionen
#              2) Docker aufräumen mit etwa 206MB unter /data
#              3) Remote Host Console (interaktiv)
#              x) Beenden
#           Wähle eine der obigen Optionen: [1]
# Example:  &tasks different possibilities
tasks() {
    # parameter parsing
    local end title _default opt loop raw
    eval set -- "$(option_parse $'t title +\nd default +\nT timeout +\nl loop -' "$@")"
    while true; do
        case "$1" in
        -t | --title) title="-t$2" >/dev/tty && shift 2 ;;
        -d | --default) _default="$2" >/dev/tty && shift 2 ;;
        -T | --timeout) is duration --name=timeout --die -- "$2" && opt="-T $2 " && shift 2 ;;
        -l | --loop) loop=1 && shift ;;
        --) shift && break ;;
        *) die "$(gettext "Unrecognized option"): $1" ;;
        esac
    done
    raw="$(input_lines "$@" | grep -v '^[[:space:]]*#')" || true
    # processing
    local list task num new_list cmd name
    find /dev/shm -regex ".*/$0_tasks_[0-9]*" -mmin +60 -delete 2>/dev/null || true # cleanup broken runs
    new_list="$(mktemp -m "tasks_$$")"
    # ask user to select
    while true; do
        list="$raw"
        # check for dynamic parts in list
        while grep -qv '|' <<<"$list"; do
            : >"$new_list"
            # resolve dynamic parts
            while IFS= read -r line; do
                IFS='|' read -r cmd name <<<"$line"
                if [ -n "$name" ]; then
                    printf '%s\n' "$line" >>"$new_list"
                else
                    $cmd </dev/null >>"$new_list" || die "$(gettext "Could not get task list from command"): $cmd"
                fi
            done <<<"$list"
            list="$(sed '/^[[:space:]]*$/d' "$new_list")"
            rm "$new_list"
            # list is empty
            if [ -z "$list" ]; then
                ok "$(gettext "No tasks found to be executed.")"
                return
            fi
        done
        _default="$(value_if_variable "$_default")"
        # shellcheck disable=SC2086
        task=$(choose "$title" -x "$(gettext "Exit")" $opt -d "$_default" "$list" </dev/null)
        #task="$(uncolorize "$task")"
        [[ "$task" != "exit" ]] || break
        local error
        # shellcheck disable=SC2034
        if ! eval "$task"; then
            error=$?
            die "$(eval_gettext "Got error \$error running \$task")"
        fi
        printf '\n'
        [ -n "$loop" ] || break
    done
}
