option_parse(){
local opt name type desc short="" long=""
local spec="$1" permut
if [[ $spec =~ ^\+ ]];then
permut=+
spec="${spec:1}"
fi
while IFS=$' \t\n' read -r opt name type desc;do
[[ $opt =~ ^# ]]&&continue
[[ -z $opt ]]&&continue
if [ ! "$type" = "-" ];then
[ "$opt" = "-" ]||short+="$opt:"
long+="$name:,"
else
[ "$opt" = "-" ]||short+="$opt"
long+="$name,"
fi
done <<<"$spec"
shift
getopt -o "$permut$short" --long "$long" -n "$0" -- "$@"
}
option_help(){
declare opt name type desc
declare -A opt_descriptions
declare -A opt_type
declare -A opt_short
while read -r opt name type desc;do
[[ $opt =~ ^# ]]&&continue
[[ -z $opt ]]&&continue
opt_descriptions[$name]="$desc"
opt_type[$name]=$type
opt_short[$name]=$opt
done <<<"$1"
echo "$(gettext "Options"):"
for name in "${!opt_descriptions[@]}";do
local type_text=""
local short_text=""
if [ ! "${opt_type[$name]}" = "-" ];then
type_text=" <${opt_type[$name]}>"
fi
if [[ ! ${opt_short[$name]} == "-" ]];then
short_text="-${opt_short[$name]}$type_text, "
fi
printf "  %-40s %s\n" "$short_text--$name$type_text" "${opt_descriptions[$name]}"
done
}
input(){
test -p /dev/stdin&&(($#==0))&&cat -||echo "$*"
}
input_args(){
local num=${1-}
local start=$((num+2))
[ -n "$num" ]||die "$(gettext "No <num> argument in call to input_args!")"
((num>0))||die "<num>=$num $(gettext 'argument is not a valid number!')"
test -p /dev/stdin&&cat -||echo "${@:start}"
}
input_lines(){
if [ -p /dev/stdin ]&&[ -z "${1-}" ];then
cat -
else
for arg in "$@";do echo "$arg";done
fi
}
escape_args(){
local escaped_args=()
for arg in "$@";do
escaped_args+=("$(printf '%q' "$arg")")
done
echo "${escaped_args[*]}"
}
contains(){
_deprecated "use array <array-name> has <value>" warn
array "$1" has "$2"
}
array(){
declare -n arr="$1"
local cmd=$2
local value="$3"
case "$cmd" in
has)for e in "${arr[@]}"
do
[ ! "$e" = "$value" ]||return 0
done
return 1
;;
indexof)for i in "${!arr[@]}"
do
if [ "${arr[i]}" = "$value" ];then
echo "$i"
return 0
fi
done
return 1
;;
*)die "Usage: array <array_name> {has|index} [<value>]"
esac
}
join(){
local -n array=$1
local sep="${2:-,}"
local joined="${array[0]}"
for element in "${array[@]:1}";do
joined+="$sep$element"
done
echo "$joined"
}
split(){
local string="$1"
local -n array=$2
local sep="${3:-,}"
IFS="$sep" read -ra array <<<"$string"
}
hash(){
num_parameters --min 3 --max 4 --die "Hash needs two to three parameters: Usage hash <array-name> <cmd> <key> [<value>]" "$@"
declare -n arr="$1"
local cmd=$2
local key="${3//[^a-zA-Z0-9_]/_}"
local value=$4
case "$cmd" in
set)arr["$key"]="$value";;
get)echo "${arr[$key]}";;
unset)unset 'arr[$key]';;
has)[[ -v arr[$key] ]];;
*)die "Usage: hash <array_name> {set|get|unset|has} <key> [<value>]"
esac
}
