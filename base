}
is_empty(){
num_parameters --max 1 --die "Only one argument allowed, got: $#" -- "$@"
[ -z "$1" ]
}
is_integer(){
num_parameters --min 1 --max 1 --die "Only one argument allowed, got: $#" -- "$@"
[[ $1 =~ ^-?[0-9]+$ ]]
}
is_float(){
num_parameters --min 1 --max 1 --die "Only one argument allowed, got: $#" -- "$@"
[[ $1 =~ ^[-+]?[0-9]+([.][0-9]+)?$ ]]
}
trim_start(){
local str="${1-}"
local char="${2:-[:space:]}"
echo "${str#"${str%%[!$char]*}"}"
}
trim_end(){
local str="${1:-}"
local char="${2:-[:space:]}"
echo "${str%"${str##*[!$char]}"}"
}
trim(){
trim_end "$(trim_start "$1" "$2")" "$2"
}
to_alphanum(){
local text
text="$(input "$@")"
echo "${text//[^a-zA-Z0-9_]/_}"
}
value_if_variable(){
local _name="$1"
if [[ $_name =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]]&&[ -n "${!_name-}" ];then
echo "${!_name}"
else
echo "$_name"
fi
}
