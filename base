trap_add(){
local new="$1"
local sig="$2"
local old
old="$(trap -p "$sig"|awk -F"'" '{print $2}')"
if [[ -n $old ]];then
trap "$new; $old" "$sig"
else
trap "$new" "$sig"
fi
}
trap_remove(){
local remove="$1"
local sig="$2"
local current new
debug 3 "remove $remove from $sig"
current="$(trap -p "$sig"|awk -F"'" '{print $2}')"
new="$(echo "$current"|sed "s#;* *$remove##")"
trap "$new" "$sig"
}
mktemp(){
eval set -- "$(option_parse $'d directory -\ne extension +\nm memory -\np path +\nr random -\nT ttl +' "$@")"
local dir ext result rand
local path=${TMPDIR:-/tmp}
while true;do
case "$1" in
-d|--directory)dir=1
shift
;;
-e|--extension)ext=".$2"
shift 2
;;
-m|--memory)path="/dev/shm"
shift
;;
-p|--path)path="$2"
shift 2
;;
-r|--random)rand=$RANDOM
shift
;;
-T|--ttl)ttl="$(duration_format seconds "$2")"
shift 2
;;
--)shift
break
;;
*)shift
esac
done
local ident
[ -n "$1" ]&&ident="_$1"
result="$path/$(basename "$0")$ident$rand$ext"
if [ -n "$rand" ];then
while [ -e "$result" ];do
result="$path/$(basename "$0")$ident$RANDOM$ext"
done
fi
if [ -e "$result" ];then
debug "already exists $result"
else
if [ -n "$dir" ];then
debug "create dir $result"
mkdir -p "$result"
else
debug "create file $result"
touch "$result"
fi
fi
echo "$result"
[ -z "$ttl" ]||(_rmtemp "$ttl" "$result" >/dev/null 2>&1&
disown)
}
_rmtemp(){
local wait="$1" file="$2"
while [ -e "$result" ]&&((wait>0));do
sleep 1
((wait--))
done
[ ! -e "$result" ]||rm -r "$result"
debug "Removed $file after TTL $1 seconds"
}
CURL_HTTP_CODE=""
curl(){
local args=("$@")
local file res
array args has '-o'||file=$(mktemp -r)
local opt
[ -z "$file" ]||opt="-o $file"
debug "command curl -s -w \"Error: %{url_effective} with RC:%{http_code}\" $opt -L $(escape_args "$@")"
res=$(command curl -s -w "%{url_effective} with RC:%{http_code}" $opt -L "$@"|tail -1)
debug "Response: $res"
CURL_HTTP_CODE=${res: -3}
if [[ $CURL_HTTP_CODE =~ ^2[0-9]{2}$ ]];then
if [ -n "$file" ];then
cat "$file"
rm "$file"
fi
else
if [ -n "$file" ];then
jq . "$file" >&2 2>/dev/null||cat "$file" >&2
rm "$file"
fi
error "Error: $res" >&2
return 1
fi
}
num_parameters(){
eval set -- "$(option_parse $'- min +\n- max +\n- die +' "$@")"
local min max die
while true;do
case "$1" in
--min)min=$2
shift 2
;;
--max)max=$2
shift 2
;;
--die)die=$2
shift 2
;;
--)shift
break
;;
*)die "$(gettext "Unrecognized option"): $1"
esac
done
_die(){
read -r line func file <<<"$(caller 1)"
echo "Check ${FUNCNAME[1]}: $1 ($func in $file:$line)" >&2
[ -z "$die" ]||die "$die"
return 1
}
[ -z "$min" ]||(($#>=min))||_die "[$*] $# < $min (min)"||return 1
[ -z "$max" ]||(($#<=max))||_die "[$*] $# > $max (max)"||return 1
}
is_success(){
num_parameters --min 1 --max 1 --die "Only one argument allowed, got: $#" -- "$@"
