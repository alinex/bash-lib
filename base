urlencode(){
install jq
input "$@"|jq -sRr @uri|sed 's/%0A$//'
}
erase_line(){
is integer --name=arguments --max=0 --die -- $#
printf '%b' $'\e[1K\r'
}
horizontal_line(){
is integer --name=arguments --max=1 --die -- $#
is empty -- "$1"||is enum --name=format --allow="light bold double half full"--die -- "$1"
local char
case $1 in
bold)char="━";;
double)char="═";;
half)char="▄";;
full)char="█";;
*)char="─"
esac
local cols
read -r _ cols < <(stty size)
((cols>60))||cols=60
printf "%.0s$char" $(seq 1 "$cols")
}
_spinner_pid=""
spinner_start(){
is integer --name=arguments --max=2 --die -- $#
is empty -- "$1"||is enum --name=format --allow="simple arrows vertical bar fade braille roll moon clock weather" --die -- "$1"
if ! command -v tput >/dev/null 2>&1||[ ! -t 2 ];then
debug "Disabled because tput and terminal is needed"
return 0
fi
local format="${1:-braille}"
local spinner
local size=1
local chars=1
local delay=${2:-0.2}
case $format in
arrows)spinner='→↑←↓';;
vertical)spinner='▏▎▍▌▋▊▉█▉▊▋▌▍▎▏';;
bar)spinner='▏ ▎ ▍ ▌ ▋ ▊ ▉ █ █▏█▎█▍█▌█▋█▊█▉███▉█▊█▋█▌█▍█▎█▏█ ▉ ▊ ▋ ▌ ▍ ▎ ▏ '&&chars=2&&size=2;;
fade)spinner=' ░▒▓█▓▒░';;
braille)spinner='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏';;
roll)spinner='⠋⠙⠚⠞⠖⠦⠴⠲⠳⠓';;
moon)spinner='🌑🌒🌓🌔🌕🌖🌗🌘'&&size=2;;
clock)spinner='🕐🕑🕒🕓🕔🕕🕖🕗🕘🕙🕚🕛'&&size=2;;
weather)spinner='🌤🌥🌦🌧🌨🌩🌪';;
*)spinner='-\|/'
esac
local back=$((size+1))
printf '\e[?25l'
(while
true
do
for ((i=0; i<${#spinner}; i+=chars));do
printf " %s%s" "${spinner:i:chars}" "$(printf '\b%.0s' $(seq 1 "$back"))" >/dev/tty
sleep "$delay"
done
done) \
&
_spinner_pid=$!
disown
}
spinner_stop(){
is integer --name=arguments --max=0 --die -- $#
[ -n "$_spinner_pid" ]||return
kill "$_spinner_pid" >/dev/null 2>&1
wait "$_spinner_pid" 2>/dev/null
_spinner_pid=""
printf "    \b\b\b\b"
printf '\e[?25h'
}
check(){
eval set -- "$(option_parse $'n name +\nd die -\ns sanitize -\n- min +\n- max +\n- allow +' "$@")"
local name die sanitize min max allow
while true;do
case "$1" in
-n|--name)name="$2"&&shift 2;;
-d|--die)die=1&&shift;;
-s|--sanitize)sanitize=1&&shift;;
--min)[[ $2 =~ ^[-+]?[0-9]+([.][0-9]+)?$ ]]&&min="$2"&&shift 2||die "$(printf "$(gettext "Parameter %s needs number")" min)";;
--max)[[ $2 =~ ^[-+]?[0-9]+([.][0-9]+)?$ ]]&&max="$2"&&shift 2||die "$(printf "$(gettext "Parameter %s needs number")" max)";;
--allow)[ -n "$2" ]&&allow="$2"&&shift 2||die "$(gettext "A list of words is needed")";;
--)shift&&break;;
*)die "$(gettext "Unrecognized option"): $1"
esac
done
name="${name:-argument}"
local usage
usage="$(gettext "Incorrect call"): is <check> <value> [options]"
[ -n "$1" ]&&local check="$1"||die "$usage"
local val="$2" res="$2"
case $check in
set)if
[ -z "$val" ]
then
[ -z "$die" ]&&return 1||die "$(eval_gettext 'The "$name" has to be set with a value')"
fi
;;
empty)if
[ -n "$val" ]
then
[ -z "$die" ]&&return 1||die "$(eval_gettext 'The "$name" has to be empty but has »${val}«')"
fi
;;
bool)if
[[ ${val,,} =~ ^(true|t|1|yes|y|ja|j)$ ]]
then
res=1
elif [[ -z $val || ${val,,} =~ ^(false|f|0|no|n|nein)$ ]];then
res=0
else
[ -z "$die" ]&&return 1||die "$(eval_gettext 'The value »${val}« for "$name" could not be read as true or false')"
fi
;;
integer)if
[ -n "$sanitize" ]
then
[[ $val =~ ^(-?[0-9]+) ]]&&res="${BASH_REMATCH[1]}"||true
fi
if [[ ! $res =~ ^-?[0-9]+$ ]];then
[ -z "$die" ]&&return 1||die "$(eval_gettext 'The "$name" has to be an integer but »${val}« was given')"
fi
if [[ -n $min ]]&&[[ $min == "$max" ]];then
if ((res!=min));then
[ -z "$die" ]&&return 1||die "$(eval_gettext 'The "$name" has to be exactly $min but »${val}« was given')"
fi
elif [[ -n $min && -n $max ]];then
if ((res<min||res>max));then
[ -z "$die" ]&&return 1||die "$(eval_gettext 'The "$name" has to be between $min and $max but »${val}« was given')"
fi
elif [[ -n $min ]];then
if ((res<min));then
[ -z "$die" ]&&return 1||die "$(eval_gettext 'The "$name" has to at least $min but »${val}« was given')"
fi
elif [[ -n $max ]];then
if ((res>max));then
[ -z "$die" ]&&return 1||die "$(eval_gettext 'The "$name" has to not be more than $max but »${val}« was given')"
fi
fi
;;
float)if
[ -n "$sanitize" ]
then
[[ $val =~ ^(-?[0-9]+([.][0-9]+)?) ]]&&res="${BASH_REMATCH[1]}"||true
fi
if [[ ! $res =~ ^-?[0-9]+([.][0-9]+)?$ ]];then
[ -z "$die" ]&&return 1||die "$(eval_gettext 'The "$name" has to be a float but »${val}« was given')"
fi
if [[ -n $min ]]&&[[ $min == "$max" ]];then
if ((res!=min));then
[ -z "$die" ]&&return 1||die "$(eval_gettext 'The "$name" has to be exactly $min but »${val}« was given')"
fi
elif [[ -n $min && -n $max ]];then
if ((res<min||res>max));then
[ -z "$die" ]&&return 1||die "$(eval_gettext 'The "$name" has to be between $min and $max but »${val}« was given')"
fi
elif [[ -n $min ]];then
if ((res<min));then
[ -z "$die" ]&&return 1||die "$(eval_gettext 'The "$name" has to at least $min but »${val}« was given')"
fi
elif [[ -n $max ]];then
if ((res>max));then
[ -z "$die" ]&&return 1||die "$(eval_gettext 'The "$name" has to not be more than $max but »${val}« was given')"
fi
fi
;;
length)val=${#val}
if [[ -n $min ]]&&[[ $min == "$max" ]];then
if ((res!=min));then
[ -z "$die" ]&&return 1||die "$(eval_gettext 'The length of "$name" has to be exactly $min but »${res}« is $val characters long')"
fi
elif [[ -n $min && -n $max ]];then
if ((val<min||val>max));then
[ -z "$die" ]&&return 1||die "$(eval_gettext 'The length of "$name" has to be between $min and $max but »${res}« is $val characters long')"
fi
elif [[ -n $min ]];then
if ((val<min));then
[ -z "$die" ]&&return 1||die "$(eval_gettext 'The length of "$name" has to be at least $min but »${res}« is $val characters long')"
fi
elif [[ -n $max ]];then
if ((val>max));then
[ -z "$die" ]&&return 1||die "$(eval_gettext 'The length of "$name" has to be not more than $max but »${res}« is $val characters long')"
fi
fi
;;
enum)[ -n "$allow" ]||die "$(gettext "A list with --allow=<words> is needed for enum check")"
if [[ " $allow " != *" $val "* ]];then
[ -z "$die" ]&&return 1||die "$(eval_gettext '"$name" is set to "${val}" but has to be one of: $allow')"
fi
;;
duration)[[ $res =~ ^-?[0-9] ]]&&res="$(duration_format seconds "$val")"||true
if [[ ! $res =~ ^-?[0-9]+$ ]];then
[ -z "$die" ]&&return 1||die "$(eval_gettext 'The "$name" has to be an integer or human duration but »${val}« was given')"
fi
;;
path)if
[ ! -e "$val" ]
then
[ -z "$die" ]&&return 1||die "$(eval_gettext 'The "$name" ${val} has to be an existing path')"
fi
;;
file)if
[ ! -f "$val" ]
then
[ -z "$die" ]&&return 1||die "$(eval_gettext 'The "$name" ${val} has to be an existing file')"
fi
;;
directory)if
[ ! -d "$val" ]
then
[ -z "$die" ]&&return 1||die "$(eval_gettext 'The "$name" ${val} has to be an existing directory')"
fi
;;
readable)if
[ ! -r "$val" ]
then
[ -z "$die" ]&&return 1||die "$(eval_gettext 'The "$name" ${val} has to be a file readable for user')"
fi
;;
writable)if
[ ! -w "$val" ]
then
[ -z "$die" ]&&return 1||die "$(eval_gettext 'The "$name" ${val} has to be a file writable for user')"
fi
;;
*)die "$(eval_gettext 'A check named ${check} is not defined')"
esac
echo "$res"
}
is(){
check "$@" >/dev/null
}
num_parameters(){
_deprecated "Use: is integer $# --min=<val> --max=<val>" warn
eval set -- "$(option_parse $'- min +\n- max +\n- die +' "$@")"
local min max die
while true;do
case "$1" in
--min)min=$2
shift 2
;;
--max)max=$2
shift 2
;;
--die)die=$2
shift 2
;;
--)shift
break
;;
*)die "$(gettext "Unrecognized option"): $1"
esac
done
_die(){
read -r line func file <<<"$(caller 1)"
echo "Check ${FUNCNAME[1]}: $1 ($func in $file:$line)" >&2
[ -z "$die" ]||die "$die"
return 1
}
[ -z "$min" ]||(($#>=min))||_die "[$*] $# < $min (min)"||return 1
[ -z "$max" ]||(($#<=max))||_die "[$*] $# > $max (max)"||return 1
}
is_empty(){
_deprecated "Use: is empty -- <value>"
is empty -- "$1"
}
is_integer(){
_deprecated "Use: is integer <value>" warn
is integer -- "$1"
}
is_float(){
_deprecated "Use: is float -- <value>" warn
is float -- "$1"
}
trim_start(){
is integer --name=arguments --max=2 --die -- $#
local str="${1-}"
local char="${2:-[:space:]}"
echo "${str#"${str%%[!$char]*}"}"
}
trim_end(){
is integer --name=arguments --max=2 --die -- $#
local str="${1:-}"
local char="${2:-[:space:]}"
echo "${str%"${str##*[!$char]}"}"
}
trim(){
is integer --name=arguments --max=2 --die -- $#
trim_end "$(trim_start "$1" "$2")" "$2"
}
to_alphanum(){
is integer --name=arguments --max=1 --die -- $#
local text
text="$(input "$@")"
echo "${text//[^a-zA-Z0-9_]/_}"
}
value_if_variable(){
is integer --name=arguments --max=2 --die -- $#
local _name="$1"
if [[ $_name =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]]&&[ -n "${!_name-}" ];then
echo "${!_name}"
else
echo "$_name"
fi
}
[[ $- =~ i ]]||set -eE
set -o pipefail
is set -- "${BASH_VERSION:-}"||die "No bash CLI! This can only be run under bash"
((BASH_VERSINFO[0]>4||(BASH_VERSINFO[0]==4&&BASH_VERSINFO[1]>=2)))||die "No bash CLI! This can only be run under bash >=4.2!"
trap 'die "💥 Uncaught exception at »${BASH_COMMAND}« with exit code $?"' ERR
debug "Running in DEBUG=${DEBUG-} mode!"
