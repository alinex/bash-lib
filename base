now(){
is integer --name=arguments --max=0 --die -- $#
date +%s
}
date_diff(){
is integer --name=arguments --max=2 --die -- $#
local start end
is integer -- "$1"&&start="$1"||start=$(date -d "$1" +%s)||die "Date format '$1' not parsable!"
is integer -- "$2"&&end="$2"||end=$(date -d "$2" +%s)||die "Date format '$2' not parsable!"
echo $((end-start))
}
date_format(){
is integer --name=arguments --max=2 --die -- $#
is set --name=format --die -- "$1"
local value format
case $1 in
iso)format="-Iseconds";;
iso-date)format="-I";;
zulu)format="-u +%Y-%m-%dT%H:%M:%SZ";;
sql)format='+"%Y-%m-%d %H:%M:%S"';;
unix)format="+%s";;
eu-date)format="+%Y-%m-%d";;
us-date)format="+%m/%d/%Y";;
human-date)format="+%A, %B %d, %Y";;
time)format="+%H:%M:%S";;
time-short)format="+%H:%M";;
*)format="+$1"
esac
value="${2-$(now)}"
is integer -- "$value"&&eval "date -d @$value $format"||eval "date -d \"$value\" $format"||die "Date format '$value' not parsable!"
}
duration_format(){
is integer --name=arguments --max=2 --die -- $#
is enum --name=format --allow="seconds minutes hours days human" --die -- "$1"
local value
is integer -- "$2"&&value="$2"||value="$(_parse_duration "$2")"
case $1 in
seconds)echo "$value";;
minutes)echo $((value/60));;
hours)echo $((value/3600));;
days)echo $((value/86400));;
human)_format_duration "$value"
esac
}
_parse_duration(){
local input="$1"
local total=0
local overall_sign=1
local value unit v_num
if [[ $input == -* ]];then
overall_sign=-1
input="${input#-}"
elif [[ $input == +* ]];then
overall_sign=1
input="${input#+}"
fi
while read -r value unit;do
if [[ $value =~ ^[+-] ]];then
v_num="$value"
else
v_num=$((overall_sign*value))
fi
case "$unit" in
''|s|sec|secs|second|seconds)total=$((total+v_num));;
m|min|mins|minute|minutes)total=$((total+v_num*60));;
h|hr|hrs|hour|hours)total=$((total+v_num*3600));;
d|day|days)total=$((total+v_num*86400));;
w|week|weeks)total=$((total+v_num*604800));;
*)printf "$(gettext 'Invalid duration unit'): %s\n" "$unit" >&2
return 1
esac
done < <(grep -Eo '[+-]?[0-9]+[[:alpha:]]*' <<<"$input"|sed -E 's/^([+-]?[0-9]+)([[:alpha:]]*)$/\1 \2/')
printf '%d\n' "$total"
}
_format_duration(){
local total="$1"
local sign=""
if ((total<0));then
sign="-"
total=$((-total))
fi
local w=$((total/604800))
local d=$((total/86400))
local h=$(((total%86400)/3600))
local m=$(((total%3600)/60))
local s=$((total%60))
local out=""
((w))&&out+="${w}w "
((d))&&out+="${d}d "
((h))&&out+="${h}h "
((m))&&out+="${m}m "
((s))&&out+="${s}s "
is empty -- "$out"&&out="0s"&&sign=""||true
echo "$sign${out% }"
}
_timer_start=0
timer(){
case $1 in
start)_timer_start=$(date +%s.%N)
;;
stop)local seconds nano len
IFS='.' read -r seconds nano <<<"$(echo "$(date +%s.%N) - $_timer_start"|bc)"
len=$((4-${#seconds}))
((len>=0))||len=0
LANG=C printf "%0.${len}f\n" "$seconds.$nano"
debug "Measurement: $seconds.$nano"
;;
*)die "Command $1 undefined, use: start stop"
esac
}
