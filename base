_stacktrace(){
local level="${1:-5}"
local i
for ((i=1; i<${#FUNCNAME[@]}; i++));do
local func="${FUNCNAME[i]}"
local line="${BASH_LINENO[i-1]}"
local src="${BASH_SOURCE[i]}"
printf "at %s() in %s:%s\n" "$func" "$src" "$line"|debug "$level"
done
}
debug(){
local level=1 func
if [[ $1 =~ ^-?[0-9]+$ ]];then
level="$1"
shift
fi
IFS=$' \t\n' read -r _ func _ <<<"$(caller 0)"
[ -z "$pfunc" ]||[ "$pfunc" = "$func" ]||func="$pfunc/$func"
local text
text="$(input "$@")"
test -n "$text"||return 0
[[ -n $DEBUG ]]||return 0
if [[ $DEBUG =~ ^-?[0-9]+$ ]];then
((level<=DEBUG))||return 0
else
[[ $func =~ .*(${DEBUG//, /|}) ]]||return 0
fi
while IFS= read -r line;do
printf "$CC_BLACK> %-20s %s$CC_RESET\n" "$func" "$line" >&2
done <<<"$text"
}
debug "Running in DEBUG=${DEBUG-} mode!"
die(){
echo -e "$CC_CRITICAL$(input "$@")$CC_RESET" >&2
