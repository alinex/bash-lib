option_parse(){
local opt name type desc short="" long="" spec="$1" permute
[ -n "$spec" ]||die "$(gettext 'A specification string is needed as first argument')"
if [[ $spec =~ ^\+ ]];then
permute=+
spec="${spec:1}"
fi
while IFS=$' \t\n' read -r opt name type desc;do
[[ $opt =~ ^# ]]&&continue
[[ -z $opt ]]&&continue
if [ ! "$type" = "-" ];then
[ "$opt" = "-" ]||short+="$opt:"
long+="$name:,"
else
[ "$opt" = "-" ]||short+="$opt"
long+="$name,"
fi
done <<<"$spec"
shift
getopt -o "$permute$short" --long "$long" -n "$0" -- "$@"
}
option_help(){
is set --name=spec --die -- "$1"
declare opt name type desc
declare -A opt_descriptions
declare -A opt_type
declare -A opt_short
while read -r opt name type desc;do
[[ $opt =~ ^# ]]&&continue
is empty -- "$opt"&&continue
opt_descriptions[$name]="$desc"
opt_type[$name]=$type
opt_short[$name]=$opt
done <<<"$1"
echo "$(gettext "Options"):"
for name in "${!opt_descriptions[@]}";do
local type_text=""
local short_text=""
if [ ! "${opt_type[$name]}" = "-" ];then
type_text=" <${opt_type[$name]}>"
fi
if [[ ! ${opt_short[$name]} == "-" ]];then
short_text="-${opt_short[$name]}$type_text, "
fi
printf "  %-40s %s\n" "$short_text--$name$type_text" "${opt_descriptions[$name]}"
done
}
input(){
test -p /dev/stdin&&(($#==0))&&cat -||echo "$*"
}
input_args(){
local num=${1-}
local start=$((num+2))
is set --name="num" --die -- "$num"
((num>0))||die "<num>=$num $(gettext 'argument is not a valid number!')"
test -p /dev/stdin&&(($#<num+2))&&cat -||echo "${@:start}"
}
input_lines(){
if [ -p /dev/stdin ]&&is empty -- "$1" ];then
cat -
else
for arg in "$@";do echo "$arg";done
fi
}
escape_args(){
local escaped_args=()
for arg in "$@";do
escaped_args+=("$(printf '%q' "$arg")")
done
echo "${escaped_args[*]}"
}
contains(){
_deprecated "use array <array-name> has <value>" warn
array "$1" has "$2"
}
array(){
is integer --name=arguments --max=3 --die -- $#
is set --name=array-name --die -- "$1"
is enum --name=command --allow="has indexof" --die -- "$2"
is set --name=value --die -- "$3"
declare -n arr="$1"
local cmd="$2"
local value="$3"
case "$cmd" in
has)for e in "${arr[@]}"
do
[ ! "$e" = "$value" ]||return 0
done
return 1
;;
indexof)for i in "${!arr[@]}"
do
if [ "${arr[i]}" = "$value" ];then
echo "$i"
return 0
fi
done
return 1
esac
}
join(){
is integer --name=arguments --max=2 --die -- $#
is set --name=array-name --die -- "$1"
local -n array=$1
local sep="${2:-,}"
local joined="${array[0]}"
for element in "${array[@]:1}";do
joined+="$sep$element"
done
echo "$joined"
}
split(){
is integer --name=arguments --max=3 --die -- $#
is set --name=array-name --die -- "$2"
local string="$1"
local -n array=$2
local sep="${3:-,}"
IFS="$sep" read -ra array <<<"$string"
}
hash(){
local keyFormat="simple"
eval set -- "$(option_parse $'k key-format +' "$@")"
while true;do
case "$1" in
-k|--key-format)keyFormat="$(check enum --allow="simple base64" -- "$2")"&&shift 2;;
--)shift&&break;;
*)die "$(gettext "Unrecognized option"): $1"
esac
done
is integer --name=arguments --max=4 --die -- $#
is set --name=array-name --die -- "$1"
is enum --name=command --allow="set get unset has contains" --die -- "$2"
declare -n arr="$1"
local cmd="$2" key value="$4"
case $keyFormat in
base64)key="$(base64 -w0 <<<"$3")";;
simple)key="${3//[^a-zA-Z0-9_]/_}"
esac
case "$cmd" in
set)is set --name=key --die -- "$3"&&arr["$key"]="$value";;
get)is set --name=key --die -- "$3"&&echo "${arr["$key"]}";;
unset)is set --name=key --die -- "$3"&&unset 'arr[$key]';;
has)is set --name=key --die -- "$3"&&[[ -v arr["$key"] ]];;
contains)is set --name=value --die -- "$3"
for key in "${!arr[@]}";do
[[ ${arr["$key"]} != "$3" ]]||return 0
done
return 1
esac
}
