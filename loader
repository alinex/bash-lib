#!/usr/bin/env bash
# shellcheck source=base
# shellcheck disable=SC1094
source /dev/null

# shellcheck disable=SC2034
BASHLIB_LOADER=${BASHLIB_LOADER:-loader}

for folder in core module; do
    for f in "${BASHLIB_HOME:-.}/$folder"/*; do
        if [[ -f "$f" && "$f" != *.* ]]; then
            [ -z "$DEBUG" ] || echo "loading $f" >&2
            source "$f"
        fi
    done
done

source "$BASHLIB_HOME"/configs
