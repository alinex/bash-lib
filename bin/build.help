#!/bin/bash
# Integrated help to be called using -h or --help flag.

echo -e "
Build combined bash-lib
$(yellow)$(bold)
Usage:              $0 [options]
$(reset)
$(bold)Options:$(reset)

    -h --help       to show a short help integrated page
    -V --version    displays the version of this program

$(bold)Environment Settings:$(reset)

    LOG_LEVEL=DEBUG change the default log level to get more information
    LOG_...         also you can setup file logging, rotation... (log library)

-------------------------------------------------------------------------

Call it without any parameter to build the combined libraries within the dist
folder. And use them in other commands.

Also consider reading the complete documentation under:
$GITLAB//blob/$VERSION/README.md
"
