# Print special marked message like table header
#
# Usage:    invers <message>
#           <message> | invers
# Output:   colored <string>
invers() {
    local text
    text="$(input "$@")"
    is set -- "$text" || return 0
    printf "${CC_INVERS}%s${CC_RESET}\n" "$text"
    ((${#_log_active[@]} == 0)) || log info "$text"
}

# Print message in defined color
#
# Usage:    color <color> <message>
#           <message> | color <color>
# Output:   colored <string>
color() {
    local text
    text="$(input_args 1 "$@")"
    is set -- "$text" || return 0
    printf "${CC_ERROR}%s${CC_RESET}\n" "$text"
    ((${#_log_active[@]} == 0)) || log info "$text"
}

######################################################################################
# Format Helpers
######################################################################################

# Remove color codes from text
#
# Usage:    uncolorize <text>
#           <text> | uncolorize
# Output:   <text>
# shellcheck disable=SC2120
uncolorize() {
    input "$@" | sed -r 's/\x1B\[[0-9;]*[mGK]//g'
}

# Convert HTML to markdown (simplified version)
#
# Usage:    html2md <html-part>
#           <html-part> | html2md
# Output:   <md>
html2md() {
    input "$@" |
        sed 's#&rarr;#→#g;s#&auml;#ä#g;s#&ouml;#ö#g;s#&uuml;#ü#g;s#&Auml;#Ä#g;s#&Ouml;#Ö#g;s#&Uuml;#Ü#g;s#&szlig;#ß#g;s#<strong>\([^<]*\)</strong>#**\1**#g;s#<br/\?>#\n#g;s#<li[^>]*>#\n- #g;s#<[^>]*>##g' |
        grep -v '^$'
}

# Remove carriage return from line endings
#
# Usage:    nocr <text>
#           <text> | nocr
# Output:   <text>
nocr() {
    input "$@" | sed 's/\r$//' # removes all: tr -d '\r'
}

# Encode message to be used within the url
#
# Usage:    urlencode <string>
#           <string> | urlencode
# Output:   <string>
urlencode() {
    install jq
    input "$@" | jq -sRr @uri | sed 's/%0A$//'
}

######################################################################################
# Visual effects
######################################################################################

# Show a horizontal line
#
# It will go over the full width of terminal, but be at least 60 characters wide.
#
# Format can be:
#
# - light (default) ──────────
# - bold ━━━━━━━━━━
# - double ══════════
# - half ▄▄▄▄▄▄▄▄▄▄
# - full ██████████
#
# Usage:    horizontal_line [<format>]
# Output:   ────────── # over full width of terminal
horizontal_line() {
    is integer --name=arguments --max=1 --die -- $#
    is empty -- "$1" || is enum --name=format --allow="light bold double half full"--die -- "$1"
    # processing
    local char
    case $1 in
    #light) char="─" ;; # is the default
    bold) char="━" ;;
    double) char="═" ;;
    half) char="▄" ;;
    full) char="█" ;;
    *) char="─" ;;
    esac
    local cols
    read -r _ cols < <(stty size)
    ((cols > 60)) || cols=60
    printf '%s\n' "$(character repeat "$cols" "$char")"
}

_spinner_pid=""

# Function to start the spinner in the background
#
# To stop it later call @spinner_stop.
#
# Some formats have multiple character width:
#
# - `simple`:   - \ | /
# - `arrows`:   → ↑ ← ↓
# - `vertical`: ▏ ▎ ▍ ▌ ▋ ▊ ▉ █ ▉ ▊ ▋ ▌ ▍ ▎ ▏
# - `bar`:      (as `vertical` but two characters wide)
# - `fade`:     ░ ▒ ▓ █ ▓ ▒ ░
# - `braille`:   ⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏ (default)
# - `roll`:     ⠋ ⠙ ⠚ ⠞ ⠖ ⠦ ⠴ ⠲ ⠳ ⠓
# - `moon`:     🌑 🌒 🌓 🌔 🌕 🌖 🌗 🌘
# - `clock`:    🕐 🕑 🕒 🕓 🕔 🕕 🕖 🕗 🕘 🕙 🕚 🕛
# - `weather`:  🌤 🌥 🌦 🌧 🌨 🌩 🌪
#
# Usage:    spinner_start <format> [<time>]
#           # <format> see above
#           # <time> 0.1 or more seconds (default 0.2)
# TTY:      <symbol> with back-space so that cursor is always before it
# Returns:   0 without doing anything if no `tput` and terminal available
spinner_start() {
    is integer --name=arguments --max=2 --die -- $#
    is empty -- "$1" || is enum --name=format --allow="simple arrows vertical bar fade braille roll moon clock weather" --die -- "$1"
    # processing
    if ! command -v tput >/dev/null 2>&1 || [ ! -t 2 ]; then
        debug "Disabled because tput and terminal is needed"
        return 0
    fi
    local format="${1:-braille}"
    local spinner
    local size=1
    local chars=1
    local delay=${2:-0.2}
    case $format in
    #simple) spinner='-\|/' ;; # is the default option, too
    arrows) spinner='→↑←↓' ;;
    vertical) spinner='▏▎▍▌▋▊▉█▉▊▋▌▍▎▏' ;;
    bar) spinner='▏ ▎ ▍ ▌ ▋ ▊ ▉ █ █▏█▎█▍█▌█▋█▊█▉███▉█▊█▋█▌█▍█▎█▏█ ▉ ▊ ▋ ▌ ▍ ▎ ▏ ' && chars=2 && size=2 ;;
    fade) spinner=' ░▒▓█▓▒░' ;;
    braille) spinner='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏' ;;
    roll) spinner='⠋⠙⠚⠞⠖⠦⠴⠲⠳⠓' ;;
    moon) spinner='🌑🌒🌓🌔🌕🌖🌗🌘' && size=2 ;;
    clock) spinner='🕐🕑🕒🕓🕔🕕🕖🕗🕘🕙🕚🕛' && size=2 ;;
    weather) spinner='🌤🌥🌦🌧🌨🌩🌪' ;;
    *) spinner='-\|/' ;;
    esac
    local back=$((size + 1))
    # Spinner function running in background loop
    # shellcheck disable=SC2059
    printf "$CUR_HIDE" # make cursor invisible
    (
        while true; do
            for ((i = 0; i < ${#spinner}; i += chars)); do
                printf " %s%s" "${spinner:i:$chars}" "$(printf '\b%.0s' $(seq 1 "$back"))" >/dev/tty
                sleep "$delay"
            done
        done
    ) &
    _spinner_pid=$!
    disown
}

# Function to stop the spinner
#
# Call this after @spinner_start to stop it. It has to be called within the same thread!
#
# Usage:    spinner_stop
spinner_stop() {
    is integer --name=arguments --max=0 --die -- $#
    # processing
    [ -n "$_spinner_pid" ] || return # spinner not started
    kill "$_spinner_pid" >/dev/null 2>&1
    wait "$_spinner_pid" 2>/dev/null
    _spinner_pid=""
    printf "    \b\b\b\b" # Clear spinner character
    # shellcheck disable=SC2059
    printf "$CUR_SHOW" # make cursor visible again
}

# Output Logo with title text
#
# You may overwrite this function with one displaying your own logo by loading it from your `extra/my-company-logo` or so.
#
# Usage:    logo <text>
# Output:   ASCII art logo including title
# shellcheck disable=SC2059
logo() {
    a=$'\e[36m'            # cyan
    b=$'\e[33m\e[1m'       # yellow bold
    c=$'\e[43m\e[30m\e[1m' # yellow bg + black bold
    r=$'\e[0m'             # reset
    u=$'\e[4m'             # underline
    p="$(character repeat $((($(tput cols) - 80) / 2)) ' ')"
    t="$(character repeat $((($(tput cols) - ${#1}) / 2)) ' ')"
    printf '\n'
    printf "$p$a                         $b  __   ____     ___\n"
    printf "$p$a           ######  ##### $b ▕  ▏ ▕    ╲   ▕   ▏ $a  ########### #####       #####\n"
    printf "$p$a          ######## ##### $b ▕  ▏ ▕     ╲  ▕   ▏ $a ############  #####     #####\n"
    printf "$p$a         ######### ##### $b ▕  ▏ ▕  ▕╲  ╲ ▕   ▏ $a #####          #####   #####\n"
    printf "$p$a        ########## ##### $b ▕  ▏ ▕  ▕ ╲  ╲▕   ▏ $a #####           ##### #####\n"
    printf "$p$a       ##### ##### ##### $b ▕  ▏ ▕  ▕  ╲  ▔   ▏ $a ############     #########\n"
    printf "$p$a      #####  ##### ##### $b ▕  ▏ ▕  ▕   ╲     ▏ $a ############     #########\n"
    printf "$p$a     #####   ##### ##### $b ▕  ▏ ▕  ▕    ╲    ▏ $a #####           ##### #####\n"
    printf "$p$a    #####    ##### ##### $b  ▔▔   ▔▔▔     ▔▔▔▔  $a #####          #####   #####\n"
    printf "$p$a   ##### ######### ######""#####################"" ############  #####     #####\n"
    printf "$p$a  ##### ##########  #####""#################### ""  ########### #####       ##### $r\n"
    printf "$p$b▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄""▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄""▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄$r$c\n"
    printf "$t%s$r\n" "$1"
    printf "$p$b▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀""▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀""▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀$r\n"
    printf '\n'
}
