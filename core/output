#!/usr/bin/env bash
# shellcheck disable=SC2034
# shellcheck source=base
source /dev/null

# Module with output and user interaction helpers.

######################################################################################
### Escape Sequences
######################################################################################

# Cursor up 1 line
CURSOR_UP=$'\e[A'
#  Cursor down 1 line
CURSOR_DOWN=$'\e[B'
#  Cursor right 1 col
CURSOR_RIGHT=$'\e[C'
# Cursor left 1 col
CURSOR_LEFT=$'\e[D'
# Next Line (down, col 1)
CURSOR_NEXT=$'\e[E'
# Previous Line (up, col 1)
CURSOR_PREVIOUS=$'\e[F'
# Cursor to start of line
CURSOR_POS1=$'\e[G'
# Cursor to top-left
CURSOR_TOP=$'\e[H'
# Save cursor pos
CURSOR_STORE=$'\e[s'
# Restore cursor pos
CURSOR_RESTORE=$'\e[u'
# Show cursor
CURSOR_SHOW=$'\e[?25h'
# Hide cursor
CURSOR_HIDE=$'\e[?25l'

# Move cursor on console
#
# Possible directions are: up, down, right, left
# Move to col 1 with: next, previous
#
# Usage:    cursor <direction> <num>
#           cursor row <num>
#           cursor pos <row> <col>
cursor() {
    local num="${2:-1}" col="${3:-1}"
    is enum --name=direction --allow="up down right left row pos next previous" --die -- "$1"
    is integer --name=num --min=1 --die -- "$num"
    is integer --name=arguments --max=3 --die -- $#
    case "$1" in
    up) printf '\e[%sA' "$num" ;;
    down) printf '\e[%sB' "$num" ;;
    right) printf '\e[%sC' "$num" ;;
    left) printf '\e[%sD' "$num" ;;
    row) printf '\e[%sH' "$num" ;;
    pos)
        is integer --name=col --min=1 --die -- "$col"
        printf '\e[%s;%sH' "$num" "$col"
        ;;
    next) printf '\e[%sE' "$num" ;;
    previous) printf '\e[%sF' "$num" ;;
    esac
}

# Change characters
#
# Usage:    character repeat <num> <character>
#           character delete <num>                  # delete character on the right side
#           character erase <num>                   # delete characters on the left side
character() {
    local num="$2"
    is enum --name=command --allow="repeat" --die -- "$1"
    is integer --name=num --min=1 --die -- "$num"
    case "$1" in
    repeat)
        is set --name=character --min=1 --die -- "$3"
        is length --name=character --min=1 --max=1 --die -- "$3"
        ((num == 1)) && printf '%s' "$3" || printf '%s\e[%sb' "$3" $((num - 1))
        ;;
    delete) printf '\e[%sP' "$num" ;;
    erase) printf '\e[%sX' "$num" ;;
    esac
}

# Reverse Index (up, scroll)
SCROLL_UP=$'\e[M'

# Clear entire screen
CLEAR_SCREEN=$'\e[2J'
# Clear from start of screen to cursor
CLEAR_UP=$'\e[1J'
# Clear from cursor to end of screen
CLEAR_DOWN=$'\e[0J'
# Clear from cursor to end of line
CLEAR_EOL=$'\e[0K'
# Clear from start of line to cursor
CLEAR_SOL=$'\e[1K'
# Clear entire line
CLEAR_LINE=$'\e[2K'

# restore screen
SCREEN_RESTORE=$'\e[?47l'
# save screen
SCREEN_SAVE=$'\e[?47h'

# Deprecated: Remove current line
# Use $CLEAR_LINE
#
# When printed to a terminal, it will erase everything from the current cursor position backward to the beginning of the line.
#
# Usage:    erase_line
erase_line() {
    _deprecated "Use $CLEAR_LINE" warn
    # shellcheck disable=SC2059
    printf "$CLEAR_LINE"
}

######################################################################################
### Debug and Error Handling
######################################################################################

# Write message to STDERR if in DEBUG mode else do nothing
#
# Debug can support multiple levels starting from 1 upwards to be more verbose. This will only be shown if environment variable `DEBUG` is the same number or higher. Or if the `DEBUG` variable includes the function name. Multiple lines will be printed separately to have the function name prefix at the start of each.
#
# With DEBUG=9 the $BASHPID will also be shown.
#
# Usage:    debug [<num>] <message>
#           <message> | debug [<num>]
#               <num> := [1-9]      # (default 1) higher to only show in more verbose call
#               <message>           # the message text
# Globals:  `$DEBUG` - if unset nothing will be printed
#           `$DEBUG=<num>` - only print messages with same or lower numeric level
#           `$DEBUG=<func>,...` - only print if the function is matched
#           `$DEBUG=9` - to output all
# Error:    `> <func>           <message>`      # color: gray
debug() {
    local level=1 func text sign='>'
    is integer --name=arguments --max=2 --die -- $#
    is integer --min 1 -- "$1" && level="$1" && shift || true
    IFS=$' \t\n' read -r _ func _ <<<"$(caller 0 || true)"
    func="${func:-(main)}"
    is set -- "$DEBUG" || return 0
    text="$(input "$@")"
    [[ "$BASHLIB_LOADER" != "remote" ]] || sign='>>'
    # processing
    # decide to print
    if is integer -- "$DEBUG"; then
        # numeric => decide on level
        is integer --min=0 --die -- "$DEBUG"
        ((level <= DEBUG)) || return 0
    else
        # string => check for match
        [[ "$func" =~ .*(${DEBUG//,? /|}) ]] || return 0
    fi
    # print each line separately
    while IFS= read -r line; do
        is integer --min=9 -- "$DEBUG" &&
            printf "$CC_BLACK%-2s %7d %-20s %s$CC_RESET\n" "$sign" "$BASHPID" "$func" "$line" >&2 ||
            printf "$CC_BLACK%-2s %-20s %s$CC_RESET\n" "$sign" "$func" "$line" >&2
    done <<<"$text"
    ! command -v log >/dev/null || log debug "$func: $text"
}

# Output error message and exit
#
# Usage:    die <message> [<source>:<line>]
#           <message> | die
# Error:    # Example if called for deprecated call:
#           ```
#           DEPRECATED: ask_input at task_find in /home/alex/bin/dvb/cleanup:206 please use ask string
#           > _stacktrace          at die() in /home/alex/dvb/bash-lib/core/misc:59
#           > _stacktrace          at _deprecated() in /home/alex/dvb/bash-lib/core/internal:23
#           > _stacktrace          at ask_input() in /home/alex/dvb/bash-lib/module/input:150
#           > _stacktrace          at task_find() in /home/alex/bin/dvb/cleanup:206
#           > _stacktrace          at tasks() in /home/alex/dvb/bash-lib/module/input:451
#           > _stacktrace          at main() in /home/alex/bin/dvb/cleanup:364
#           ```
# Return:   143 SIGTERM
die() {
    is integer --name=arguments --max=1 --die -- $#
    # processing
    local text trap line func src
    text="$(input "$@")"
    [[ "$text" != *"Uncaught exception at"* ]] || trap=1
    # output
    printf "${CC_CRITICAL}%s${CC_RESET}\n" "$text in ${FUNCNAME[1]}" >&2
    _stacktrace "$trap"
    if command -v log >/dev/null; then
        log critical "$text"
        _stacktrace "$trap" 2>&1 | log critical
    fi
    if [[ $- == *i* ]]; then
        return 143
    else
        sleep 1 # to let output pipes finish
        # sends SIGTERM to process group → process receives SIGTERM
        kill -- -$$ 2>/dev/null
        exit 143
    fi
}

######################################################################################
# Context
######################################################################################

# Show help page and exit
#
# Usage:    help <heading> <usage> <options-spec> <details>
help() {
    is integer --name=arguments --min=2 --max=4 --die -- $#
    is set --name=heading --die -- "$1"
    is set --name=usage --die -- "$2"
    # processing
    heading "$(gettext Help): $1"
    info "Usage: $2"
    printf '\n'
    if is set -- "$3"; then
        option_help "$3"
        printf '\n'
    fi
    if is set -- "$4"; then
        printf '%s\n\n' "$4"
    fi
    exit 0
}

######################################################################################
# Messages
######################################################################################

# Print block heading
#
# Usage:    heading <title>
#           <title> | heading
# Output:   colored <string>
# Variable: $server
heading() {
    local prefix=""
    # shellcheck disable=SC2154
    is empty -- "$server" || prefix="${server-} "
    printf "\n%s\n\n" "${CC_INVERS}$prefix${CC_RESET}${CC_HEADING}$(input "$@")...${CC_RESET}"
}

# Print critical/disaster message
#
# Usage:    critical <message>
#           <message> | critical
# Output:   colored <string>
critical() {
    local text
    text="$(input "$@")"
    is set -- "$text" || return 0
    printf '%s\n' "${CC_CRITICAL}$text${CC_RESET}"
    ((${#_log_active[@]} == 0)) || log critical "$text"
}

# Print error message
#
# Usage:    error <message>
#           <message> | error
# Output:   colored <string>
error() {
    local text
    text="$(input "$@")"
    is set -- "$text" || return 0
    printf '%s\n' "${CC_ERROR}$text${CC_RESET}"
    ((${#_log_active[@]} == 0)) || log error "$text"
}

# Print warning message
