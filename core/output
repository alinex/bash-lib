# Print special marked message like table header
#
# Usage:    invers <message>
#           <message> | invers
# Output:   colored <string>
invers() {
    local text
    text="$(input "$@")"
    is set -- "$text" || return 0
    printf "${CC_INVERS}%s${CC_RESET}\n" "$text"
    ((${#_log_active[@]} == 0)) || log info "$text"
