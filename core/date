#!/usr/bin/env bash
# shellcheck source=base
source /dev/null

# Some helpers to work easier with dates.

######################################################################################
### Timestamp
######################################################################################

# Get current timestamp
#
# Usage:    now
# Output:   <seconds> since 1970
# shellcheck disable=SC2120
now() {
    is integer --name=arguments --max=0 --die -- $#
    # processing
    date +%s
}

######################################################################################
### Working with date string or timestamp
######################################################################################

# Calculate difference in seconds
#
# The two dates to compare can be unix timestamps (seconds since 1970) or a parsable date format.
# If no <end> is given, it will use the current time as end.
#
# Usage:    date_diff <start> [<end>] # timestamp or date string
# Output:   <seconds> negative if <start> behind <end>
date_diff() {
    is integer --name=arguments --max=2 --die -- $#
    local start end
    end="${2:-$(now)}"
    is integer -- "$1" && start="$1" || start=$(date -d "$1" +%s) ||
        die "Date format '$1' not parsable!"
    is integer -- "$end" || end=$(date -d "$end" +%s) ||
        die "Date format '$2' not parsable!"
    # processing
    printf '%s' $((end - start))
}

# Format date in different named versions or format string
#
# The `<value>` can be unix timestamp (seconds since 1970) or a parsable date format.
#
# Usage:    date_format <format> [<value>] # use now if missing
#           <format>:   iso         2025-10-01T12:00:00+02:00
#                       iso-date    2025-10-01
#                       zulu        2025-10-01T10:00:00Z
#                       sql         2025-10-01 12:00:00
#                       unix        1759312800
#                       eu-date     01.10.2025
#                       us-date     10/01/2025
#                       human       Mittwoch, Oktober 01, 2025 at 12:00:00
#                       human-date  Mittwoch, Oktober 01, 2025
#                       time        12:00:00
#                       time-short  12:00
#                       %Y          2025 (custom format)
# Output:   <string> in selected format
date_format() {
    is integer --name=arguments --max=2 --die -- $#
    is set --name=format --die -- "$1"
    # processing
    local value format opt
    case $1 in
    iso) format="-Iseconds" ;;
    iso-date) format="-I" ;;
    zulu) opt="-u" && format="+%Y-%m-%dT%H:%M:%SZ" ;;
    sql) format="+%Y-%m-%d %H:%M:%S" ;;
    unix) format="+%s" ;;
    eu-date) format="+%Y-%m-%d" ;;
    us-date) format="+%m/%d/%Y" ;;
    human) format="$(gettext "+%A, %B %d, %Y at %H:%M:%S")" ;;
    human-date) format="$(gettext "+%A, %B %d, %Y")" ;;
    time) format="+%H:%M:%S" ;;
    time-short) format="+%H:%M" ;;
    *) format="+$1" ;;
    esac
    value="${2-$(now)}"
    is integer -- "$value" && eval "date -d @$value '$format'" || eval "date -d \"$value\" $opt '$format'" ||
        die "Date format '$value' not parsable!"
}

# Sleep until given date
#
# Causes the running process to wait until the given date.
# If the date is in the past, it immediately returns.
#
# Usage:    sleep_until <date>
sleep_until() {
    is integer --name=arguments --max=1 --die -- $#
    is set --name=date --die -- "$1"
    # processing
    local secs
    secs="$(date_diff "$(now)" "$1")"
    ((secs > 0)) || die "Date has to be in the future for sleep_until"
    sleep "$secs"
}

######################################################################################
### Duration intervals
######################################################################################

# Format duration in different numbers or human readable
#
# This function can convert into seconds and back into human format as you like. Months or years are not possible because they are not accurately, better use 30d or 365d for that.
#
# Usage:    duration_format <format> <seconds>|<human>
#           <format>:   seconds
#                       minutes     # using floor 110s = 1
#                       hours       # using floor
#                       days        # using floor
#                       human       # like 1h 30m, 5w, 30s # spaces between different units are optional
# Output:   <duration> in selected format
duration_format() {
    is integer --name=arguments --max=2 --die -- $#
    is enum --name=format --allow="seconds minutes hours days human" --die -- "$1"
    local value
    is integer -- "$2" && value="$2" || value="$(_parse_duration "$2")"
    # processing
    case $1 in
    seconds) printf '%s' "$value" ;;
    minutes) printf '%s' $((value / 60)) ;;
    hours) printf '%s' $((value / 3600)) ;;
    days) printf '%s' $((value / 86400)) ;;
    human) _format_duration "$value" ;;
    esac
}

# Read seconds or parse human format
#
# Usage:    _parse_duration <seconds>|<human>
_parse_duration() {
    local input="$1"
    local total=0
    local overall_sign=1
    local value unit v_num
    # Trim leading sign for the whole input, but remember it
    if [[ "$input" == -* ]]; then
        overall_sign=-1
        input="${input#-}"
    elif [[ "$input" == +* ]]; then
        overall_sign=1
        input="${input#+}"
    fi
    # Extract tokens like 1h, -30m, +5s, etc.
    # We run on the (possibly sign-stripped) input so a leading '-' applied earlier becomes overall_sign.
    while read -r value unit; do
        # value may itself have a sign (e.g. -30)
        if [[ "$value" =~ ^[+-] ]]; then
            v_num="$value" # use token's own sign
        else
            v_num=$((overall_sign * value)) # apply overall sign
        fi
        case "$unit" in
        '' | s | sec | secs | second | seconds) total=$((total + v_num)) ;;
        m | min | mins | minute | minutes) total=$((total + v_num * 60)) ;;
        h | hr | hrs | hour | hours) total=$((total + v_num * 3600)) ;;
        d | day | days) total=$((total + v_num * 86400)) ;;
        w | week | weeks) total=$((total + v_num * 604800)) ;;
        *)
            printf "$(gettext 'Invalid duration unit'): %s\n" "$unit" >&2
            return 1
            ;;
        esac
    done < <(grep -Eo '[+-]?[0-9]+[[:alpha:]]*' <<<"$input" | sed -E 's/^([+-]?[0-9]+)([[:alpha:]]*)$/\1 \2/')
    printf '%d\n' "$total"
}

# Format duration in human format
#
# Usage:    _format_duration <seconds>
_format_duration() {
    local total="$1"
    local sign=""
    # Handle sign
    if ((total < 0)); then
        sign="-"
        total=$((-total))
    fi
    local w=$((total / 604800))
    local d=$((total / 86400))
    local h=$(((total % 86400) / 3600))
    local m=$(((total % 3600) / 60))
    local s=$((total % 60))
    # Build string
    local out=""
    ((w)) && out+="${w}w "
    ((d)) && out+="${d}d "
    ((h)) && out+="${h}h "
    ((m)) && out+="${m}m "
    ((s)) && out+="${s}s "
    # If total was exactly 0
    is empty -- "$out" && out="0s" && sign="" || true
    printf '%s' "${sign}${out% }"
}

######################################################################################
### Duration intervals
######################################################################################

_timer_start=0

# Start/stop the timer
#
# After `timer stop` it will return the elapsed time.
#
# Usage:    timer start
#           timer stop
# Output:   <seconds>.<milliseconds> # after stop
timer() {
    case $1 in
    start)
        _timer_start=$(date +%s.%N)
        ;;
    stop)
        local seconds nano len
        IFS='.' read -r seconds nano < <(printf '%s' "$(date +%s.%N) - $_timer_start" | bc)
        len=$((4 - ${#seconds}))
        ((len >= 0)) || len=0
        LANG=C printf "%0.${len}f\n" "$seconds.$nano"
        debug "Measurement: $seconds.$nano"
        ;;
    *) die "Command $1 undefined, use: start stop" ;;
    esac
}
