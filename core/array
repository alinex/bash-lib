#!/usr/bin/env bash

# Helper functions to work with arrays and associative arrays (hashes).

######################################################################################
### Array analyzing
######################################################################################

# Array analyzation
#
# This can be used for easy array access functions. The array itself is not given by value but by name, so no `$` before the name.
#
# The following commands ar<string-input>e possible:
#
# - `has` to check if a value could be found within the array
# - `indexof` will return the index number of the value if found
#
# Usage:        array <array-name> has <value>
#               array <array-name> indexof <value>
#               array <array-name> join [<separator>]
# Variables:    <array-name> as basis to work on
# Output:       - `indexof`: <index-num> for found value
# Return:       0 if entry is found in array
#               1 if entry not found
array() {
    local cmd value
    is set --name=array-name --die -- "$1"
    is enum --name=command --allow="has indexof join" --die --output=cmd -- "$2"
    is integer --name=arguments --max=3 --die -- $#
    declare -n arr="$1"
    # processing
    case "$cmd" in
    has)
        is set --name=value --die --output=value -- "$3"
        for e in "${arr[@]}"; do
            [ ! "$e" = "$value" ] || return 0
        done
        return 1
        ;;
    indexof)
        is set --name=value --die --output=value -- "$3"
        for i in "${!arr[@]}"; do
            if [ "${arr[i]}" = "$value" ]; then
                printf '%s' "$i"
                return 0
            fi
        done
        return 1
        ;;
    join)
        local joined="${arr[0]}" separator="${3:-,}"
        for element in "${arr[@]:1}"; do
            joined+="$separator$element"
        done
        printf '%s' "$joined"
        ;;
    esac
}

# Deprecated: Join array elements by delimiter
# Use @array <arr> join <separator>
join() {
    _deprecated "Use array <arr-name> join <separator>"
}

######################################################################################
### Split array
######################################################################################

# Splits string by delimiter into array
# The delimiter defaults to `,`.
#
# Usage:        split <string> <array-name> [<delimiter>]
# Variables:    <array-name> to store values
split() {
    is integer --name=arguments --max=3 --die -- $#
    is set --name=array-name --die -- "$2"
    local string="$1"
    local -n array=$2
    local sep="${3:-,}"
    # Set IFS to the separator and read into array
    IFS="$sep" read -ra array <<<"$string"
}

######################################################################################
### Hash
######################################################################################

# Methods to work with assoziative arrays (hashes)
#
# After declaring a variable as associative array: `declare -A <array-name>` this commands may help working with it. The array itself is not given by value but by name, so no `$` before the name.
#
# As an assoziative array allows not all characters for the key, the key can be:
#
# - `simple` (default) - unsupported characters will be replaced by _: "my %key" => "my__key"
# - `base64` - encode the whole key as base64: "my %key" => "bXkgJWtleQo="
#
# The following commands are possible:
#
# - `set` add or update a <value> in the index
# - `get` get the stored value for <key>
# - `unset` remove <key> from hash
# - `has` check if the <key> is set
# - `contains` check if the given <value> is found in any key
# - `to` converts hash into `tsv`
#
# Usage:        hash <array-name> set <key> [<value>]
#               hash <array-name> get <key> [<value>]
#               hash <array-name> unset <key>
#               hash <array-name> has <key>
#               hash <array-name> contains <key>
#               hash <array-name> to tsv
# Options:      -k, --key-format={base64|simple} # how to convert key because of special characters
# Variables:    <array-name> as basis to work on
# Output:       `get`: <value> if found
# Error:        `get` / `has`: 1 if not found
# Example:      - `hash cache set "my_name" "any value"`
#               - `hash cache get "my_name"`
#               - `hash cache has "my_name"`
#               - `hash cache unset "my_name"`
hash() {
    # parameter parsing
    local keyFormat="simple"
    eval set -- "$(option_parse $'k key-format +' "$@")"
    while true; do
        case "$1" in
        -k | --key-format) is enum --allow="simple base64" --output=keyFormat -- "$2" && shift 2 ;;
        --) shift && break ;;
        *) die "$(gettext "Unrecognized option"): $1" ;;
        esac
    done
    is integer --name=arguments --max=4 --die -- $#
    is set --name=array-name --die -- "$1"
    is enum --name=command --allow="set get unset has contains to" --die -- "$2"
    declare -n arr="$1"
    local cmd="$2" key value="$4"
    case $keyFormat in
    base64) key="$(base64 -w0 <<<"$3")" ;;
    simple) key="${3//[^a-zA-Z0-9_]/_}" ;;
    esac
    # processing
    case "$cmd" in
    set) is set --name=key --die -- "$3" && arr["$key"]="$value" ;;
    get) is set --name=key --die -- "$3" && printf '%s' "${arr["$key"]}" ;;
    unset) is set --name=key --die -- "$3" && unset 'arr[$key]' ;;
    has) is set --name=key --die -- "$3" && [[ -v arr["$key"] ]] ;;
    contains)
        is set --name=value --die -- "$3"
        for key in "${!arr[@]}"; do
            [[ "${arr["$key"]}" != "$3" ]] || return 0
        done
        return 1
        ;;
    to)
        is enum --name=format --allow=tsv --die -- "$3"
        case $3 in
        tsv)
            printf 'name\tvalue\n'
            for key in "${!arr[@]}"; do
                printf '%s\t%s\n' "$key" "${arr[$key]}"
            done
            ;;
        esac
        ;;
    esac
}
