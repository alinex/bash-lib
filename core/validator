######################################################################################
### Sanitize
######################################################################################

# Trim leading whitespace or given character
#
# Usage:    trim_start <value> [<characters>]
# Output:   <string>
# See:      https://stackoverflow.com/a/3352015
trim_start() {
    is integer --name=arguments --max=2 --die -- $#
    local str="${1-}"
    local char="${2:-[:space:]}"
    # processing
    # shellcheck disable=SC2295
    echo "${str#"${str%%[!$char]*}"}"
}

# Trim trailing whitespace or given character
#
# Usage:    trim_end <value> [<characters>]
# Output:   <string>
# See:      https://stackoverflow.com/a/3352015
trim_end() {
    is integer --name=arguments --max=2 --die -- $#
    local str="${1:-}"
    local char="${2:-[:space:]}"
    # processing
    # shellcheck disable=SC2295
    echo "${str%"${str##*[!$char]}"}"
}

# Trim leading and trailing whitespace or given character
#
# Usage:    trim <value> [<characters>]
# Output:   <string>
# See:      https://stackoverflow.com/a/3352015
trim() {
    is integer --name=arguments --max=2 --die -- $#
    # processing
    trim_end "$(trim_start "$1" "$2")" "$2"
}

# Convert string into only alphanumeric values
#
# This is needed to use it as a key in associative arrays. All other characters are converted into underscore.
#
# Usage:    to_alphanum <string>
#           <string> | to_alphanum
# Output:   <alnum>
to_alphanum() {
    is integer --name=arguments --max=1 --die -- $#
    local text
    text="$(input "$@")"
    # processing
    echo "${text//[^a-zA-Z0-9_]/_}"
}

# Return the value or if it is a variable name which is not empty return it's value
#
# Usage:    value_if_variable <name>
# Output:   <string>
value_if_variable() {
    is integer --name=arguments --max=2 --die -- $#
    local _name="$1"
    # processing
    if [[ "$_name" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] &&
        [ -n "${!_name-}" ]; then
        echo "${!_name}"
    else
        echo "$_name"
    fi
}
