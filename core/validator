#!/usr/bin/env bash

# Validators to make this easier and more readable.

######################################################################################
### General Validation
######################################################################################

# Validate and sanitize values.
#
# This validation is possible using the `check` and @is function.
# - `check` should be used for sanitize because it will output the value
# - @is should be used for checking only validity or stop processing on problem because no value is output
#
# Every parameter should be checked to prevent failure later in the code.
# For such checks you run it with the `--die` option to stop processing if wrong.
# But you can also use it in the program flow without that and use it's return status to check if it 0=ok or 1=failed.
#
# Because the values may start with an dash you should always put it at the end after '--' to prevent parsing it as option.
#
# The following checks are implemented:
#
# - `set` will fail if no value given
# - `empty` will fail if not empty like ""
# - `bool` will transform the value to `1` or `0` and allows: true/false, t/f, 1/0, yes/no, y/j/n, ja/nein, ""
# - `integer` will check for a number maybe within a range
# - `float` will check for a number maybe within a range
# - `enum' will check against valid words using `--allow="word1 word2"`
# - `length` check that the length is within range (like integer)
# - `duration` check and parse the @duration_format
# - `path` check that value is an existing path (any type)
# - `file` check that value is an existing file
# - `directory` check that value is an existing directory
# - `readable` check that value is a file readable by user
# - `writable` check that value is a file writable by user
#
# Usage:    check <check> [options] -- <value>
# Options:  d, die              # used in @is to stop with error instead of return state
#           n, name=<string>    # used in @is to display variable name in `die` message
#           s, sanitize         # for integer
#           min=<num>           # for integer
#           max=<num>           # for integer
#           allow=<words>       # for enum (space separated)
# Output:   <value>             # may be sanitized
# Exit:     with message if incorrect value
# Example:  Check arguments:
#
#           - `check integer --name=arguments --max=2 -- $# >/dev/null` # mostly only check max, if all args are checked separately
#           - `name="$(check integer --name=age --sanitize --min=0 -- "$1")"`
#           - `init="$(check bool --name=init "$1")"`
#
#           Use in code:
#
#           - `if check integer age --min=18 -- "$1" >/dev/null; then`
check() {
    # parameter parsing
    eval set -- "$(option_parse $'n name +\nd die -\ns sanitize -\n- min +\n- max +\n- allow +' "$@")"
    local name die sanitize min max allow
    # shellcheck disable=SC2015
    # shellcheck disable=SC2059
    while true; do
        case "$1" in
        -n | --name) name="$2" && shift 2 ;;
        -d | --die) die=1 && shift ;;
        -s | --sanitize) sanitize=1 && shift ;;
        --min) [[ "$2" =~ ^[-+]?[0-9]+([.][0-9]+)?$ ]] && min="$2" && shift 2 || die "$(printf "$(gettext "Parameter %s needs number")" min)" ;;
        --max) [[ "$2" =~ ^[-+]?[0-9]+([.][0-9]+)?$ ]] && max="$2" && shift 2 || die "$(printf "$(gettext "Parameter %s needs number")" max)" ;;
        --allow) [ -n "$2" ] && allow="$2" && shift 2 || die "$(gettext "A list of words is needed")" ;;
        --) shift && break ;;
        *) die "$(gettext "Unrecognized option"): $1" ;;
        esac
    done
    name="${name:-argument}"
    # processing
    local usage
    usage="$(gettext "Incorrect call"): is <check> <value> [options]"
    # shellcheck disable=SC2015
    [ -n "$1" ] && local check="$1" || die "$usage"
    local val="$2" res="$2"
    # shellcheck disable=SC2015
    case $check in
    set)
        if [ -z "$val" ]; then
            [ -z "$die" ] && return 1 || die "$(eval_gettext 'The "$name" has to be set with a value')"
        fi
        ;;
    empty)
        if [ -n "$val" ]; then
            [ -z "$die" ] && return 1 || die "$(eval_gettext 'The "$name" has to be empty but has »${val}«')"
        fi
        ;;
    bool)
        if [[ "${val,,}" =~ ^(true|t|1|yes|y|ja|j)$ ]]; then
            res=1
        elif [[ -z "$val" || "${val,,}" =~ ^(false|f|0|no|n|nein)$ ]]; then
            res=0
        else
            [ -z "$die" ] && return 1 || die "$(eval_gettext 'The value »${val}« for "$name" could not be read as true or false')"
        fi
        ;;
    integer)
        if [ -n "$sanitize" ]; then
            [[ "$val" =~ ^(-?[0-9]+) ]] && res="${BASH_REMATCH[1]}" || true
        fi
        if [[ ! "$res" =~ ^-?[0-9]+$ ]]; then
            [ -z "$die" ] && return 1 || die "$(eval_gettext 'The "$name" has to be an integer but »${val}« was given')"
        fi
        if [[ -n "$min" ]] && [[ "$min" == "$max" ]]; then
            if ((res != min)); then
                [ -z "$die" ] && return 1 || die "$(eval_gettext 'The "$name" has to be exactly $min but »${val}« was given')"
            fi
        elif [[ -n "$min" && -n "$max" ]]; then
            if ((res < min || res > max)); then
                [ -z "$die" ] && return 1 || die "$(eval_gettext 'The "$name" has to be between $min and $max but »${val}« was given')"
            fi
        elif [[ -n "$min" ]]; then
            if ((res < min)); then
                [ -z "$die" ] && return 1 || die "$(eval_gettext 'The "$name" has to at least $min but »${val}« was given')"
            fi
        elif [[ -n "$max" ]]; then
            if ((res > max)); then
                [ -z "$die" ] && return 1 || die "$(eval_gettext 'The "$name" has to not be more than $max but »${val}« was given')"
            fi
        fi
        ;;
    float)
        if [ -n "$sanitize" ]; then
            [[ "$val" =~ ^(-?[0-9]+([.][0-9]+)?) ]] && res="${BASH_REMATCH[1]}" || true
        fi
        if [[ ! "$res" =~ ^-?[0-9]+([.][0-9]+)?$ ]]; then
            [ -z "$die" ] && return 1 || die "$(eval_gettext 'The "$name" has to be a float but »${val}« was given')"
        fi
        if [[ -n "$min" ]] && [[ "$min" == "$max" ]]; then
            if ((res != min)); then
                [ -z "$die" ] && return 1 || die "$(eval_gettext 'The "$name" has to be exactly $min but »${val}« was given')"
            fi
        elif [[ -n "$min" && -n "$max" ]]; then
            if ((res < min || res > max)); then
                [ -z "$die" ] && return 1 || die "$(eval_gettext 'The "$name" has to be between $min and $max but »${val}« was given')"
            fi
        elif [[ -n "$min" ]]; then
            if ((res < min)); then
                [ -z "$die" ] && return 1 || die "$(eval_gettext 'The "$name" has to at least $min but »${val}« was given')"
            fi
        elif [[ -n "$max" ]]; then
            if ((res > max)); then
                [ -z "$die" ] && return 1 || die "$(eval_gettext 'The "$name" has to not be more than $max but »${val}« was given')"
            fi
        fi
        ;;
    length)
        val=${#val}
        if [[ -n "$min" ]] && [[ "$min" == "$max" ]]; then
            if ((res != min)); then
                [ -z "$die" ] && return 1 || die "$(eval_gettext 'The length of "$name" has to be exactly $min but »${res}« is $val characters long')"
            fi
        elif [[ -n "$min" && -n "$max" ]]; then
            if ((val < min || val > max)); then
                [ -z "$die" ] && return 1 || die "$(eval_gettext 'The length of "$name" has to be between $min and $max but »${res}« is $val characters long')"
            fi
        elif [[ -n "$min" ]]; then
            if ((val < min)); then
                [ -z "$die" ] && return 1 || die "$(eval_gettext 'The length of "$name" has to be at least $min but »${res}« is $val characters long')"
            fi
        elif [[ -n "$max" ]]; then
            if ((val > max)); then
                [ -z "$die" ] && return 1 || die "$(eval_gettext 'The length of "$name" has to be not more than $max but »${res}« is $val characters long')"
            fi
        fi
        ;;
    enum)
        [ -n "$allow" ] || die "$(gettext "A list with --allow=<words> is needed for enum check")"
        if [[ " $allow " != *" $val "* ]]; then
            [ -z "$die" ] && return 1 || die "$(eval_gettext '"$name" is set to "${val}" but has to be one of: $allow')"
        fi
        ;;
    duration)
        [[ "$res" =~ ^-?[0-9] ]] && res="$(duration_format seconds "$val")" || true
        if [[ ! "$res" =~ ^-?[0-9]+$ ]]; then
            [ -z "$die" ] && return 1 || die "$(eval_gettext 'The "$name" has to be an integer or human duration but »${val}« was given')"
        fi
        ;;
    path)
        if [ ! -e "$val" ]; then
            [ -z "$die" ] && return 1 || die "$(eval_gettext 'The "$name" ${val} has to be an existing path')"
        fi
        ;;
    file)
        if [ ! -f "$val" ]; then
            [ -z "$die" ] && return 1 || die "$(eval_gettext 'The "$name" ${val} has to be an existing file')"
        fi
        ;;
    directory)
        if [ ! -d "$val" ]; then
            [ -z "$die" ] && return 1 || die "$(eval_gettext 'The "$name" ${val} has to be an existing directory')"
        fi
        ;;
    readable)
        if [ ! -r "$val" ]; then
            [ -z "$die" ] && return 1 || die "$(eval_gettext 'The "$name" ${val} has to be a file readable for user')"
        fi
        ;;
    writable)
        if [ ! -w "$val" ]; then
            [ -z "$die" ] && return 1 || die "$(eval_gettext 'The "$name" ${val} has to be a file writable for user')"
        fi
        ;;
    *) die "$(eval_gettext 'A check named ${check} is not defined')" ;;
    esac
    echo "$res"
}

# Validate and sanitize values.
#
# This validation is possible using the @check and `is` function.
# - @check should be used for sanitize because it will output the value
# - `is` should be used for checking only validity or stop processing on problem because no value is output
#
# Every parameter should be checked to prevent failure later in the code.
# For such checks you run it with the `--die` option to stop processing if wrong.
# But you can also use it in the program flow without that and use it's return status to check if it 0=ok or 1=failed.
#
# Because the values may start with an dash you should always put it at the end after '--' to prevent parsing it as option.
#
# The following checks are implemented:
#
# - `set` will fail if no value given
# - `empty` will fail if not empty like ""
# - `bool` will transform the value to `1` or `0` and allows: true/false, t/f, 1/0, yes/no, y/j/n, ja/nein, ""
# - `integer` will check for a number maybe within a range
# - `float` will check for a number maybe within a range
# - `enum' will check against valid words using `--allow="word1 word2"`
# - `length` check that the length is within range (like integer)
# - `duration` check and parse the @duration_format
# - `path` check that value is an existing path (any type)
# - `file` check that value is an existing file
# - `directory` check that value is an existing directory
# - `readable` check that value is a file readable by user
# - `writable` check that value is a file writable by user
#
# Usage:    is <check> [options] -- <value>
# Options:  d, die              # stop with error instead of return state
#           n, name=<string>    # name the variable for the `die` message
#           min=<num>           # for integer
#           max=<num>           # for integer
#           allow=<words>       # for enum (space separated)
# Exit:     with message if incorrect value
# Example:  Check arguments:
#
#           - `is integer --name=arguments --max=2 $#` # mostly only check max, if all args are checked separately
#
#           Use in code:
#
#           - `if is integer age --min=18 -- "$1"; then ...`
#           - `if ! is integer "$DEBUG"; then ...`
is() {
    check "$@" >/dev/null
}

