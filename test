#!/usr/bin/env bash

BASHLIB_HOME="$(pwd)"

mkdir -p test-results
rm -rf test-results/* 2>/dev/null || true

ls -al bats-assert

for file in core/date.bats; do
  name=${file%.bats} # remove the .bats extension
  name=${name//\//-} # replace all / with -
  bats --formatter tap $file
  echo "Run again for junit.xml files..."
  bats --formatter junit $file >test-results/$name.xml
done
