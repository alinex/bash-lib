#!/bin/bash

# Log command
#
# http://172.17.101.90/divibib-betrieb/bash-lib/blob/master/doc/log.md
#
# Usage:
#
# log <type> <message>  # log to file
# xxx | log             # pipe to log
# xxx | log <type>      # pipe with specific log type

# Configuration
VERSION=$(git describe --abbrev=0 --tags)
GITLAB=$(git config --get remote.origin.url | sed 's/\.git$//')
REVISION=$(git rev-parse --verify master)

# DIST include base.bash
source_dir=$(dirname $(readlink -f "${BASH_SOURCE[0]:-$(pwd)/x}"))
source "$source_dir/../include/log.bash" # load log handler

# Parameter checking
parsed=$(getopt --options=:Vh --longoptions=version,help --name "$0" -- "$@")
[ ${PIPESTATUS[0]} -eq 0 ] || log_exit "Could not parse parameters!"
eval set -- "$parsed"
while true; do
    case "$1" in
        -V|--version) echo "$(basename $0) from bash-lib version $VERSION"; exit 0 ;;
        -h|--help) source "$(path)/$(basename $0).help"; exit 0 ;;
        --) shift; break ;;
        *) break ;;
    esac
done
type=${1:-AUTO}

# calling log library
if [ -n "$2" ]; then
  log $type $2
else
  log $type
fi
