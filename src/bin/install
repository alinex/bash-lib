#!/bin/bash

source_dir=$(dirname $(readlink -f "${BASH_SOURCE[0]:-$(pwd)/x}"))

# Configuration
VERSION=$(git describe --abbrev=0 --tags 2>/dev/null); VERSION=${VERSION:-master}
REVISION=$(git rev-parse --verify master)
GITLAB=$(git config --get remote.origin.url | sed 's/\.git$//')

# DIST include base.bash
source "$source_dir/../include/log.bash" # load log handler

# Parameter checking
parsed=$(getopt --options=:Vh --longoptions=version,help --name "$0" -- "$@")
[ $? -eq 0 ] || log_exit ALERT "Incorrect options provided!"
eval set -- "$parsed"
while true; do
    case "$1" in
        -V|--version) echo "$(basename $0) from bash-lib version $VERSION"; exit 0 ;;
        -h|--help) source "$(path)/$(basename $0).help"; exit 0 ;;
        --) shift; break ;;
        *) break ;;
    esac
done
[ $# -gt 0 ] && log WARN "No parameters are supported, only -h to show help - ignoring them"

# Installing debian tools
log HEADING "Install neccessary tools for bash-lib"
log INFO "text2xls needs recode and the perl binaries: spreadsheet-writeexcel text-csv-xs"
log_cmd sudo apt-get install -y recode libspreadsheet-writeexcel-perl libtext-csv-xs-perl >/dev/null \
|| log ALERT "Not possible automatically install"

log NOTICE "Done"
