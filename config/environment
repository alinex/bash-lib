#!/usr/bin/env bash

# The configuration module contains a lot of general configuration settings for the bash-lib modules itself. Most of them are specific to the individual environment so they need to be set in the local `overwrite` config.

######################################################################################
### Host Specifica
######################################################################################

# Array: Color limits per mount (pattern critical error warn ok) used in @remote_df
MOUNT_COLOR_LIMIT=(
    ".*" 100 90 80 50
)

######################################################################################
### Remote API
######################################################################################

# That are only the APIs, the tokens has to be defined in the environment, typically in .bashrc

# Mattermost API url
MATTERMOST_API=
# Grafana API url
GRAFANA_API=
# Atlassian confluence API url
CONFLUENCE_API=
# Atlassian jira API url
JIRA_API=
# Prometheus API urls
PROMETHEUS_API=
# Prometheus host names
PROMETHEUS=

# Atlassian confluence page id for outage information
CONFLUENCE_OUTAGE=
